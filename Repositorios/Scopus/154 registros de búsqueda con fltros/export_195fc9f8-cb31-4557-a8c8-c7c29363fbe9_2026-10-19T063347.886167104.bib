	year = {2026},
	journal = {BDAIA 2025 - 2025 2nd International Conference on Big Data Analytics and Artificial Intelligence Application},
	pages = {73 - 78},
	doi = {10.1145/3788108.3788507},
	url = {https://www.scopus.com/pages/publications/105031592446?origin=resultslist},
	abstract = {Highway incident detection technology serves as a core component in responding to abnormal events on highways, which is critical for safeguarding traffic safety, mitigating secondary accidents, and enhancing overall traffic efficiency. In recent years, deep learning-based incident detection methods have yielded remarkable advances in detection accuracy. However, a prevalent limitation of existing studies lies in the lack of open access to their experimental datasets and model weights, which hinders the objective comparison of detection performance across different approaches. To fill this gap, this paper presents a systematic review of mainstream baseline models for highway incident detection, and further constructs a large-scale benchmark dataset, namely the Highway Traffic Incident Benchmark (HTIB). Distinguished from existing datasets, HTIB covers the most comprehensive categories of highway incidents collected from real-world highway surveillance systems. Based on HTIB, this paper proposes a standardized performance evaluation framework to enable fair and comparable assessments of different detection baseline models. Experimental results indicate that YOLOv9c achieves the optimal detection performance on the HTIB test set, with an mAP50 of 84.8%. In contrast, YOLOv6s delivers the fastest inference speed with an average of 1.5 ms per image, which is suitable for real-time monitoring scenarios. Notably, YOLOv8s achieves a balanced trade-off between detection accuracy and inference efficiency, demonstrating the best overall performance. This study not only establishes a unified benchmark for evaluating highway incident detection models but also clarifies the applicability of different models in practical scenarios, laying a solid foundation for the deployment of AI-based incident detection systems on highways.  © 2025 Copyright held by the owner/author(s).},
	author_keywords = {Baseline Detection Model; Benchmark Dataset; Highway; Incident Detection},
