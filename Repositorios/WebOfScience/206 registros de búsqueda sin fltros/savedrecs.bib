@article{ WOS:001203466500101,
Author = {Chen, Xiaobo and Wang, Yong and Sun, Xiaodong and Cai, Yingfeng},
Title = {Unsupervised Cross-Scenario Abnormal Driving Behavior Recognition Using
   Smartphone Sensor Data},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2024},
Volume = {11},
Number = {8},
Pages = {14698-14709},
Month = {APR 15},
Abstract = {Accurately recognizing abnormal behavior of drivers (e.g., aggressive
   driving and fatigued driving) based on multivariate sensor data is vital
   for human-centric assistive driving systems. Existing data-driven deep
   learning models for abnormal driving behavior recognition (ADBR) achieve
   promising performance under specific driving scenes with sufficient
   labeled data. However, in the real world, dynamic driving scenes and
   unlabeled data pose a great challenge to the adaptability of models. In
   light of this, we put forward a novel unsupervised cross-scenario ADBR
   approach that can transfer domain knowledge in the source scenario with
   labeled data to the target scenario with only unlabeled data, thus
   considerably enhancing the adaptability of our model. Specifically, we
   first propose a feature extraction module that can obtain domain-shared
   and domain-specific features from raw sensor data derived from different
   driving scenes. Then, adversarial learning is presented to align the
   feature distribution of source and target domains to reduce the domain
   shift. A self-training strategy is further developed to boost the target
   domain classification performance by iteratively using the pseudo
   labels. Moreover, prediction uncertainty and ensemble classification are
   proposed to enhance the quality of pseudo labels. Extensive experiments
   on cross-scenario ADBR are conducted to evaluate the effectiveness of
   our model. The results manifest that our model significantly improves
   the recognition performance for the target domain and outperforms the
   competing algorithms.},
DOI = {10.1109/JIOT.2023.3344482},
ISSN = {2327-4662},
ORCID-Numbers = {Chen, Xiaobo/0000-0001-9940-1637
   Cai, Yingfeng/0000-0002-0633-9887},
Unique-ID = {WOS:001203466500101},
}

@article{ WOS:000860367900013,
Author = {Chen, Lingqiang and Shi, Pei and Li, Guanghui and Qi, Tao},
Title = {Traffic flow prediction using multi-view graph convolution and masked
   attention mechanism},
Journal = {COMPUTER COMMUNICATIONS},
Year = {2022},
Volume = {194},
Pages = {446-457},
Month = {OCT 1},
Abstract = {Traffic flow prediction is one of the essential technologies in the
   intelligent transportation system. Graph convolution is naturally
   suitable for graph structure data mining and is widely used to forecast
   traffic data. However, most graph convolution methods rely on the
   Euclidean distance adjacency matrix, which cannot mine richer semantic
   information. In addition, regardless of static or dynamic graph
   convolution methods, many graph convolution methods adopt the same
   adjacency matrix to mine graph information for each convolution layer.
   In reality, the proportion of abnormal traffic flows such as congestion
   is slight. Therefore, those networks tend to learn normal traffic
   patterns. This paper proposes a deep learning model including a dilated
   Temporal causal convolution module, multi-view diffusion Graph
   convolution module, and masked multi-head Attention module (TGANet) to
   address the above issues. The dilated temporal causal convolution is
   used to mine the temporal correlation of traffic data. Multi-view
   diffusion graph convolution operation leverages non-euclidean metrics
   like Jaccard distance and Pearson correlation to mine semantic
   information. In addition, the masked multi-head attention module is
   applied to mine fine-grained spatiotemporal dynamics. Experimental
   results on two public traffic data sets demonstrate that the proposed
   method outperforms other counterpart methods in most cases.},
DOI = {10.1016/j.comcom.2022.08.008},
EarlyAccessDate = {AUG 2022},
ISSN = {0140-3664},
EISSN = {1873-703X},
ResearcherID-Numbers = {Chen, Lingqiang/JKJ-6103-2023
   Qi, Tao/LCE-6779-2024},
ORCID-Numbers = {Chen, Lingqiang/0000-0001-5379-0972
   },
Unique-ID = {WOS:000860367900013},
}

@article{ WOS:001323342300001,
Author = {Shi, Tianyi and Wu, Ruixiao and Zhou, Chuantian and Zheng, Siyang and
   Meng, Zhu and Cui, Zhe and Huang, Jin and Ren, Changrui and Zhao,
   Zhicheng},
Title = {A Trusted Supervision Paradigm for Autonomous Driving Based on
   Multimodal Data Authentication},
Journal = {BIG DATA AND COGNITIVE COMPUTING},
Year = {2024},
Volume = {8},
Number = {9},
Month = {SEP},
Abstract = {At the current stage of autonomous driving, monitoring the behavior of
   safety stewards (drivers) is crucial to establishing liability in the
   event of an accident. However, there is currently no method for the
   quantitative assessment of safety steward behavior that is trusted by
   multiple stakeholders. In recent years, deep-learning-based methods can
   automatically detect abnormal behaviors with surveillance video, and
   blockchain as a decentralized and tamper-resistant distributed ledger
   technology is very suitable as a tool for providing evidence when
   determining liability. In this paper, a trusted supervision paradigm for
   autonomous driving (TSPAD) based on multimodal data authentication is
   proposed. Specifically, this paradigm consists of a deep learning model
   for driving abnormal behavior detection based on key frames adaptive
   selection and a blockchain system for multimodal data on-chaining and
   certificate storage. First, the deep-learning-based detection model
   enables the quantification of abnormal driving behavior and the
   selection of key frames. Second, the key frame selection and image
   compression coding balance the trade-off between the amount of
   information and efficiency in multiparty data sharing. Third, the
   blockchain-based data encryption sharing strategy ensures supervision
   and mutual trust among the regulatory authority, the logistic platform,
   and the enterprise in the driving process.},
DOI = {10.3390/bdcc8090100},
Article-Number = {100},
EISSN = {2504-2289},
ResearcherID-Numbers = {Meng, Zhu/JOJ-7147-2023
   Shi, Tianyi/AAQ-2319-2020
   },
ORCID-Numbers = {Zhao, Zhicheng/0000-0001-6506-7298
   Meng, Zhu/0000-0002-7519-4124
   Huang, Jin/0009-0001-8705-9130},
Unique-ID = {WOS:001323342300001},
}

@article{ WOS:000761342000001,
Author = {Azadani, Mozhgan Nasr and Boukerche, Azzedine},
Title = {Siamese Temporal Convolutional Networks for Driver Identification Using
   Driver Steering Behavior Analysis},
Journal = {IEEE TRANSACTIONS ON INTELLIGENT TRANSPORTATION SYSTEMS},
Year = {2022},
Volume = {23},
Number = {10},
Pages = {18076-18087},
Month = {OCT},
Abstract = {Driver identification has shown sustainable development in recent years
   in a wide variety of applications including but not limited to security,
   personalization, fleet management, insurance telematics, or
   ride-hailing. However, the current progress suffers from several
   challenges such as costly data collections and the need for a huge
   amount of data from each individual for both driver identification and
   impostor detection. Therefore, more novel and efficient solutions are
   required to mitigate the existing challenges. In this paper, we address
   driver identification and impostor detection tasks using driving
   behavior analysis of the drivers. We design a deep learning-based system
   architecture that analyzes windows of 30 seconds of driving data to
   capture the unique underlying characteristics of the individuals
   steering behavior based on which it further distinguishes the drivers.
   We also develop a novel strategy to tackle driver verification and
   impostor detection tasks based on the combination of the proposed system
   architecture and Siamese networks concepts. We map the steering behavior
   of the drivers into latent representations which can be later used to
   train a similarity function. The performance of the proposed systems is
   tested over a real-world dataset of 95 drivers. The evaluation results
   indicate that our system outperforms well-established benchmarks and
   baseline methodologies.},
DOI = {10.1109/TITS.2022.3151264},
EarlyAccessDate = {FEB 2022},
ISSN = {1524-9050},
EISSN = {1558-0016},
ResearcherID-Numbers = {Nasr Azadani, Mozhgan/HGD-6587-2022},
ORCID-Numbers = {Nasr Azadani, Mozhgan/0000-0002-2872-1438},
Unique-ID = {WOS:000761342000001},
}

@article{ WOS:001502019800002,
Author = {Zhao, Xia and Li, Zhao and Ma, Yong and Cai, Yingfeng and Sun, Xiaoqiang
   and Chen, Long},
Title = {Beyond classification and regression: A novel multi-task deep learning
   framework for driver state understanding in human-machine Co-driving
   system},
Journal = {KNOWLEDGE-BASED SYSTEMS},
Year = {2025},
Volume = {322},
Month = {JUL 8},
Abstract = {As an essential component of the intelligent cockpit, the driver
   monitoring system (DMS) will continuously provide robust and accurate
   driver state parameters for the human-machine co-driving system.
   However, singleobjective deep learning tasks based on classification and
   regression find it challenging to adapt to the monitoring of compound
   and time-varying behaviors. Consequently, this paper presents a
   multi-task learning framework based on multimodal visual information
   (MTLF-MVI) for driver state understanding. By learning the driver's
   motion and attention characteristics, MTLF-MVI can identify the level of
   visual-manual distraction (LoVMD) and driving behavior category (DBC).
   Firstly, two heterogeneous feature encoders are constructed and
   pre-trained on large human datasets to acquire general knowledge. Then,
   a novel spatiotemporal decoupling module maps the fused features to the
   time and space domains. The decoupled spatiotemporal feature vectors are
   used to generate LoVMD pseudo-labels and perform self-training of the
   LoVMD recognition module. Finally, a hybrid loss function is employed to
   optimize the LoVMD and DBC recognition tasks; the spatiotemporal
   contrastive learning loss function it contains is used to constrain the
   feature vectors distribution, representing the similarity between normal
   and abnormal driving. The test results show that the LoVMD output by
   MTLF-MVI conforms to the prior knowledge of driving behavior, and the
   classification accuracy of DBC on the unfamiliar test sets
   100-Driver-Day, 100-Driver-Night, and SFD reaches 89.61 \%, 82.91 \%,
   and 88.59 \% respectively. MTLF-MVI has high accuracy, generalization,
   and multi-task performance and can provide a valuable reference for
   developing DMS.},
DOI = {10.1016/j.knosys.2025.113777},
EarlyAccessDate = {MAY 2025},
Article-Number = {113777},
ISSN = {0950-7051},
EISSN = {1872-7409},
ResearcherID-Numbers = {Sun, Xiaoqiang/ITT-2698-2023},
ORCID-Numbers = {Sun, Xiaoqiang/0000-0002-8862-6096
   Zhao, Li/0000-0003-1530-8115
   },
Unique-ID = {WOS:001502019800002},
}

@article{ WOS:001708163500002,
Author = {Zhang, Ying and Cai, Wangze and Zhang, Yingjie and Ai, Zhaoyang and Du,
   Chenglie and Ge, Shuaishuai},
Title = {Driver Yawning Recognition Through Subtle Mouth Movements Based on Deep
   Learning},
Journal = {IEEE TRANSACTIONS ON VEHICULAR TECHNOLOGY},
Year = {2026},
Volume = {75},
Number = {3},
Pages = {3627-3641},
Month = {MAR},
Abstract = {Driver yawning action is a critical indicator to detect fatigue driving
   behavior and design advanced driving assistance system (ADAS) for
   intelligent vehicles. In this paper, a driver yawning recognition
   approach based on adaptive keyframe selection (AKS) strategy and very
   deep convolutional network (VDCN) is proposed. To decrease the time
   overhead and improve recognition accuracy, the AKS strategy is designed
   in a cascading manner with two stages to eliminate redundant frames. In
   the first stage, redundant frames are preliminarily eliminated based on
   the Euclidean distance (ED) in an adaptive manner. In the second stage,
   a special root mean square error (SRMSE) is proposed to avoid the
   unreasonable elimination of some representative frames in the first
   stage. On the basis of the selected keyframes, an improved VDCN with a
   Max-Ave pooling strategy is designed to recognize the yawning action.
   Based on the improved VDCN, the deep features which can reflect the
   yawning action are extracted and used to recognize the yawning action.
   In order to validate the performance of yawning recognition based on the
   AKS strategy and VDCN, several benchmarked approaches are selected as
   the comparison methods. A series of experiments demonstrate that the
   proposed approach possesses better performance in time overhead,
   recognition accuracy and robustness.},
DOI = {10.1109/TVT.2025.3608613},
ISSN = {0018-9545},
EISSN = {1939-9359},
ResearcherID-Numbers = {Zhang, Ying/AAB-1649-2022
   Ai, Zhaoyang/L-9760-2018},
Unique-ID = {WOS:001708163500002},
}

@article{ WOS:001197757800001,
Author = {Yaqoob, Shumayla and Morabito, Giacomo and Cafiso, Salvatore and
   Pappalardo, Giuseppina and Ullah, Ata},
Title = {AI-Driven Driver Behavior Assessment Through Vehicle and Health
   Monitoring for Safe Driving-A Survey},
Journal = {IEEE ACCESS},
Year = {2024},
Volume = {12},
Pages = {48044-48056},
Abstract = {Safe driving is a serious and challenging concern that is dependent on
   driver behaviors including aggressive, distracted, fatigued, and drowsy
   driving. In a smart society, in-vehicle monitoring of drivers and
   detecting abnormal driving behavior as anomalies can reduce the rate of
   road crashes. Existing surveys cover the various schemes for detecting
   on-road driver behaviors through sensing data. We have identified a gap
   in the linkage of driver's health or vehicle conditions to abnormal
   behaviors that are not yet covered. This work presents a taxonomy of
   schemes, and the analytical evaluation and identifies the open research
   challenges. The work specifically investigates the modeling of driver
   behavior and the detection of abnormal behavior, utilizing techniques
   such as AI-based image processing, signal processing, and traditional
   algorithmic approaches. This analysis encompasses methods and features
   based on both driver health and vehicle monitoring with the ultimate
   goal of ensuring safe driving. More specifically, existing approaches
   are classified in a coherent taxonomy by reviewing traditional
   mathematical, machine learning, and deep learning-based schemes.
   Moreover, a summary of schemes is presented to highlight the key points
   followed by a comprehensive analytical discussion. It aids in
   pinpointing research issues by leveraging the insights gained from the
   comparison. Finally, the work highlights the open research challenges
   for the researchers to provide innovative solutions.},
DOI = {10.1109/ACCESS.2024.3383775},
ISSN = {2169-3536},
ResearcherID-Numbers = {Ullah, Ata/ABE-6416-2022
   Pappalardo, Giuseppina/AAS-7153-2021
   },
ORCID-Numbers = {Yaqoob, Shumayla/0000-0002-0696-5546
   Ullah, Ata/0000-0003-3603-1709
   CAFISO, Salvatore/0000-0002-7247-0365
   Morabito, Giacomo/0000-0002-8714-4001},
Unique-ID = {WOS:001197757800001},
}

@article{ WOS:000852492900001,
Author = {Gao, Wuqi and Li, Liangliang and Yang, Ting},
Title = {Driving State Discrimination Algorithm Based on Lightweight Network and
   Contrast Learning},
Journal = {INTERNATIONAL JOURNAL OF PATTERN RECOGNITION AND ARTIFICIAL INTELLIGENCE},
Year = {2022},
Volume = {36},
Number = {11},
Month = {SEP 15},
Abstract = {Driver misbehavior is one of the major traffic safety hazards as car
   ownership increases year by year. So, it is important to have driver
   fatigue detection and behavior recognition. Initially, given the fatigue
   detection problem that the images captured by the visible light camera
   cannot capture the eyes of a driver wearing sunglasses or eye glasses.
   As a solution, this paper introduces a DCT-HSV preprocessing algorithm
   for infrared images, which is believed to enhance the target
   characteristics of infrared images. The paper also introduces a more
   efficient lightweight SSD detection model, which achieves a better
   balance in terms of model size and detection performance. It also shows
   a better performance in self-built datasets and basic vehicle operation
   datasets. Secondly, aiming at the problems of high complexity and poor
   accuracy of the existing driving behavior detection model, this paper
   designs a driver abnormal behavior discrimination model based on the
   comparison twin, which has good performance on the Kaggle public
   dataset. The relevant experimental detection results show that the
   method constructed in this paper has high detection accuracy, low
   warning delay, and good practical use value.},
DOI = {10.1142/S0218001422520255},
EarlyAccessDate = {SEP 2022},
ISSN = {0218-0014},
EISSN = {1793-6381},
ResearcherID-Numbers = {Li, liangliang/IXD-9533-2023},
Unique-ID = {WOS:000852492900001},
}

@article{ WOS:001807922800010,
Author = {Wang, Zhiyu and Li, Linheng and Qu, Xu and Ran, Bin},
Title = {Detecting Abnormal Vehicle Behavior With a Diffusion-Transformer
   Generation Framework},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2026},
Volume = {13},
Number = {13},
Pages = {28682-28693},
Month = {JUL 1},
Abstract = {With the rapid development of intelligent transportation systems (ITSs),
   ensuring traffic safety has become a critical societal priority.
   Abnormal driving behavior detection has emerged as an essential approach
   to mitigate potential traffic risks, as even minor abnormal behaviors
   can lead to severe safety hazards through cascading effects under
   specific environmental conditions. To address these challenges, this
   article proposes an innovative framework for the detection of abnormal
   vehicle behavior, built on the deep integration of a diffusion model and
   the transformer architecture. The proposed framework adopts a two-stage
   process: a generation stage, where a classifier-free denoising diffusion
   model reconstructs the normal trajectory distribution from Gaussian
   noise iteratively, and a comparison stage, where deviations between
   observed trajectories and generated normal trajectory distributions are
   quantified to detect anomalies. This method eliminates the need for
   hand-made thresholds, overcoming the subjectivity and rigidity of
   traditional anomaly detection approaches, and effectively addresses the
   severe class imbalance between normal and abnormal samples often
   observed in real-world traffic scenarios. In addition, extensive
   evaluations of real-world traffic datasets demonstrate the superiority
   of the framework, achieving a precision of 0.948, a precision of 0.317,
   a recall of 0.765, and an F1-score of 0.448, significantly exceeding
   state-of-the-art benchmarks. These results underscore the potential of
   the proposed framework as a robust foundation for proactive early
   warning systems in ITS, contributing to safer and more efficient
   transportation networks.},
