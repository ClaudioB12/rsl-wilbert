Unique-ID = {WOS:001432418000001},
}

@article{ WOS:001381377200042,
Author = {Boateng, Charles and Ghoreishi, Seyedeh Gol Ara and Yang, Kwangsoo and
   Jan, Muhammad Tanveer and Tappen, Ruth and Jang, Jinwoo and Newman,
   David and Moshfeghi, Sonia and Jackson, Kelley and Resnick, Rhian and
   Furht, Borko and Rosselli, Monica and Conniff, Joshua},
Title = {Spatial Deep Learning Approach to Older Driver Classification},
Journal = {IEEE ACCESS},
Year = {2024},
Volume = {12},
Pages = {191219-191230},
Abstract = {Given telemetry datasets (e.g., GPS location, speed, direction,
   distance.), the Older Driver Classification (ODC) problem identifies two
   groups of drivers: normal and abnormal. The ODC problem is essential in
   many societal applications, including road safety, insurance risk
   assessment, and targeted interventions for elderly drivers with dementia
   or Mild Cognitive Impairment (MCI). The problem is challenging because
   of the volume and heterogeneity of temporally-detailed vehicle datasets.
   This paper proposes a novel spatial deep-learning approach that
   leverages Grid-Index based data augmentation to enhance the detection of
   abnormal driving behaviors. Through extensive experiments and a
   real-world case study, the proposed approach consistently identifies
   abnormal drivers with high accuracy. The findings demonstrate the
   potential of grid-based methods to improve telematics-based driving
   behavior analysis significantly. This approach offers valuable
   implications for enhancing road safety measures, optimizing insurance
   risk assessments, and developing targeted interventions for at-risk
   drivers.},
DOI = {10.1109/ACCESS.2024.3516572},
ISSN = {2169-3536},
ResearcherID-Numbers = {Jan, Muhammad Tanveer/HPF-1907-2023
   Moshfeghi, Sonia/KRO-5740-2024
