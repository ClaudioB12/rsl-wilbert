@article{ WOS:001870252500001,
Author = {Al-Quhfa, Hikmat and Mothana, Ali and Song, Jie},
Title = {Text-augmented reinforcement learning for real-time and robust traffic
   signal control},
Journal = {ENGINEERING APPLICATIONS OF ARTIFICIAL INTELLIGENCE},
Year = {2026},
Volume = {182},
Number = {4},
Month = {OCT 15},
Abstract = {Traffic signal control aims to minimize congestion and maximize
   efficiency in urban traffic systems. While recent reinforcement learning
   methods have shown promising performance, they primarily rely on
   structured sensor data and have limited ability to incorporate
   natural-language descriptions of traffic disruptions such as accidents,
   construction, or extreme weather. This paper introduces Text-Augmented
   Reinforcement Learning for Traffic Signal Control (TARL-TSC), which
   integrates textual event descriptions with traffic observations through
   learned fusion mechanisms. TARL-TSC employs attention-based and
   adaptive-gating fusion with graph attention networks for spatial
   coordination. Experiments on three benchmark traffic networks evaluate
   TARL-TSC across multiple network scales and disruption conditions under
   normal traffic, simulated disruptions, cross-city transfer, and
   semantic-input variations. The adaptive-gating variant achieves 873.43
   +/- 16.54 vehicles per episode on Hangzhou, exceeding the strongest
   sensor-based baseline by 3.36\% under normal traffic with
   Bonferroni-adjusted p = 0.0235, and by 2.95\% and 3.16\% under
   single-event and multi-event conditions. Under disruptions, TARL-TSC
   maintains degradation of 0.3\%-0.9\%, compared with 0.8\%-2.4\% for the
   strongest sensor-based baseline. Cross-city transfer shows modest,
   setting-dependent improvements of 1.2\%-3.0\% for the better-performing
   TARL-TSC variant across 12-48 intersections without fine-tuning. Using
   real-world New York 511 incident reports as textual inputs within the
   simulated traffic-control environment reduces throughput by 1.8\%
   relative to template-generated descriptions. TARL-TSC achieves 8.3 ms
   neural-policy inference per decision on Hangzhou within the evaluated
   control interval. Ablation experiments show measurable contributions
   from semantic input, spatial coordination, and learned fusion. The code
   will be released upon paper publication.},
