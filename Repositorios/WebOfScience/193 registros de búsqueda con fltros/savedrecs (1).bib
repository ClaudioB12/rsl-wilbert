@article{ WOS:001411209800005,
Author = {Puwei, Shi and Ishii, Kazuo},
Title = {Research on Driver Drowsiness Detection Method based on Deep Learning},
Journal = {JOURNAL OF ROBOTICS NETWORKING AND ARTIFICIAL LIFE},
Year = {2024},
Volume = {10},
Number = {4},
Pages = {313-317},
Month = {MAR},
Abstract = {The vehicle has become an indispensable means of transportation, but at
   the same time, driver drowsiness driving this dangerous driving behavior
   is common, the driver himself and others have brought indelible damage.
   Therefore, it is important to study driver behavior and state
   recognition methods to alert and intervene when dangerous situations
   occur, to ensure the safety of drivers themselves and other people and
   vehicles on the road. This study aims to propose a method to recognize
   driver drowsiness by driver's facial feature points using deep learning
   algorithms, and to complete the deployment of the method on Android
   smartphone. This method has the advantages of non-invasive, simple to
   use and low cost.},
