@article{ WOS:001729681500001,
Author = {Pu, Chenlu and Du, Lili},
Title = {SWencoder: a succinct shockwave diagram encoding and interpretable deep
   learning model design to enhance learning efficiency and assurance},
Journal = {TRANSPORTATION RESEARCH PART C-EMERGING TECHNOLOGIES},
Year = {2026},
Volume = {187},
Month = {JUN},
Abstract = {A shockwave diagram is a graphical representation of traffic state
   evolution over time and space. It contains critical traffic dynamic
   information essential for traffic monitoring and control. Recent studies
   have shown convincing values of shockwave diagrams to feed deep learning
   (DL) models and enhance performance in learning traffic patterns.
   However, existing studies often treated shockwave diagrams as heatmaps
   or images and encoded them by pixel-based grid systems, suffering from
   critical issues, such as feature loss and redundancy, which degrades
   learning efficiency and assurance. Motivated by this view, this study
   developed a novel puzzle-based encoding method leveraging domain
   knowledge. Specifically, inspired by traffic flow theories that
   shockwaves partition a temporal-spatial plane into disjoint polygons
   reminiscent of puzzle pieces, each containing a unique traffic flow
   feature, our approach encodes shockwave diagrams by puzzle pieces along
   with their adjacent relations, which are further stored within a
   welldesigned modular structure, capturing comprehensive traffic state
   information, including flow, density, spatial position, and adjacency
   relationships among these states. Guided by the modular structure of the
   puzzle-based encoding, this study further designed an interpretable RNN
   model (labeled as Sparse-LSTM) with customized trainable matrices to
   preserve the physical meaning of each module's features during recursive
   learning operations. Furthermore, this study designed four new metrics
   from data accuracy, completeness, consistency, and uniqueness dimensions
   to quantify the data quality of encoded shockwave diagrams and explore
   their correlation to deep learning performance. Using Seattle's highway
   loop detector and baseball game schedule dataset in 2011, as well
   Nashville radar sensor and crash dataset in 2023, we validated the
   performance of the puzzle-based encoding by feeding the encoded
   shockwave diagrams into a vanilla or sparse LSTM-based DL model for
   public event prediction and traffic accident detection, respectively.
   The results confirmed that the puzzle-based encoding can enhance AI
   prediction efficiency and interpretability.},
