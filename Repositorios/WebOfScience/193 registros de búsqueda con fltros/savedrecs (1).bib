   Saleem, Arslan; Direkoglu, Cem, Middle East Tech Univ, Elect \& Elect Engn, Northern Cyprus Campus,Mersin 10, TR-99738 Kalkanli, Northern Cyprus, Turkiye.},
DOI = {10.1016/j.eswa.2026.131425},
