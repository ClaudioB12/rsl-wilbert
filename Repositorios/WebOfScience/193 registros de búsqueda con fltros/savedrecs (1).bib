@article{ WOS:001708163500002,
Author = {Zhang, Ying and Cai, Wangze and Zhang, Yingjie and Ai, Zhaoyang and Du,
   Chenglie and Ge, Shuaishuai},
Title = {Driver Yawning Recognition Through Subtle Mouth Movements Based on Deep
   Learning},
Journal = {IEEE TRANSACTIONS ON VEHICULAR TECHNOLOGY},
Year = {2026},
Volume = {75},
Number = {3},
Pages = {3627-3641},
Month = {MAR},
Abstract = {Driver yawning action is a critical indicator to detect fatigue driving
   behavior and design advanced driving assistance system (ADAS) for
   intelligent vehicles. In this paper, a driver yawning recognition
   approach based on adaptive keyframe selection (AKS) strategy and very
   deep convolutional network (VDCN) is proposed. To decrease the time
   overhead and improve recognition accuracy, the AKS strategy is designed
   in a cascading manner with two stages to eliminate redundant frames. In
   the first stage, redundant frames are preliminarily eliminated based on
   the Euclidean distance (ED) in an adaptive manner. In the second stage,
   a special root mean square error (SRMSE) is proposed to avoid the
   unreasonable elimination of some representative frames in the first
   stage. On the basis of the selected keyframes, an improved VDCN with a
   Max-Ave pooling strategy is designed to recognize the yawning action.
   Based on the improved VDCN, the deep features which can reflect the
   yawning action are extracted and used to recognize the yawning action.
   In order to validate the performance of yawning recognition based on the
   AKS strategy and VDCN, several benchmarked approaches are selected as
   the comparison methods. A series of experiments demonstrate that the
   proposed approach possesses better performance in time overhead,
   recognition accuracy and robustness.},
