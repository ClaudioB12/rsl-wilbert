@article{ WOS:001824341200007,
Author = {Wang, Shuo and Mai, Nghia Thi and Kamal, Md Abdus Samad and Murakami,
   Iwanori and Yamada, Kou},
Title = {DANGEROUS DRIVING BEHAVIOR DETECTION IN-CAR BASED ON IMPROVED YOLOV11},
Journal = {INTERNATIONAL JOURNAL OF INNOVATIVE COMPUTING INFORMATION AND CONTROL},
Year = {2026},
Volume = {22},
Number = {4},
Pages = {947-960},
Month = {AUG},
Abstract = {In recent years, intelligent driving technologies have developed
   rapidly, leading to an increasing demand for driving safety. However,
   existing algorithms generally suffer from high computational complexity
   and slow inference speed. To enhance the realtime detection capability
   of dangerous driving behaviors inside vehicles, we propose a novel
   algorithm based on YOLOv11, termed YOLOv11-SGCB. The proposed model
   integrates Ghost Convolution for lightweight feature extraction, SCConv
   for spatial-channel reconstruction, and CBAM for attention-guided
   feature refinement. Experimental results demonstrate that YOLOv11-SGCB
   achieves a mean Average Precision (mAP) of 93.8\%, representing a 1.9\%
   improvement over the original YOLOv11, while inference speed is
   increased by 23\%, significantly enhancing real-time performance.
   Moreover, the GFLOPs are reduced to 69.1\% of the original model,
   enabling more efficient deployment on resource-constrained mobile
   devices.},
