@article{ WOS:000549318100008,
Author = {Hu, Jie and Zhang, Xiaoqin and Maybank, Steve},
Title = {Abnormal Driving Detection With Normalized Driving Behavior Data: A Deep
   Learning Approach},
Journal = {IEEE TRANSACTIONS ON VEHICULAR TECHNOLOGY},
Year = {2020},
Volume = {69},
Number = {7},
Pages = {6943-6951},
Month = {JUL},
Abstract = {Abnormal driving may cause serious danger to both the driver and the
   public. Existing detectors of abnormal driving behavior are mainly based
   on shallow models, which require large quantities of labeled data. The
   acquisition and labelling of abnormal driving data are, however,
   difficult, labor-intensive and time-consuming. This situation inspires
   us to rethink the abnormal driving detection problem and to apply deep
   architecture models. In this study, we establish a novel
   deep-learning-based model for abnormal driving detection. A stacked
   sparse autoencoders model is used to learn generic driving behavior
   features. The model is trained in a greedy layer-wise fashion. As far as
   the authors know, this is the first time that a deep learning approach
   is applied using autoencoders as building blocks to represent driving
   features for abnormal driving detection. In addition, a method for
   denoising is added to the algorithm to increase the robustness of
   feature expression. The dropout technology is introduced into the entire
   training process to avoid overfitting. Experiments carried out on our
   self-created driving behavior dataset demonstrate that the proposed
   scheme achieves a superior performance for abnormal driving detection
   compared to the state-of-the-art.},
