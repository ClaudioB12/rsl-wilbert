@article{ WOS:001807922800010,
Author = {Wang, Zhiyu and Li, Linheng and Qu, Xu and Ran, Bin},
Title = {Detecting Abnormal Vehicle Behavior With a Diffusion-Transformer
   Generation Framework},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2026},
Volume = {13},
Number = {13},
Pages = {28682-28693},
Month = {JUL 1},
Abstract = {With the rapid development of intelligent transportation systems (ITSs),
   ensuring traffic safety has become a critical societal priority.
   Abnormal driving behavior detection has emerged as an essential approach
   to mitigate potential traffic risks, as even minor abnormal behaviors
   can lead to severe safety hazards through cascading effects under
   specific environmental conditions. To address these challenges, this
   article proposes an innovative framework for the detection of abnormal
   vehicle behavior, built on the deep integration of a diffusion model and
   the transformer architecture. The proposed framework adopts a two-stage
   process: a generation stage, where a classifier-free denoising diffusion
   model reconstructs the normal trajectory distribution from Gaussian
   noise iteratively, and a comparison stage, where deviations between
   observed trajectories and generated normal trajectory distributions are
   quantified to detect anomalies. This method eliminates the need for
   hand-made thresholds, overcoming the subjectivity and rigidity of
   traditional anomaly detection approaches, and effectively addresses the
   severe class imbalance between normal and abnormal samples often
   observed in real-world traffic scenarios. In addition, extensive
   evaluations of real-world traffic datasets demonstrate the superiority
   of the framework, achieving a precision of 0.948, a precision of 0.317,
   a recall of 0.765, and an F1-score of 0.448, significantly exceeding
   state-of-the-art benchmarks. These results underscore the potential of
   the proposed framework as a robust foundation for proactive early
   warning systems in ITS, contributing to safer and more efficient
   transportation networks.},
