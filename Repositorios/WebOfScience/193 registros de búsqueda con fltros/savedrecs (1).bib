@article{ WOS:000844464300001,
Author = {Jing, Hengchang and Wang, Jian},
Title = {Recognition of DDoS attacks based on images correlation analysis within
   deep learning framework},
Journal = {SOFT COMPUTING},
Year = {2022},
Volume = {26},
Number = {21},
Pages = {11783-11794},
Month = {NOV},
Abstract = {Network security is of great significance in our modern society. The
   distributed denial of service (DDoS) attacks is one of the most
   indispensable parts. This study presents a novel way to recognize the
   abnormal traffic flow of DDoS attacks within deep learning framework,
   where both spatial and temporal states are considered. In this method,
   the contents of each flow packet are reconstructed to images of
   different sizes as input variables. A spatial convolutional neural
   network model with convolution and pooling layers and the temporal
   recurrent neural network model with LSTM modules are combined to predict
   DDoS attacks. In the case study, 170 thousand traffic data in a pcap
   file of CICIDS-2017 are extracted by the SplitCap tool to verify the
   effectiveness of this method, and Tensorflow-GPU 2.7 is employed to
   train these models. At last, model evaluation is processed. Compared
   with other methods, the results reveal that the best accuracy,
   precision, recall, and F1-score of recognition of DDoS are 97.60\%,
   100\%, 99.62\% and 97.55\%. Thus, this method has a great potential to
   be applied in network security.
