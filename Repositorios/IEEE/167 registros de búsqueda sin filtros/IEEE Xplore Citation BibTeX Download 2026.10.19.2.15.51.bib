@INPROCEEDINGS{10434683,
  author={Staby, Solomon and R, Manjusha},
  booktitle={2023 Innovations in Power and Advanced Computing Technologies (i-PACT)}, 
  title={Spatial-Temporal Analysis for Traffic Incident Detection Using Deep Learning}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={The domain of Automatic Incident Detection(AID) on roads is predominantly focused on accident detection, lacking the ability to understand specific types of other incidents which may involve accidents. Moreover, existing methods often exhibit limited generalizability, making them susceptible to high error rates when faced with unknown scenarios. To handle these research gaps, this research proposes a deep learning approach that incorporates both the spatial and temporal aspect of videos for the purpose of multiclass video classification in traffic incident detection. By leveraging the modified LRCN network, we enable classification of videos into eight distinct road incident categories. We utilize the Highway incident detection dataset (HWID12) which has more than 2700 videos in different classes. Through rigorous training and comprehensive validation, our approach achieves a precision of 70.30% in the 8-class classification. When considering the dataset as a 2-class classification problem, we achieved an accuracy of 98.02%, which matches the benchmark accuracy on this dataset. These results demonstrate the efficacy of our CNN based framework for automated traffic incident detection, overcoming the limitations of existing methods in terms of specificity and generalizability.},
  keywords={Deep learning;Training;Adaptation models;Surveillance;Roads;Videos;Accidents;Transportation;traffic incident detection;multiclass video classification;LRCN network;deep learning approach},
  doi={10.1109/i-PACT58649.2023.10434683},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10940611,
  author={Jing, Zhao},
  booktitle={2025 International Conference on Electronics and Renewable Systems (ICEARS)}, 
  title={Traffic Incident Detection Algorithm based on Deep Learning: A Statistical Optimization Approach}, 
  year={2025},
  volume={},
  number={},
  pages={1417-1422},
  abstract={The continuous evolution of smart transportation has led to the vigorous development of research in the field of intelligent vehicle anomaly detection. This study proposes a new traffic incident detection algorithm based on deep learning and combines it with statistical optimization methods for real-time traffic incident monitoring. This model first uses the pre-trained YOLOv5m_c model to detect vehicles and outputs images with vehicle frames from the video stream. At the same time, from the data analysis level, it determines whether there is abnormal behavior between vehicles based on the characteristics of the vehicle frame. The proposed algorithm improves the effect of abnormal events by optimizing the network structure of the YOLOv5 model. Then, starting from the sensor level, the detection method based on the Internet of Vehicles collects and shares vehicle status information in real time. This analysis process fully considers the task offloading and migration strategy in the edge computing environment. Quantitative experimental results show that the proposed algorithm can effectively improve the detection accuracy of traffic incidents and reduce the false alarm rate in real-time traffic data.},
  keywords={Deep learning;YOLO;Computational modeling;Streaming media;Prediction algorithms;Real-time systems;Detection algorithms;Anomaly detection;Internet of Vehicles;Edge computing;Traffic Incident Detection;Deep Learning Algorithms;Statistical Optimization;Intelligent Transportation Systems;Real-Time Monitoring},
  doi={10.1109/ICEARS64219.2025.10940611},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10400291,
  author={Lei, Ming and Lin, Jiaojiao and Wang, Shule and Shao, Wenjian},
  booktitle={2023 IEEE International Conference on Signal Processing, Communications and Computing (ICSPCC)}, 
  title={AI Video Analytics Based on Traffic Fusion Computing for Road Traffic Incident Detection}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={To support various applications in intelligent transportation system (ITS), traffic fusion computing (TFC) is proposed to provide heterogeneous computing (including general-purpose computing, media processing, and deep learning inference) and meet practical deployment requirements of roadside edge. Through the collaboration of a host processor (x86 CPU) and an AI accelerator (discrete GPU) in TFC, the heterogeneous computing power enables the end-to-end (E2E) pipeline of multi-channel video analytics for road traffic incident (RTI) detection. Various software toolkits and libraries designed for these processors are used to optimize the performance. The evaluation results show that TFC can achieve very good throughput and processing latency performance even when large portions of CPU and dGPU computing power are not used. TFC has great potential in supporting heavier workloads in more complex ITS applications in the future.},
  keywords={Visual analytics;Pipelines;Throughput;Road traffic;Heterogeneous networks;Software;Libraries;ITS;traffic fusion computing;TFC;CPU;discrete GPU;heterogeneous computing;video analytics;deep learning;road traffic incident;RTI;ITMS;V2X},
  doi={10.1109/ICSPCC59353.2023.10400291},
  ISSN={2837-116X},
  month={Nov},}@INPROCEEDINGS{8788802,
  author={Han, Xiaolin},
  booktitle={2019 20th IEEE International Conference on Mobile Data Management (MDM)}, 
  title={Traffic Incident Detection: A Deep Learning Framework}, 
  year={2019},
  volume={},
  number={},
  pages={379-380},
  abstract={Traffic incidents cause great losses to people's lives and property, and have aroused great attention from researchers. In recent years, many machine learning methods have been utilized for traffic incident detection, e.g. Support Vector Machine (SVM) and Neural Networks (NN). However, all of them fail to consider the full spatial-temporal correlation on traffic data. In addition, the periodicity in traffic data is not well utilized. Traffic data in the same workday usually follows a similar pattern. In this paper, we introduce a deep learning framework, which captures both full spatial-temporal correlation and periodicity, to detect incidents on freeways. Experiments show that our method performs better than the state-of-the-art.},
  keywords={Correlation;Deep learning;Support vector machines;Traffic control;Real-time systems;Artificial neural networks;Roads;traffic analysis;deep learning},
  doi={10.1109/MDM.2019.00-22},
  ISSN={2375-0324},
  month={June},}@INPROCEEDINGS{8054903,
  author={Hatri, Chaimae El and Boumhidi, Jaouad},
  booktitle={2017 Intelligent Systems and Computer Vision (ISCV)}, 
  title={Fuzzy deep learning based urban traffic incident detection}, 
  year={2017},
  volume={},
  number={},
  pages={1-6},
  abstract={Traffic incident detection (TID) is an important part of any modern traffic control because it offers an opportunity to maximise road system performance. For the complexity and the nonlinear characteristics of traffic incidents, this paper proposes a novel fuzzy deep learning based TID method which considers the spatial and temporal correlations of traffic flow inherently. Parameters of the deep network are initialized using a Stacked Auto-Encoder (SAE) model following a layer by layer pre-training procedure. To conduct the fine tuning step, the back-propagation algorithm is used to precisely adjust the parameters in the deep network. Fuzzy logic is employed to control the learning parameters where the objective is to reduce the possibility of overshooting during the learning process, increase the convergence speed and minimize the error. To find the best architecture of the deep network, we used a separate validation set to evaluate different architectures generated randomly based on the Mean Squared Error (MSE). Simulation results show that the proposed incident detection method has many advantages such as higher detection rate and lower false alarm rate.},
  keywords={Neural networks;Fuzzy logic;Machine learning;Computer architecture;Training;Mathematical model;Tuning;Automatic Traffic Incident Detection;Fuzzy Deep Learning;Deep Artificial Neural Network;Stacked Auto-Encoder Model;Back-Propagation Algorithm;Fuzzy Logic Controller},
  doi={10.1109/ISACV.2017.8054903},
  ISSN={},
  month={April},}@INPROCEEDINGS{11011399,
  author={J, Monisha and Ramalingam, L. and Mathankumar, S. and P, Narayanasamy and Rajmohan, M. and Murugan, S.},
  booktitle={2025 3rd International Conference on Advancement in Computation & Computer Technologies (InCACCT)}, 
  title={Convolutional Neural Networks for Enhanced Real-Time Traffic Incident Detection and Image Classification}, 
  year={2025},
  volume={},
  number={},
  pages={489-493},
  abstract={Traffic incident detection and classification are essential aspects of enhancing road safety and efficiency. A new approach to enhancing real-time traffic incident detection and image classification with the help of Convolutional Neural Networks (CNNs), viz., Alex Net, is presented in this paper. Alex Net, a deep CNN architecture that is widely used for image recognition, is employed to classify traffic images and videos for incident identification. The system makes use of the ability of the model to learn robust features to identify images as different events, such as accidents, roadblocks, and vehicle breakdowns. Low latency and high accuracy incident identification is done by the system utilizing real-time traffic camera data and Alex Net. Differentiation between different types of events. This is for the sake of enhancing reaction time, enabling effective traffic management, and differentiating between events. AlexNet enables 92% accuracy in real-time traffic detection and image classification, enhancing the efficiency of intelligent transportation systems. The results demonstrate how deep learning (DL) methods can revolutionise traffic monitoring systems and improve safety protocols for drivers.},
  keywords={Deep learning;Accuracy;Electric breakdown;Real-time systems;Data models;Safety;Convolutional neural networks;Image classification;Accidents;Videos;Traffic Incident Detection;Real-Time Monitoring;Deep Learning;Traffic Management;Incident Categorization},
  doi={10.1109/InCACCT65424.2025.11011399},
  ISSN={},
  month={April},}@INPROCEEDINGS{9101794,
  author={Han, Xiaolin and Grubenmann, Tobias and Cheng, Reynold and Wong, Sze Chun and Li, Xiaodong and Sun, Wenya},
  booktitle={2020 IEEE 36th International Conference on Data Engineering (ICDE)}, 
  title={Traffic Incident Detection: A Trajectory-based Approach}, 
  year={2020},
  volume={},
  number={},
  pages={1866-1869},
  abstract={Incident detection (ID), or the automatic discovery of anomalies from road traffic data (e.g., road sensor and GPS data), enables emergency actions (e.g., rescuing injured people) to be carried out in a timely fashion. Existing ID solutions based on data mining or machine learning often rely on dense traffic data; for instance, sensors installed in highways provide frequent updates of road information. In this paper, we ask the question: Can ID be performed on sparse traffic data (e.g., location data obtained from GPS devices equipped on vehicles)? As these data may not be enough to describe the state of the roads involved, they can undermine the effectiveness of existing ID solutions. To tackle this challenge, we borrow an important insight from the transportation area, which uses trajectories (i.e., moving histories of vehicles) to derive incident patterns. We study how to obtain incident patterns from trajectories and devise a new solution (called Filter-Discovery-Match (FDM)) to detect anomalies in sparse traffic data. Experiments on a taxi dataset in Hong Kong and a simulated dataset show that FDM is more effective than state-of-the-art ID solutions on sparse traffic data.},
  keywords={Roads;Global Positioning System;Trajectory;Frequency division multiplexing;Machine learning;Public transportation;Detectors;Data Mining;Traffic Incident Detection;Sparsity},
  doi={10.1109/ICDE48307.2020.00190},
  ISSN={2375-026X},
  month={April},}@INPROCEEDINGS{11441302,
  author={Kumar, Ajay and Roka, Sanjay and Joshi, Aditya and Diwakar, Manoj and Pandey, Neeraj Kumar and Singh, Prabhishek},
  booktitle={2026 International Conference on AI-Driven Smart Systems and Ubiquitous Computing (ICAUC)}, 
  title={Intelligent Traffic Accident Detection System using Deep Learning Fusion Techniques}, 
  year={2026},
  volume={},
  number={},
  pages={633-639},
  abstract={Video surveillance traffic incident detection is an important part of Intelligent Transportation Systems, as it allows for the quick response to emergency incidents and enhances the safety of road users. The use of fixed cameras to monitor traffic creates several problems for traffic incident detection, including vehicle occlusions; changes in lighting, the complexity of how vehicles interact with each other, and the need to represent both sudden collisions and gradual change in traffic flow over time. While deep learning techniques have shown success in this area, most methods have focused on short-term event modelling and do not have the capacity to capture long-term event dependencies seen in real-world roadways. To address these challenges, an intelligent traffic incident detection framework using a deep fusion architecture is introduced. The spatial feature extraction is performed at the frame level using a ResNet50 backbone. Temporal dependencies on successive frames are captured by using transformer-based encoder. Sequential information of motion over time is refined using a Long Short-Term Memory (LSTM) network; thus, providing a temporal-coherence component of sequencing. The intelligent traffic accident detection framework was tested against the Traffic Accident Detection Dataset, built from highway surveillance camera video footage. The evaluation of the framework produced a classification accuracy of 97.93% (with equal precision and recall for accident and normal traffic classes) in realistic surveillance scenarios.},
  keywords={Deep learning;Traffic control;Video surveillance;Transformers;Cameras;Long short term memory;Intelligent transportation systems;Accidents;Residual neural networks;Videos;Traffic Accident Detection;Intelligent Transportation System;Video Surveillance;Deep learning;ResNet50;Transformer Encoder;LSTM;Computer vision},
  doi={10.1109/ICAUC68182.2026.11441302},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{10630004,
  author={Ogundokun, Roseline Oluwaseun and Ashiedu, Nicole and Olaniyan, Julius and Olaniyan, Deborah and Awoniyi, Charles and Victoria, Adedayo-Ajayi and Akande, Hakeem Babalola and Adebiyi, Abayomi A.},
  booktitle={2024 International Conference on Science, Engineering and Business for Driving Sustainable Development Goals (SEB4SDG)}, 
  title={Development of a Deep Learning-Based System for Road Traffic Anomaly Detection}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Continuous supervision is required to monitor real-world traffic surveillance recordings and take necessary steps in the event of tragic incidents. Nevertheless, constantly monitoring them under human supervision is laborious and prone to errors. Hence, a deep learning technique has been suggested to automatically identify and pinpoint road accidents by framing the issue as anomaly detection. This study focuses on developing an advanced system that uses deep learning approaches to detect irregularities in road traffic. Our research aims to meet this necessity by utilizing the potential of deep learning techniques that are specifically adapted to the complexities of road traffic monitoring. To overcome the limitations of lack of knowledge of the causes of road traffic, the system employs Super-Resolution Generative Adversarial (SRGAN) and Convolutional Neural Network (CNN) models to classify the images obtained from the dataset. The study performed excellently well using CNN and SRGAN with an accuracy of 100%, precision of 100%, recall of 100%, f1-score of 100% and ROC value of 100%.},
  keywords={Deep learning;Training;Visualization;Accuracy;Superresolution;Traffic control;Road traffic;Road anomaly detection;deep learning;anomaly;CNN;SRGAN},
  doi={10.1109/SEB4SDG60871.2024.10630004},
  ISSN={},
  month={April},}@ARTICLE{10872917,
  author={Park, Donghyun and Choi, Sung-Soo and Lim, Donghyun and Kang, Yong-Shin},
  journal={IEEE Access}, 
  title={Graph Multi-Resolution Transformer for Road Traffic Anomaly Detection}, 
  year={2025},
  volume={13},
  number={},
  pages={27428-27437},
  abstract={Traffic anomaly detection has become increasingly vital for ensuring the safety, efficiency, and resilience of urban transportation systems. The emergence of megacities and the integration of autonomous vehicles (AVs) introduce new challenges for anomaly detection in mixed-traffic environments. AVs exhibit distinct driving behaviors compared to human drivers, resulting in more complex traffic scenarios that necessitate advanced detection methods. This paper presents a novel Graph Multi-Resolution Transformer (GMRT) model designed for traffic anomaly detection in environments where autonomous and human-driven vehicles coexist. Utilizing simulation data from the autonomous driving demonstration zone in South Korea, the GMRT effectively captures temporal patterns at multiple resolutions and leverages graph-based spatial relationships to enhance anomaly detection performance. Unlike traditional models that focus on macro-level traffic flow, our approach operates at a micro-level (lane-based), enabling precise identification of anomalies on a per-lane basis. Comparative experiments against established time-series models demonstrate the superior accuracy and robustness of GMRT, particularly in early anomaly detection across varied temporal horizons. The results underscore the model’s potential as a robust solution for contemporary and future urban traffic management challenges, especially in scenarios involving the increasing penetration of AVs.},
  keywords={Anomaly detection;Roads;Transformers;Data models;Road traffic;Feature extraction;Analytical models;Autonomous vehicles;Accuracy;Time series analysis;Deep learning;intelligent transportation monitoring;road traffic anomaly detection;multi-resolution learning;time-series analysis},
  doi={10.1109/ACCESS.2025.3538836},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11551722,
  author={Najafinia, Aminreza and Rahmati, Zahed},
  booktitle={2025 11th International Conference on Signal Processing and Intelligent Systems (ICSPIS)}, 
  title={A Spatiotemporal Graph Autoencoder for Early Freeway Traffic Anomaly Detection}, 
  year={2025},
  volume={},
  number={},
  pages={31-35},
  abstract={Freeway traffic anomalies, such as accidents or sudden slowdowns, require rapid detection to improve safety and reduce congestion. This study uses a graph-based method to detect lane-level traffic anomalies on freeways at an early stage of development. Using a new high-resolution lane-level traffic dataset with sensor data and delayed incident reports, we model the freeway network as a spatiotemporal graph in which nodes represent lanes, and edges capture spatial and temporal dependencies. We adopted the FT-AED baseline graph topology and centered the novelty on a GTG-TGCN autoencoder that models spatiotemporal sequences to detect deviations from normal traffic patterns. Experiments on real-world data show that modeling the spatial relationships between lanes improves the detection performance, whereas ignoring them reduces the accuracy. Compared with prior architectures on the FT-AED benchmark, our model increases AUC by about 3% and achieves more stable lead times with lower delay variability. The proposed model detects approximately 75% of recorded crashes and flags incidents over 10 min earlier than official reports, demonstrating the potential of graph-based models for proactive traffic-incident management.},
  keywords={Modeling;Timing;Anomaly detection;Image sensors;Labeling;Printing;Signal detection;Delays;Equations;Graph neural networks;Traffic Anomaly Detection;Graph Neural Networks;Autoencoder;Spatiotemporal Modeling;Graph Attention Networks},
  doi={10.1109/ICSPIS68676.2025.11551722},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11634483,
  author={Fu, Hangcheng and Xu, Xu and Chan, He},
  booktitle={2026 10th International Conference on Electronic Information Technology and Computer Engineering (EITCE)}, 
  title={Optimization of Traffic Anomaly Detection under Heavy Rain Weather Based on Deep Learning}, 
  year={2026},
  volume={},
  number={},
  pages={1001-1004},
  abstract={This paper proposes a CNN-LSTM fusion algorithm to address the challenge of traffic anomaly detection under heavy rain weather. The algorithm extracts spatial features from traffic image videos using CNN, analyzes the time series patterns of traffic flow and meteorological data using LSTM, and innovatively employs a dynamic attention mechanism based on dual-branch correlation scores to fuse the two types of features. This addresses the dynamic changes in feature importance under heavy rain scenarios (e.g., the weights of water accumulation areas and meteorological data adaptively adjust with the rainfall stage), solving the feature weight mismatch problem of traditional static fusion and achieving accurate detection. Experiments construct datasets containing different heavy rain intensities and traffic flow scenarios, divided into training, validation, and test sets in a 7:1.5:1.5 ratio. Accuracy, recall, and F1 scores are used as metrics, and compared with traditional thresholding methods, SVM, and single CNN/LSTM algorithms. Results show that the proposed algorithm achieves an accuracy of 92.3%, a 20.1% improvement over the traditional thresholding method; the recall reaches 91.1%, which is 13.6% higher than that of the single LSTM algorithm; F1 score of 91.7%, demonstrating significant performance in traffic anomaly detection during heavy rain and good robustness in complex scenarios.},
  keywords={Rain;Algorithms;Modeling;Long short term memory;Convolutional neural networks;Timing;Fluid flow;Accuracy;Meteorology;Printing;Deep learning;Heavy rain;Traffic anomaly detection;Convolutional neural network;Long short-term memory network},
  doi={10.1109/EITCE70137.2026.11634483},
  ISSN={},
  month={June},}@INPROCEEDINGS{8569402,
  author={Zhu, Lin and Guo, Fangce and Krishnan, Rajesh and Polak, John W.},
  booktitle={2018 21st International Conference on Intelligent Transportation Systems (ITSC)}, 
  title={A Deep Learning Approach for Traffic Incident Detection in Urban Networks}, 
  year={2018},
  volume={},
  number={},
  pages={1011-1016},
  abstract={Incident detection function is vital for traffic control and management and is an important prerequisite for quick restoration of smooth traffic flow in urban networks. With accurate and reliable incident detection, a wide range of environmental and economic benefits can be realised by mitigating congestion quickly. This paper proposes a deep learning method, Convolutional Neural Networks (CNN), for automatic detection of traffic incidents in urban networks by using traffic flow data. The method was evaluated using traffic flow and incident datasets from Central London. Performance indexes, such as False Positive Rate, Detection Rate, Precision and F-measurement, are used to comprehensively evaluate the performance of the proposed method in comparison with a conventional machine learning method, i.e., Multi-Layer Perceptron. The results demonstrate that the proposed method may be superior to traditional neural networks with a higher Detection Rate and a lower False Positive Rate. The results also indicate that deep learning-based incident detection may improve the accuracy of incident detection, especially in a large urban network.},
  keywords={Roads;Clustering algorithms;Classification algorithms;Two dimensional displays;Feature extraction;Reliability},
  doi={10.1109/ITSC.2018.8569402},
  ISSN={2153-0017},
  month={Nov},}@INPROCEEDINGS{10094809,
  author={Luo, Haohan and Wang, Feng},
  booktitle={ICASSP 2023 - 2023 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={A Simulation-Based Framework for Urban Traffic Accident Detection}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={Urban traffic accident detection in surveillance videos is an essential task in intelligent traffic monitoring. The current deep-learning based approaches suffer from the lack of large-scale traffic accident video datasets due to the privacy concerns. In this paper, we propose a framework to synthesize traffic videos containing both normal traffic and accident events by simulating the real urban traffic scenarios. By introducing various weather conditions, viewpoints of surveillance cameras, and traffic statuses, we can simulate the complex real-world traffic scenarios. The vehicles are automatically controlled to behave normally or trigger accidents randomly. Based on our framework, we automatically generate a synthetic dataset containing 1,100 distinct traffic videos with video-level annotations. For accident detection, we observe that the existing reconstruction-based models produce many false alarms by predicting the pseudo accidents (non-accident anomalous traffic events) as real accidents. To address this ambiguity problem, we propose an improved approach by employing multiple instance learning to refine the detection results. Our experiments demonstrate the great potentials of our proposed framework in boosting the performance of accident detection on real-world datasets. We make our code and dataset publicly available at https://github.com/hankluo2/UrbanTrafficAccidentDetection.},
  keywords={Training;Surveillance;Traffic control;Signal processing;Boosting;Task analysis;Speech processing;Accident detection;urban traffic;surveillance videos;simulation},
  doi={10.1109/ICASSP49357.2023.10094809},
  ISSN={2379-190X},
  month={June},}@INPROCEEDINGS{11510773,
  author={Amanatulla, Md. and Bhargav, P. Sai Naga and Chaitanya, U. and Reddy, A. Jhansi Priya},
  booktitle={2026 9th International Conference on Inventive Computation Technologies (ICICT)}, 
  title={Smart Surveillance System using MobileNetV2-LSTM for Criminal Activity and Traffic Incident Detection}, 
  year={2026},
  volume={},
  number={},
  pages={351-357},
  abstract={Rising trends in urbanization contribute to substantial demands for an efficient and automated surveillance system with the capacity to identify criminal acts and road accidents in real time. Generally, the surveillance system is mostly dependent on human monitoring, which is inefficient, unreliable, and incapable of timely reaction to emergencies. To achieve an efficient and precise surveillance system, especially in order to automatically identify suspicious and life-threatening acts in video, this article presents design techniques for developing the smart surveillance system. This system employs the use of spatiotemporal learning to efficiently analyze image appearance and motion in the video. Additionally, frames of the video are extracted and preprocessed, and features are learned using MobileNetV2, which is ideal for real-time processing. To efficiently represent spatiotemporal information in the learning process, the features are then input into the Long Short-Term Memory network with the capacity to efficiently process dependencies among frames to recognize precise acts. For classification, the proposed system has been trained to distinguish ten types of activity, which in turn comprised various criminal activities, road accidents, and normal activities. Computer vision algorithms for real-time detection help demarcate the location of activities, draw bounding boxes, and generate warning signals in case of critical activities. Testing revealed that a high accuracy rate of 94.55% allows the proposed system to strongly detect activities. This proves that the proposed surveillance system would be very useful for improving safety in a significant manner.},
  keywords={Modeling;Surveillance;Videos;Long short term memory;Real-time systems;Timing;Printing;Accuracy;Training;Convolutional neural networks;Smart Surveillance;Criminal Activity Detection;Traffic Incident Detection;Deep Learning;Real-time Video Analysis and MobileNetV2-LSTM},
  doi={10.1109/ICICT68280.2026.11510773},
  ISSN={2767-7788},
  month={April},}@INPROCEEDINGS{10237134,
  author={Tee, Fu Swee and Theng, Lau Bee and Shiong, Brian Loh Chung and Tsun, Mark Tee Kit},
  booktitle={2023 IEEE 13th International Conference on Control System, Computing and Engineering (ICCSCE)}, 
  title={The Bigger Picture: Scene Understanding for Recognizing Accidents within Mixed-Traffic Scenario using Deep Learning}, 
  year={2023},
  volume={},
  number={},
  pages={39-44},
  abstract={Detecting road traffic accidents in a timely manner is crucial for reducing traffic fatalities. Computer vision techniques are increasingly being used for road traffic accident recognition because of their ability to automatically analyze traffic scenes without needing manual human interpretation. To date, Deep learning has made significant paces in addressing time-series problems and is increasingly being utilized for road traffic accident detection. However, detecting accidents in a mixed traffic flow environment is challenging due to difficulties in detecting smaller-sized road users and annotating unsafe trajectories, particularly in scenarios where larger-sized road users overshadow smaller-sized road users. Therefore, it may be more effective to consider the entire traffic scene as a whole, instead of focusing on individual objects. This paper proposes a Deep Learning model that analyzes the entire traffic scene using a recurrent neural network, ConvLSTM2D, for road traffic accident detection in mixed traffic flow environments. The model is evaluated on 139 videos of a testing dataset, achieving an accuracy of 84%. Future work will focus on further analyzing potential accident features across video frames to enhance the model’s performance.},
  keywords={Deep learning;Analytical models;Recurrent neural networks;Roads;Manuals;Road traffic;Trajectory;Deep Learning;Road Traffic Accident Detection;Mixed Traffic Flow Environment;CCTV Surveillance;ConvLSTM2D},
  doi={10.1109/ICCSCE58721.2023.10237134},
  ISSN={},
  month={Aug},}@ARTICLE{9306801,
  author={Shang, Qiang and Feng, Linlin and Gao, Song},
  journal={IEEE Access}, 
  title={A Hybrid Method for Traffic Incident Detection Using Random Forest-Recursive Feature Elimination and Long Short-Term Memory Network With Bayesian Optimization Algorithm}, 
  year={2021},
  volume={9},
  number={},
  pages={1219-1232},
  abstract={Automatic Incident Detection (AID) is an important part of Intelligent Transportation Systems (ITS). A hybrid AID method using Random Forest-Recursive Feature Elimination (RF-RFE) algorithm and Long-Short Term Memory (LSTM) network optimized by Bayesian Optimization Algorithm (BOA) is proposed in this article. Firstly, a relatively comprehensive set of initial variables is constructed using basic traffic variables and their combinations. Secondly, feature variables are selected from the initial variables using the RF-RFE algorithm. Then, the feature variables are used for training the LSTM network, and the hyper-parameters of the LSTM network are optimized by BOA. In addition, Synthetic Minority Over-Sampling Technique (SMOTE) is employed to solve the problem of imbalance between incident sample size and non-incident sample size. Finally, experiments are conducted using real-world data to test performance of the proposed method and compare with several state-of-the-art AID methods on multiple evaluation criteria. The experimental results illustrate that the proposed method achieved superior performance with respect to almost all the evaluation criteria. It also shows that the proposed method is promising for dealing with the problems of imbalance and small sample size of traffic incident data.},
  keywords={Detectors;Prediction algorithms;Volume measurement;Support vector machines;Roads;Machine learning algorithms;Feature extraction;Traffic incident detection;feature selection;long short-term memory network;Bayesian optimization algorithm},
  doi={10.1109/ACCESS.2020.3047340},
  ISSN={2169-3536},
  month={},}@ARTICLE{9740116,
  author={Xie, Tian and Shang, Qiang and Yu, Yang},
  journal={IEEE Access}, 
  title={Automated Traffic Incident Detection: Coping With Imbalanced and Small Datasets}, 
  year={2022},
  volume={10},
  number={},
  pages={35521-35540},
  abstract={Automatic incident detection (AID) has always been one of the focus issues in the field of transportation. However, due to the contingency and randomness of traffic incident, traffic incident samples are scarce and far less than non-incident samples. Therefore, unlike other scenarios using large-scale deep networks, traffic incident detection tackle at small and imbalanced sample size. Imbalanced, small sample data sets, inappropriate and incomplete initial variable sets make the AID model insensitive to incident samples, resulting in unsatisfactory model performance (low detection rate or high false alarm rate). Therefore, a hybrid AID method (SASYNO-RF-RSKNN) is proposed using self-adaptive synthetic over-sampling, random forest and random subspace k nearest neighbor. First, the spatial-temporal and real-time characteristics of traffic stream are used for the selection of appropriate initial variables to construct a relatively complete set of initial variables. Second, the SASYNO oversampling method is used to expand the original imbalanced sample database, so that the number of minority class samples is consistent with the number of most class samples. Then, feature variables are selected from the initial variables using the RF algorithm. Finally, the RSKNN ensemble algorithm with feature variables as input is employed to detect traffic incident. In addition, six indexes are used to evaluate model performance, including accuracy (ACC), false alarm rate (FAR), detection rate (DR), precision, Matthews correlation coefficient (MCC) and F1-score. Simultaneously, we also designed horizontal and vertical contrast experiments, and the experimental results show that SASYNO-RF-RSKNN model has superior performance. It is worth mentioning that experiments are implemented on two real-world datasets. Most indexes of the proposed model are the best compared with other five excellent machine learning algorithms. On the whole, the proposed model has a dependable and high-performance for traffic incident detection.},
  keywords={Machine learning algorithms;Data models;Support vector machines;Adaptation models;Real-time systems;Neural networks;Classification algorithms;Traffic incident detection;ensemble-learning;spatial and temporal characteristic;SASYNO;random subspace k nearest neighbor},
  doi={10.1109/ACCESS.2022.3161835},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11468129,
  author={Bompally, Santosh Datta},
  booktitle={2026 International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA)}, 
  title={Quantum-Inspired Autoencoder and LSTM Model for Encrypted Traffic Anomaly Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={The current communication systems have seen their encrypted network traffic grow exponentially and this has made the detection of malicious actions hidden under privacy-preserving protocols a significantly hard task. Traditional intrusion detection frameworks and deep learning networks like CNN, GRU, and DNN depend largely on packet payloads or the flow level statistics, thus they are not very useful in encrypted settings. In an effort to address this challenge, the present paper introduces a Quantum-Inspired Autoencoder and LSTM (QAE-LSTM) model that combines quantum-inspired feature encoding with deep time learning to detect the anomaly efficiently and with a lower false-positive rate. As in the suggested framework, quantum amplitude encoding codes classical flow features in a high-dimensional Hilbert space, increasing their representational power. The realized quantum-transformed features are compressed by the autoencoder to eliminate redundancy, and the LSTM layer is learned to identify sequential traffic patterns to distinguish normal and abnormal ones, which is proven to be more effective than conventional deep learning baselines on the CIC-IDS 2021 dataset. The experimental results on the CIC-IDS 2021 dataset exhibit the best performance with an accuracy of 94.8 %, precision of 92.8 %, recall of 94.2 % and F1-score of 93.5%, which outperforms existing CNN, GRU, and Transformer models by 3-6. The findings verify that quantum-inspired learning principles can be used to a large degree to enhance encrypted traffic analysis with higher computational efficiency and scalability.},
  keywords={Payloads;Military aircraft;Space technology;Feeds;Antennas;Circuits;Quantum circuit;System-on-chip;Circuits and systems;Communication systems;Quantum-inspired computing;Autoencoder;LSTM;Encrypted traffic;Anomaly detection},
  doi={10.1109/ACDSA67686.2026.11468129},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{8569426,
  author={Chakraborty, Pranamesh and Sharma, Anuj and Hegde, Chinmay},
  booktitle={2018 21st International Conference on Intelligent Transportation Systems (ITSC)}, 
  title={Freeway Traffic Incident Detection from Cameras: A Semi-Supervised Learning Approach}, 
  year={2018},
  volume={},
  number={},
  pages={1840-1845},
  abstract={Early detection of incidents is a key step to reduce incident related congestion. State Department of Transportation (DoTs) usually install a large number of Close Circuit Television (CCTV) cameras in freeways for traffic surveillance. In this study, we used semi-supervised techniques to detect traffic incident trajectories from the cameras. Vehicle trajectories are identified from the cameras using state-of-the-art deep learning based You Look Only Once (YOLOv3) classifier and Simple Online Realtime Tracking (SORT) is used for vehicle tracking. Our proposed approach for trajectory classification is based on semi-supervised parameter estimation using maximum-likelihood (ML) estimation. The ML based Contrastive Pessimistic Likelihood Estimation (CPLE) attempts to identify incident trajectories from the normal trajectories. We compared the performance of CPLE algorithm to traditional semi-supervised techniques Self Learning and Label Spreading, and also to the classification based on the corresponding supervised algorithm. Results show that approximately 14% improvement in trajectory classification can be achieved using the proposed approach.},
  keywords={Trajectory;Cameras;Maximum likelihood estimation;Video sequences;Vehicle detection;Linear programming;traffic incident detection;surveillance;semi-supervised learning;maximum likelihood estimation},
  doi={10.1109/ITSC.2018.8569426},
  ISSN={2153-0017},
  month={Nov},}@INPROCEEDINGS{10199977,
  author={Arifeen, Zain Ul and Hong, Jang-Eui and Seo, Bo-Seok and Suh, Jae-Won},
  booktitle={2023 Fourteenth International Conference on Ubiquitous and Future Networks (ICUFN)}, 
  title={Traffic Accident Detection and Classification in Videos based on Deep Network Features}, 
  year={2023},
  volume={},
  number={},
  pages={491-493},
  abstract={The number of vehicles on the road has increased significantly, which pose a number of challenges to cope with for traffic management. Especially road accidents need instant attention to reduce the loss of people life and their property. In this paper, we propose a traffic accident detection and classification framework, which automatically detects accident in traffic videos using deep networks features and also classify that accident into car-car and car-bike collisions. The proposed framework works in two phases. Accident anomaly detection: We explore three convolution neural networks (CNN’s) named GoogLeNet, AlexNet and VGGNet, where deep features are extracted using these networks and a one class support vector machine (OCSVM) is trained on each network deep features, which are used to detect accident anomalies in a outlier fashion. Accident anomaly classification: where a multi-class SVM model is trained using the features of the detected accident frames and is used to classify accident into car-car and car-bike collisions. The experimental results on UCF-Crime road accident video sequences show that the proposed approach achieves high accuracy on both traffic accident anomaly detection and classification.},
  keywords={Support vector machines;Training;Road accidents;Video sequences;Traffic control;Feature extraction;Anomaly detection;GoogLeNet;AlexNet;VGGNet;Accident detection;Accident classification;One class svm;Multi-class svm},
  doi={10.1109/ICUFN57995.2023.10199977},
  ISSN={2165-8536},
  month={July},}@INPROCEEDINGS{11518270,
  author={Priya, Biyyapu Vishnu and Prasad, Kadiyam Rahul and Senthil, M.},
  booktitle={2026 International Conference on Smart Electronic Devices and Intelligent Systems (ICSEDIS)}, 
  title={DGC-TAMNet: A Dynamic Graph-Convolutional Transformer Framework for Imbalanced Network Traffic Anomaly Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1709-1714},
  abstract={Due to the increasing volume of traffic in the networking environment, the continuous evolution of attack patterns has become a major challenge for contemporary intrusion detection systems. Although deep-learning-based approaches have shown substantial improvement in detecting anomalies in network traffic, many existing methods still suffer from high complexity, limited capability to capture relationships among different traffic flows, and reduced efficiency when handling imbalanced datasets. To address these limitations, this study proposes a Deep Generalized Collaborating TAM Network (DGC-TAMNet) that integrates a graph-convolutional transformer-based neural architecture with an adaptive minority-aware learning strategy for effective anomaly classification in internet traffic networks. In the proposed approach, related traffic flows are modeled as a graph structure where a graph convolutional neural network extracts dependency information among flows. In addition, a lightweight temporal transformer encoder is employed to capture temporal characteristics from traffic flow signals. The collaborative integration of these components improves the ability of the system to identify anomalies in complex and imbalanced network traffic scenarios. Experimental evaluation demonstrates that the proposed framework achieves a classification accuracy of 96.8%, while also improving precision and recall, thereby providing an efficient and reliable solution for anomaly detection in modern internet traffic environments.},
  keywords={Modeling;Transformers;Intrusion detection;Fluid flow;Telecommunication traffic;Printing;Accuracy;Anomaly detection;Learning (artificial intelligence);Convolutional neural networks;Network traffic anomaly detection;intrusion detection system;graph convolutional network;transformer model;class imbalance;deep learning},
  doi={10.1109/ICSEDIS68157.2026.11518270},
  ISSN={},
  month={April},}@INPROCEEDINGS{11483563,
  author={G, Mamatha Bai B and Jone, I Shania and Dhanusha, Modiyam},
  booktitle={2026 3rd International Conference on Integrated Intelligence and Communication Systems (ICIICS)}, 
  title={A Privacy-Aware Traffic Incident Detection and Emergency Response System Using Federated Learning}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Traffic incident detection and emergency response are critical services of intelligent transportation systems, especially in an urban setting, where the centralized processing of the data creates privacy and latency issues. To overcome these challenges, this paper has developed a decentralized traffic management model which incorporates federated learning, batch based convolutional neural networks, and an interrupt service routing system. Detection of incidences in edge devices happens by using short-term temporal context and vehicles cooperatively learn patterns of travel-time through federated model training. The proposed system is tested with the help of the Metro Interstate Traffic Volume data set of the UCI Machine Learning Repository and with the help of the controlled experimental settings. The experimental findings indicate that the framework has an RMSE of $\mathbf{1 6 7. 2 0}$ and MAE of $\mathbf{1 2 8. 4 5}$ to predict routing with lower levels of false-alarms and quicker response to an emergency than centralized baselines. Furthermore, communication-efficient learning does not violate data privacy, but the performance is stable. The framework therefore presents a workable and scalable approach to the privacy-sensitive and real-time traffic management.},
  keywords={Performance evaluation;Data privacy;Adaptive systems;Uncertainty;Federated learning;Image edge detection;Transportation;Routing;Emergency services;Real-time systems;Federated learning;intelligent transportation systems;traffic incident detection;edge intelligence;batch processing;adaptive routing;interrupt service routing;emergency response systems},
  doi={10.1109/ICIICS67880.2026.11483563},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10920070,
  author={Peddiraju, Sai Shashank and Harapanahalli, Kaustubh and Andert, Edward and Shrivastava, Aviral},
  booktitle={2024 IEEE 27th International Conference on Intelligent Transportation Systems (ITSC)}, 
  title={IncidentNet: Traffic Incident Detection, Localization and Severity Estimation with Sparse Sensing}, 
  year={2024},
  volume={},
  number={},
  pages={1470-1475},
  abstract={Prior art in traffic incident detection relies on high sensor coverage and is primarily based on decision-tree and random forest models that have limited representation capacity and, as a result, cannot detect incidents with high accuracy. This paper presents IncidentNet - a novel approach for classifying, localizing, and estimating the severity of traffic incidents using deep learning models trained on data captured from sparsely placed sensors in urban environments. Our model works on microscopic traffic data that can be collected using cameras installed at traffic intersections. Due to the unavailability of datasets that provide microscopic traffic details and traffic incident details simultaneously, we also present a methodology to generate a synthetic microscopic traffic dataset that matches given macroscopic traffic data. IncidentNet11https://github.com/MPSLab-ASU/IncidentNet achieves a traffic incident detection rate of 98%, with false alarm rates of less than 7% in 197 seconds on average in urban environments with cameras on less than 20% of the traffic intersections.},
  keywords={Location awareness;Sensor placement;Accuracy;Microscopy;Roads;Urban areas;Estimation;Cameras;Data models;Random forests},
  doi={10.1109/ITSC58415.2024.10920070},
  ISSN={2153-0017},
  month={Sep.},}@INPROCEEDINGS{9294455,
  author={Yang, Huan and Wang, Yu and Zhao, Han and Zhu, Jinlin and Wang, Danwei},
  booktitle={2020 IEEE 23rd International Conference on Intelligent Transportation Systems (ITSC)}, 
  title={Real-time Traffic Incident Detection Using an Autoencoder Model}, 
  year={2020},
  volume={},
  number={},
  pages={1-6},
  abstract={Traffic flow data collected by loop detectors have been widely used for traffic incident detection. As traffic flow data have strong spatial-temporal correlations, this study tries to detect traffic incidents using an unsupervised learning approach. In this paper, a novel automatic incident detection (AID) method based on Autoencoder (AE) is proposed to detect the occurrence time and the location of traffic incidents in both freeway and urban networks. AE is an unsupervised machine learning model, which extracts nonlinear features of traffic flow data. A statistic named Squared Prediction Error (SPE) is constructed for incident detection. Meanwhile, the contribution plot technique is applied for incident localization. The experiments are conducted via a microscopic simulation platform Vissim and the test results verify the efficiency and effectiveness of the proposed method.},
  keywords={Detectors;Traffic control;Roads;Training;Monitoring;Feature extraction;Prediction algorithms},
  doi={10.1109/ITSC45102.2020.9294455},
  ISSN={},
  month={Sep.},}@ARTICLE{10454581,
  author={Liu, Chen and Chen, Jiming and Liu, Haoyu and Li, Shizhong and He, Shibo},
  journal={IEEE Internet of Things Journal}, 
  title={Toward Efficient Traffic Incident Detection via Explicit Edge-Level Incident Modeling}, 
  year={2024},
  volume={11},
  number={11},
  pages={20015-20029},
  abstract={Traffic incident detection is a critical task within traffic monitoring systems, enabling on-the-fly alerts for emergency actions. Numerous efforts have been made to detect and localize traffic incidents using data recorded by inductive loop detectors. However, they only focus on the node-level incidents that happen within the surveillance areas and ignore the edge-level ones that take place outside of these areas. In this article, we propose to detect both kinds of incidents simultaneously based on the sparsely distributed sensors. An important challenge is how to explicitly model the edge status and detect this kind of incident. Additionally, capturing complex relationships among traffic dynamics, road locations, and temporal information is nontrivial. In this article, we first describe the traffic dynamics by a fine-grained graph where the sensor range is designed as a hyperparameter to control the coverage boundaries. Then, we propose an edge- and node-aware dual autoencoder (ENDAE), where the correlations are decoupled into internodes, interseries, and interattribute parts, which are further captured via node encoder, temporal encoder, and attribute encoder, respectively. Furthermore, the reconstruction errors are calculated for node-level and edge-level event detection separately. The overall method is evaluated based on two real-world data sets from the Bay Area and Los Angeles in California. ENDAE surpasses all the state-of-the-art methods in both kinds of incidents, with at least a 12.5% improvement in recall and an 18.5% decrease in delay. Notably, for edge-level incidents, ENDAE achieves double the recall of the previous SOTA methods.},
  keywords={Sensors;Image edge detection;Roads;Sensor phenomena and characterization;Internet of Things;Detectors;Anomaly detection;Graph autoencoder (AE);incident detection;traffic monitoring system},
  doi={10.1109/JIOT.2024.3371482},
  ISSN={2327-4662},
  month={June},}@INPROCEEDINGS{10594262,
  author={Guo, Yunying and Li, Xiaofei},
  booktitle={2024 Second International Conference on Data Science and Information System (ICDSIS)}, 
  title={Abnormal Traffic Detection in Data Mining Techniques using Scaled Exponential Linear Unit based Deep Autoencoders}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={With the advanced development of data mining techniques, the abnormal traffic detection is becoming simple and easy to acquire. The existing approaches are complex to estimate the time series data in parallel as well as vanishing or gradient explosion problems are most often occurring. Hence, this research proposes the Scaled Exponential Linear Unit based Deep Autoencoders (SELU-DAE) approach for the abnormal traffic detection according to the data mining techniques. Initially, this research collects the two public data sets such as NSL-KDD and UNSW-NB15 for the estimation of model performance. Then, the Min-Max normalization technique is utilized to equally scale the input features and then, the Principal Component Analysis (PCA) technique is utilized to select the significant features in the features selection process. Finally, the SELU-DAE approach is utilized for the detection process. The experimental results show the proposed SELUDAE attains better accuracy of 98.43% and 99.31% on NSLKDD and UNSW-NB15 dataset when compared to the existing methods like Deep Convolution Neural Network (DCNN) and Bidirectional Independent Recurrent Neural Network (BiIndRNN).},
  keywords={Accuracy;Sensitivity;Recurrent neural networks;Time series analysis;NSL-KDD;Data mining;Security;abnormal traffic detection;data mining;principal component analysis;scaled exponential linear unit based deep autoencoders and vanishing problem},
  doi={10.1109/ICDSIS61070.2024.10594262},
  ISSN={},
  month={May},}@INPROCEEDINGS{10288989,
  author={Tran, Mai-Khiem and Huynh, Viet-Tham and Tran, Minh-Triet},
  booktitle={2023 International Conference on Multimedia Analysis and Pattern Recognition (MAPR)}, 
  title={Leveraging Deep Learning and Knowledge Distillation for Enhanced Traffic Anomaly Detection in Transportation Systems}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper introduces an innovative approach to enhance traffic anomaly detection in transportation systems using deep learning and knowledge distillation. We create a robust dataset from 427 videos containing 1,415 accident-related events, spanning various anomalies like accidents, car crashes, and pedestrian violations. To address real-time anomaly detection challenges, we propose a novel lightweight neural network architecture inspired by EfficientNet-B0, designed for efficient video anomaly detection. Through knowledge distillation, a student model learns from a teacher model’s predictions, resulting in heightened anomaly detection accuracy. Experimental results highlight the approach’s efficacy, with the knowledge-distilled student model consistently outperforming the standalone lightweight network, achieving an accuracy of 94.83% compared to 94.16%. This research offers a practical solution for real-time traffic anomaly detection, which is especially valuable in resource-constrained environments. Fusing a unique dataset, EfficientNet-B0-like structure, lightweight architecture, and knowledge distillation holds significant potential for fostering safer and more efficient transportation systems.},
  keywords={Deep learning;Neural networks;Transportation;Predictive models;Real-time systems;Safety;Task analysis;Traffic Anomaly Detection;Knowledge Distillation;Video Analysis;Transportation Systems},
  doi={10.1109/MAPR59823.2023.10288989},
  ISSN={2770-6850},
  month={Oct},}@INPROCEEDINGS{11465333,
  author={Gupta, Priti and KrishnaPai, Saketh SudhirKumar and Menon, Gadha S and Wanza, Ngotho Elizabeth and Namitha, K.},
  booktitle={2026 IEEE International Conference on Interdisciplinary Approaches in Technology and Management for Social Innovation (IATMSI)}, 
  title={STAnomalyNet: Spatio-Temporal Traffic Anomaly Detection with ConvLSTM}, 
  year={2026},
  volume={4th},
  number={},
  pages={1-6},
  abstract={Traffic anomaly detection is critical for ensuring safe and dependable transportation systems, as early detection of accidents or aberrant driving behavior might avert escalation. This work introduces STAnomalyNet, a model that learns usual scene look and motion and highlights deviations to identify anomalous events in traffic videos. The architecture uses ConvLSTM to capture temporal motion patterns, ResNet-18 for visual feature extraction, and a temporal attention module to concentrate on key moments. MSE, SSIM, and perceptual loss are combined to increase reconstruction quality. The model, which is trained only on normal traffic data in a one-class learning configuration, detects abnormalities based on reconstruction error during testing. STAnomalyNet outperformed more straightforward baselines with a ROC-AUC of 0.5236 and an F1-score of 0.6024 on a sample of 510 traffic clips. The results also demonstrate the significant influence of temporal modeling. All things considered, the model shows promise for intelligent transportation systems and realtime surveillance.},
  keywords={Motion pictures;Broadcasting;Internet of Things;Pixel;Videos;Communication systems;Protocols;Internet;Video equipment;HTTP;Traffic anomaly detection;deep learning;ConvLSTM;spatio-temporal modeling;video analysis;attention mechanism},
  doi={10.1109/IATMSI68868.2026.11465333},
  ISSN={},
  month={March},}@INPROCEEDINGS{11536548,
  author={Zhu, Qiyuan and Zhao, Zhuowei and Qin, A. K. and Dia, Hussein and Grzybowska, Hanna},
  booktitle={2026 IEEE Conference on Artificial Intelligence (CAI)}, 
  title={Unsupervised and Decentralized Traffic Incident Detection via Network Lasso}, 
  year={2026},
  volume={},
  number={},
  pages={1411-1416},
  abstract={Recent advances in traffic incident detection have increasingly adopted decentralized learning and inference based on locally generated data from distributed traffic sensors. A key challenge in this paradigm lies in the non-independent and identically distributed (non-IID) nature of traffic data across different regions. Moreover, most existing approaches rely on federated learning (FL) with deep neural networks (DNNs) as backbone models. Although effective, these approaches typically require long look-back windows to capture meaningful traffic patterns, often resulting in high detection latency, especially when early-stage abnormal signals are overshadowed by dominant normal patterns within the detection window. In this work, we revisit a classical yet powerful unsupervised anomaly detection method, the one-class support vector machine (OCSVM), and extend it to decentralized learning settings through network lasso (NL), a mathematically elegant but relatively underexplored distributed optimization framework capable of handling data heterogeneity. The proposed NL-OCSVM method enables low-latency unsupervised incident detection in the local traffic region by leveraging data from other regions with similar characteristics, while mitigating the adverse effects of non-IID data. Experiments on several real-world traffic datasets demonstrate that the proposed method achieves low detection latency and competitive accuracy compared to existing DNN-based FL methods.},
  keywords={Modeling;Signal detection;Printing;Optimization;Federated learning;Medical services;Training;Windows;Image sensors;Long short term memory},
  doi={10.1109/CAI68641.2026.11536548},
  ISSN={},
  month={May},}@ARTICLE{10457982,
  author={Chen, Junzhou and Pu, Jiajun and Yin, Baiqiao and Zhang, Ronghui and Wu, Jun Jie},
  journal={IEEE Transactions on Intelligent Transportation Systems}, 
  title={TA-NET: Empowering Highly Efficient Traffic Anomaly Detection Through Multi-Head Local Self-Attention and Adaptive Hierarchical Feature Reconstruction}, 
  year={2024},
  volume={25},
  number={9},
  pages={12372-12384},
  abstract={In the realm of road surveillance systems, Automatic Incident Detection (AID) methods have shown promise in swiftly and precisely detecting traffic anomalies. Nevertheless, the paucity of frame-level precisely annotated training data poses substantial challenges. To navigate this issue, we introduce TA-NET, a novel framework designed to highly efficient traffic anomaly detection. TA-NET utilizes a generic dataset pre-training model to facilitate weakly supervised learning. It comprises two main modules: the Adaptive Hierarchical Feature Reconstruction Block (AHFRB) and the Multi-Head Local Self-Attention (MHLSA) mechanism. AHFRB refines the feature extractor by reconstructing the features drawn from the pre-trained model. Concurrently, MHLSA scrutinizes the contextual relationships between contiguous video segments and bolsters anomaly detection accuracy. Our approach was validated using the TAD testing dataset, with the results highlighting the efficacy of TA-NET. Remarkably, it accomplishes an Area Under the Curve (AUC) of 94.47% for the overall dataset and 70.78% for the anomaly subset. These scores surpass the previous state-of-the-art method by 1.54% and 4.96%, respectively, attesting to TA-NET’s superior performance. Consequently, our study offers a fresh perspective and sets a new standard for future video-based traffic incident detection research.},
  keywords={Feature extraction;Anomaly detection;Hidden Markov models;Supervised learning;Benchmark testing;Training;Traffic control;Supervised learning;Feature extraction;anomaly detection;traffic anomaly detection;weakly supervised learning;multi-instance learning;transformer},
  doi={10.1109/TITS.2024.3365820},
  ISSN={1558-0016},
  month={Sep.},}@INPROCEEDINGS{10326277,
  author={HajiAbadi, Mohammad Mahdi and Nahvi, Manoochehr},
  booktitle={2023 13th International Conference on Computer and Knowledge Engineering (ICCKE)}, 
  title={A supervised approach using transformer networks for the detection of turning-related anomalies in urban intersections}, 
  year={2023},
  volume={},
  number={},
  pages={469-473},
  abstract={Traffic anomalies in urban areas are the main reason for traffic congestion and accidents. an effective tool for decreasing these anomalies is employing intelligent systems for monitoring road traffic and law enforcement. these systems may make decisions using features based on different modalities. to detect anomalies, video-based systems usually use the speed, direction, and trajectory of vehicles. among various types of traffic anomalies, this research focused on turning-related anomalies in urban roads and intersections, which are the most critical challenges of intelligent traffic monitoring systems. in this research, a supervised system based on a transformer network was designed and examined on real traffic video sequences. the evaluation of our system demonstrated that the proposed method can detect turning-related anomalies with about 96% accuracy.},
  keywords={Knowledge engineering;Computational modeling;Video sequences;Urban areas;Transformers;Trajectory;Convolutional neural networks;traffic anomaly detection;visual surveillance;transformer neural network},
  doi={10.1109/ICCKE60553.2023.10326277},
  ISSN={2643-279X},
  month={Nov},}@INPROCEEDINGS{11354213,
  author={Zhang, Jinming},
  booktitle={2025 5th International Conference on Mobile Networks and Wireless Communications (ICMNWC)}, 
  title={FA-cGAN: Feature-Aware Conditional Generated Adversarial Networks for Enhance Network Traffic Anomaly Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In recent years, intelligent network traffic anomaly detection has become an essential for mitigating cyber threats and ensuring reliable communication in modern networks. Detection of network traffic anomaly remains challenging due to dynamic traffic patterns and diverse device types. Existing Deep Learning (DL) methods are used for network traffic anomaly detection. However, the models fail to capture complex spatio-temporal dependencies in traffic. To address these issues, this paper proposes a Feature-Aware Conditional Generated Adversarial Networks (FA-cGAN) to detect difference types of network traffic anomaly detection. The FA-cGAN model integrates feature-aware component uses spatial and temporal features enabling the model to learn sequence dependencies and complex features. The proposed FAcGAN model obtained 98.25\% accuracy on CICIDS 2017 dataset and 98.12% on UNSW-NB15 dataset when compared to traditional models. The result shows effectiveness of FA-cGAN as reliable model for different types of network traffic anomaly detection.},
  keywords={Deep learning;Wireless communication;Intelligent networks;Accuracy;Telecommunication traffic;Traffic control;Feature extraction;Robustness;Data models;Anomaly detection;deep learning;feature-aware conditional;generated adversarial networks;spatial feature;temporal feature},
  doi={10.1109/ICMNWC66779.2025.11354213},
  ISSN={},
  month={Dec},}@ARTICLE{10497566,
  author={Adewopo, Victor A. and Elsayed, Nelly},
  journal={IEEE Access}, 
  title={Smart City Transportation: Deep Learning Ensemble Approach for Traffic Accident Detection}, 
  year={2024},
  volume={12},
  number={},
  pages={59134-59147},
  abstract={The dynamic and unpredictable nature of road traffic necessitates effective accident detection methods for enhancing safety and streamlining traffic management in smart cities. This paper offers a comprehensive exploration study of prevailing accident detection techniques, shedding light on the nuances of other state-of-the-art methodologies while providing a detailed overview of distinct traffic accident types like rear-end collisions, T-bone collisions, and frontal impact accidents. Our novel approach introduces the I3D-CONVLSTM2D model architecture, a lightweight solution tailored explicitly for accident detection in smart city traffic surveillance systems by integrating RGB frames with optical flow information. Empirical analysis of our experimental study underscores the efficacy of our model architecture. The I3D-CONVLSTM2D RGB + Optical-Flow (trainable) model outperformed its counterparts, achieving an impressive 87% Mean Average Precision (MAP). Our findings further elaborate on the challenges posed by data imbalances, particularly when working with a limited number of datasets, road structures, and traffic scenarios. Ultimately, our research illuminates the path towards a sophisticated vision-based accident detection system primed for real-time integration into edge IoT devices within smart urban infrastructures.},
  keywords={Accidents;Road traffic;Smart cities;Traffic control;Feature extraction;Computer architecture;Cameras;Traffic control;Autonomous vehicles;Deep learning;Traffic surveillance;accident detection;action recognition;smart city;autonomous transportation;deep learning},
  doi={10.1109/ACCESS.2024.3387972},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10253870,
  author={Sherimon, P.C. and Sherimon, Vinu and Husaini, Yousuf Nasser Al and Kuruvilla, Ambily Merlin and Varghese, Ajit Mammen and D, Harikrishnan},
  booktitle={2023 IEEE International Performance, Computing, and Communications Conference (IPCCC)}, 
  title={Customized Hybrid Deep Learning Model for Road Accident Detection Based on CCTV Images}, 
  year={2023},
  volume={},
  number={},
  pages={447-452},
  abstract={Road accidents have increased with the increase in the vehicle population. There are several studies and research that focus on detecting road accidents. High-performance traffic accident detection systems are becoming ever more necessary because of the rise in traffic accidents. A vehicle accident detection system is developed in this study using the deep learning technique. A customized convolutional neural network is used for this study. The model uses pre-trained customized convolutional models for feature extractions from the images. In this research work a customized base model along with six custom hybrid models such as DenseNet-121, InceptionV3, Xception, MobileNetV2, VGG16 and ResNet-50 is used. The hybridized models use a standalone feature extractor module which uses transfer learning technique for feature extraction. The features from all the training images are extracted using the above six hybrid models. The selected features are then input to the customized base Deep Neural Network architecture. The model is tested using random Google images after being trained on a custom dataset. The performance of all the models were tested using the parameters Precision, Recall, Specificity, F1 Score along with Accuracy. It was found that the custom hybridized Resnet-50 showed the maximum performance compared with the other models in terms of accuracy.},
  keywords={Deep learning;Training;Road accidents;Computational modeling;Transfer learning;Sociology;Feature extraction;DNN;DenseNet-121;InceptionV3;Xception;MobileNetV2;VGG16;ResNet-50},
  doi={10.1109/IPCCC59175.2023.10253870},
  ISSN={2374-9628},
  month={Nov},}@INPROCEEDINGS{11428509,
  author={Alperen Kose, Nuri and Zhou, Bing},
  booktitle={2025 International Conference on Intelligent Computing, Communication, Networking and Services (ICCNS)}, 
  title={Evaluating Traffic Anomaly Detection Performance Using GAN-Generated Synthetic Records}, 
  year={2025},
  volume={},
  number={},
  pages={170-177},
  abstract={Smart transportation systems depend on real-time traffic data to ensure safe and efficient mobility. However, this dependency also introduces vulnerabilities to data manipulation, such as false congestion reports. Such threats can mislead routing systems, hinder emergency response, and degrade overall traffic flow. This study explores a machine learning-based approach to traffic anomaly detection by integrating real-world traffic data from the Texas Department of Transportation (TxDoT) with synthetic anomalies generated using a Generative Adversarial Network (GAN). Two labeling strategies are applied, original (threshold-based) and refined (context-aware), to classify traffic patterns and evaluate their impact on model performance. Experimental results show that the inclusion of GAN-generated data improves anomaly recall while preserving high accuracy. Classifiers such as XGBoost and Random Forest demonstrate improved detection performance, achieving up to 75% recall in detecting adversarial traffic records when using refined labeling and synthetic data augmentation. These results underscore the potential of GAN-enhanced training to improve anomaly detection in traffic monitoring systems.},
  keywords={Accuracy;Traffic control;Generative adversarial networks;Real-time systems;Smart transportation;Labeling;Anomaly detection;Monitoring;Random forests;Synthetic data;Traffic Anomaly Detection;Generative Adversarial Networks;Smart Transportation;Synthetic Data Generation},
  doi={10.1109/ICCNS66249.2025.11428509},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10422052,
  author={Atilgan, Irem and Turkmen, H. Irem and Guvensan, M. Amac},
  booktitle={2023 IEEE 26th International Conference on Intelligent Transportation Systems (ITSC)}, 
  title={Towards Accurate Traffic Accident Detection: Developing Deep Learning Strategies with Distant Past, Recent Past, and Adjacency Features}, 
  year={2023},
  volume={},
  number={},
  pages={6120-6125},
  abstract={Traffic accidents across the world can cause great loss of human life and create financial burden on institutions. However, early detection of accidents and timely delivery of necessary assistance can greatly reduce the likelihood and period of these negative effects occurring. The aim of this study is to minimize the negative effects of traffic accidents on human life, environmental health and macroeconomics on the long run. The paper introduces a novel input set derived from distant and near past to detect traffic accidents with a delay of 5–30 minutes while informing authorities and citizens. Further-more, the study presents statistical methods and windowing techniques to pre-process and transform the traffic speed data into various features, which are then fed into the most preferred deep learning architectures for multivariate time-series data such as Multi-Layer Perceptron (MLP), Convolutional Neural Networks (CNN), and Long Short-Term Memory (LSTM) to detect accidents in traffic. In order to verify our strategy, we ran our tests on the traffic accident dataset obtained from the 100 main road segments in Istanbul during 2018. With a 15-minute detection delay, CNN-based accident detection model outperformed all other candidate models, while generating an F-Score of 0.75 and an AUC of 0.87. The results indicates that, although there is still a gap for an improvement, pre-eliminary results are promising for determining anomaly in traffic, i.e traffic accidents, exploiting only traffic speed info.},
  keywords={Statistical analysis;Roads;Transforms;Feature extraction;Delays;Convolutional neural networks;Accidents;lndex Terms-traftic accidents;anomaly detection;convolutional neural networks;multi layer perceptron;long short term memory},
  doi={10.1109/ITSC57777.2023.10422052},
  ISSN={2153-0017},
  month={Sep.},}@INPROCEEDINGS{10500288,
  author={Adewopo, Victor and Elsayed, Nelly and Elsayed, Zag and Ozer, Murat and Zekios, Constantinos L. and Abdelgawad, Ahmed and Bayoumi, Magdy},
  booktitle={SoutheastCon 2024}, 
  title={Big Data and Deep Learning in Smart Cities: A Comprehensive Dataset for AI-Driven Traffic Accident Detection and Computer Vision Systems}, 
  year={2024},
  volume={},
  number={},
  pages={675-680},
  abstract={In the dynamic urban landscape, where interplay of vehicles and pedestrians defines the rhythm of life, integrating advanced technology for safety and efficiency is increasingly crucial. This study delves into the application of cutting-edge technological methods in smart cities, focusing on enhancing public safety through improved traffic accident detection. Action recognition plays a pivotal role in interpreting visual data and tracking object motion such as human pose estimation in video sequences. The challenges of action recognition include variability in rapid actions, limited dataset, and environmental factors such as (Weather, Illumination, and Occlusions). In this paper, we present a novel comprehensive dataset for traffic accident detection. This dataset is specifically designed to bolster computer vision and action recognition systems in predicting and detecting road traffic accidents. We integrated datasets from wide variety of data sources, road networks, weather conditions, and regions across the globe. This approach is underpinned by empirical studies, aiming to contribute to the discourse on how technology can enhance the quality of life in densely populated areas. This research aims to bridge existing research gaps by introducing benchmark datasets that leverage state-of-the-art algorithms tailored for traffic accident detection in smart cities. These dataset is expected to advance academic research and also enhance real-time accident detection applications, contributing significantly to the evolution of smart urban environments. Our study marks a pivotal step towards safer, more efficient smart cities, harnessing the power of AI and machine learning to transform urban living.},
  keywords={Computer vision;Visualization;Smart cities;Tracking;Video sequences;Transportation;Transforms;Traffic Surveillance;Accident Detection;Action Recognition;Smart City;Autonomous Transportation},
  doi={10.1109/SoutheastCon52093.2024.10500288},
