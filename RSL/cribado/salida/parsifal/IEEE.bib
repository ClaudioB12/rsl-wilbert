@inproceedings{R0492,
  title = {FA-cGAN: Feature-Aware Conditional Generated Adversarial Networks for Enhance Network Traffic Anomaly Detection},
  author = {Zhang, Jinming},
  year = {2025},
  booktitle = {2025 5th International Conference on Mobile Networks and Wireless Communications (ICMNWC)},
  doi = {10.1109/ICMNWC66779.2025.11354213},
  abstract = {In recent years, intelligent network traffic anomaly detection has become an essential for mitigating cyber threats and ensuring reliable communication in modern networks. Detection of network traffic anomaly remains challenging due to dynamic traffic patterns and diverse device types. Existing Deep Learning (DL) methods are used for network traffic anomaly detection. However, the models fail to capture complex spatio-temporal dependencies in traffic. To address these issues, this paper proposes a Feature-Aware Conditional Generated Adversarial Networks (FA-cGAN) to detect difference types of network traffic anomaly detection. The FA-cGAN model integrates feature-aware component uses spatial and temporal features enabling the model to learn sequence dependencies and complex features. The proposed FAcGAN model obtained 98.25% accuracy on CICIDS 2017 dataset and 98.12% on UNSW-NB15 dataset when compared to traditional models. The result shows effectiveness of FA-cGAN as reliable model for different types of network traffic anomaly detection.},
  keywords = {Deep learning;Wireless communication;Intelligent networks;Accuracy;Telecommunication traffic;Traffic control;Feature extraction;Robustness;Data models;Anomaly detection;deep learning;feature-aware conditional;generated adversarial networks;spatial feature;temporal feature},
