@inproceedings{R0337,
  title = {DeepFlow: Abnormal Traffic Flow Detection Using Siamese Networks},
  author = {Sabour, Sepehr and Rao, Sanjeev and Ghaderi, Majid},
  year = {2021},
  booktitle = {2021 IEEE International Smart Cities Conference (ISC2)},
  doi = {10.1109/ISC253183.2021.9562915},
  abstract = {Nowadays, many cities are equipped with surveillance systems and traffic control centers to monitor vehicular traffic for road safety and efficiency. The monitoring process is mostly done manually which is inefficient and expensive. In recent years, several data-driven solutions have been proposed in the literature to automatically analyze traffic flow data using machine learning techniques. However, existing solutions require large and comprehensive datasets for training which are not readily available, thus limiting their application. In this paper, we develop a traffic anomaly detection system, referred to as DeepFlow, based on Siamese neural networks, which are suitable in scenarios where only small datasets are available for training. Our model can detect abnormal traffic flows by analyzing the trajectory data collected from the vehicles in a fleet. To evaluate DeepFlow, we use realistic vehicular traffic simulations in SUMO. Our results show that DeepFlow detects abnormal traffic patterns with an F1 score of 78%, while outperforming other existing approaches including: Dynamic Time Warping (DTW), Global Alignment Kernels (GAK), and iForest.},
  keywords = {Training;Smart cities;Shape;Surveillance;Neural networks;Machine learning;Traffic control},
  note = {ID cribado R0337; bases: IEEE Xplore},
}

@article{R0340,
  title = {Deep Learning-Based Autonomous Anomaly Detection for Security in SDN-IoT Networks},
  author = {Lakshan Yasarathna, Tharindu and Liyanage, Madhusanka and Le-Khac, Nhien-An},
  year = {2025},
  journal = {IEEE Open Journal of the Communications Society},
  doi = {10.1109/OJCOMS.2025.3610365},
  abstract = {Converging Software-Defined Networking (SDN) and the Internet of Things (IoT) has directed innovative network architectures and applications. However, this fusion exposes security vulnerabilities due to SDN-IoT networks’ expanded attack surface and dynamic nature. Autonomous Anomaly Detection (AAD) plays a pivotal role in swiftly identifying and mitigating real-time security threats in this landscape. This survey thoroughly investigates AAD approaches within SDN-IoT networks, with a particular focus on applying advanced Deep Learning (DL) techniques. It explores the significance of SDN-IoT architecture, articulates the motivations driving AAD, and highlights its critical role in ensuring the availability, confidentiality, authentication, integrity, and authorization of networked resources. Furthermore, it defines the threat vectors across different layers of SDN-IoT, facilitating a comprehensive validation of existing attack and defence approaches. The paper provides an extensive review of DL-based AAD methods in SDN-IoT networks, examining their strengths, limitations, and practical implications. Notable contributions include an in-depth taxonomy of DL models—such as CNNs, RNNs, LSTMs, and autoencoders—designed to detect and mitigate various security threats, including DDoS attacks, data breaches, and abnormal traffic patterns. The performance of these techniques is evaluated using measures like accuracy, recall, and F1-score, with some methods achieving detection accuracy exceeding 99%. Additionally, this survey identifies key challenges in implementing AAD systems, such as scalability, real-time processing, and integration within resource-constrained IoT environments, while proposing future research directions to address these issues. In conclusion, this comprehensive survey summarizes the multifaceted landscape of DL-based AAD for Security in SDN-IoT Networks, providing a foundation for further exploration and innovation that can advance security within the evolving realm of interconnected networks.},
  keywords = {Security;Internet of Things;Anomaly detection;Deep learning;Accuracy;Real-time systems;Intrusion detection;Surveys;Data models;Computer crime;Autonomous anomaly detection;deep learning;SDN;IoT;SDN-IoT;security;threats},
  note = {ID cribado R0340; bases: IEEE Xplore},
}

@inproceedings{R0345,
  title = {Deep Learning-based Slow DDoS Attack Detection in SDN-based Networks},
  author = {Nugraha, Beny and Murthy, Rathan Narasimha},
  year = {2020},
  booktitle = {2020 IEEE Conference on Network Function Virtualization and Software Defined Networks (NFV-SDN)},
  doi = {10.1109/NFV-SDN50289.2020.9289894},
  abstract = {Software-Defined Networking (SDN) is a promising networking paradigm that provides outstanding manageability, scalability, controllability, and flexibility. Despite having such promising features, SDN is not intrinsically secure. For instance, it still suffers from Denial of Service (DDoS) attacks, which is one of the major threats that compromise the availability of the network. One type of DDoS attacks, that is considered as one of the most challenging to be detected, are slow DDoS attacks. In recent years, deep learning algorithms have been applied for reliable and highly accurate traffic anomaly detection. Therefore, in this paper, we propose the use of a hybrid Convolutional Neural Network-Long-Short Term Memory (CNN-LSTM) model to detect slow DDoS attacks in SDN-based networks. The performance of this method is evaluated based on custom datasets. The obtained results are quite impressive - all considered performance metrics are above 99%. Our hybrid CNN-LSTM model also outperforms other deep learning models like MultiLayer Perceptron (MLP) and standard machine learning models like l-Class Support Vector Machines (l-Class SVM).},
  keywords = {Support vector machines;Deep learning;Measurement;Scalability;Denial-of-service attack;Software defined networking;Standards;Slow DDoS Attack;Software-Defined Networking;Deep Learning;Performance Evaluation;Supervised Learning},
  note = {ID cribado R0345; bases: IEEE Xplore},
}

@inproceedings{R0368,
  title = {Design of Highway Tunnel Monitoring System},
  author = {Chen, Li and Liang, Yue and Zhang, Zilei},
  year = {2025},
  booktitle = {2025 IEEE 7th Advanced Information Management, Communicates, Electronic and Automation Control Conference (IMCEC)},
  doi = {10.1109/IMCEC66174.2025.11331897},
  abstract = {Once a traffic accident occurs on the highway, it will seriously endanger people's travel safety. With the construction of information monitoring systems, most highways have deployed video surveillance systems. However, detecting anomalies or emergencies through traditional “human eye watching videos” results in human visual fatigue and many safety blind spots, making it difficult to detect and handle them in real time. This article takes highway tunnels as the research object, and combines fiber optic sensing technology, image recognition processing technology, laser radar detection technology, network transmission technology and other technologies to report real-time foreign objects, traffic flow conditions, and environmental conditions thrown in the tunnel to relevant duty personnel, providing intuitive and accurate basis for accident decision-making, solving various abnormal events in the first time, and proposing a comprehensive solution for abnormal traffic events and fire monitoring in the tunnel.},
  keywords = {Road transportation;Visualization;Image recognition;Video surveillance;Real-time systems;Safety;Sensors;Monitoring;Accidents;Videos;Abnormal traffic monitoring;Fire monitoring;Radar;Image recognition},
  note = {ID cribado R0368; bases: IEEE Xplore},
}

@inproceedings{R0374,
  title = {Detecting Anomalous IoT Traffic Flow with Locality Sensitive Hashes},
  author = {Charyyev, Batyr and Gunes, Mehmet Hadi},
  year = {2020},
  booktitle = {GLOBECOM 2020 - 2020 IEEE Global Communications Conference},
  doi = {10.1109/GLOBECOM42002.2020.9322559},
  abstract = {Widespread adoption of Internet of Things (IoT) devices increased the variety of devices connected to a network. These devices have become a primary target of cyber-attacks as they introduce unmanaged vulnerabilities into the network. On the other hand, most of the IoT devices have a limited set of functionalities. Thus, it is possible to formulate the expected traffic pattern of the device and employ the network traffic to detect anomalous activities. Existing IoT traffic anomaly detection systems require tuning the parameters of machine learning algorithms used for the traffic classification. In this paper, we introduce a novel approach to detect the anomalous IoT network traffic based on the locality-sensitive hash of the traffic flow. The proposed Locality Sensitive Anomaly Detection (LSAD) approach does not require feature extraction from the data. Evaluation on a dataset with fifteen attacks shows that it can detect anomalous flows with an accuracy above 97% and achieve the same or better performance than machine learning approaches.},
  keywords = {Feature extraction;Multiuser detection;Anomaly detection;Machine learning algorithms;Support vector machines;Tuning;Malware},
  note = {ID cribado R0374; bases: IEEE Xplore},
}

@inproceedings{R0384,
  title = {Detection of Abnormal Traffic Flow with the Hurst Parameter for Traffic Management},
  author = {Karelina, E. A. and Stepanov, A. A. and Smirnov, P. I. and Podgornuy, A. V. and Guly, V. V.},
  year = {2023},
  booktitle = {2023 Intelligent Technologies and Electronic Devices in Vehicle and Road Transport Complex (TIRVED)},
  doi = {10.1109/TIRVED58506.2023.10332752},
  abstract = {In order to further reduce emissions of particulate matter, nitrogen oxides and carbon dioxide into the atmosphere from road transport, the causes of congestion on city streets should be eliminated. The movement of transport in urban conditions is quite cyclical, however, in the conditions of each city it has its own specifics. The use of adaptive traffic light control systems within the framework of intelligent transport systems (ITS) contributes to solving this problem. However, there is a need not only to directly respond to traffic jams and reduce the speed of vehicles, but also to predict these situations in advance. The article shows an example of using the normalized range method (Hurst exponent) for predictive detection of changes in traffic flow indicators on a city highway for subsequent correction of traffic lights.},
  keywords = {Adaptive systems;Roads;Urban areas;Atmosphere;Detectors;Carbon dioxide;Control systems;hurst parameter;intelligent transport systems;traffic detectors;abnormal traffic;traffic flow modeling},
  note = {ID cribado R0384; bases: IEEE Xplore},
}

@article{R0448,
  title = {Edge-Assisted Flexible Platooning of Connected and Automated Vehicles Under Traffic Anomaly},
  author = {Gao, Fengkun and Yang, Bo and Chen, Cailian and Guan, Xinping},
  year = {2025},
  journal = {IEEE Transactions on Vehicular Technology},
  doi = {10.1109/TVT.2025.3548915},
  abstract = {The platooning of connected and automated vehicles (CAVs) has the great potential to significantly improve travel experience in terms of safety, comfortableness, and energy efficiency. However, constrained by sensing range and prediction accuracy, the performance of CAV platoon can not be guaranteed in the scenario of mixed traffic consisting of CAVs and human-driven vehicles (HDVs). This is not only due to the uncertainty of HDVs but also related to the occurrence of various traffic anomalies, such as emergency braking and accidents. In this paper, we aim to investigate an efficient control strategy to guarantee the operation of the platoon in mixed traffic, especially in the case of traffic anomalies. To tackle the problem, an edge-assisted platoon control strategy, called E-CACC, is proposed. First, an error-aware flexible tracking policy is designed to adapt to HDV uncertainties and speed prediction errors. Based on the tracking policy, a zone model predictive control (ZMPC) method is then designed to guarantee travel safety and avoid undesired acceleration. Further, a coordination strategy of CAV platoon and roadside unit (RSU) is proposed to prevent the platoon from potential collision in the case of traffic anomalies, where an event-based communication trigger is designed to determine whether and when the platoon establishes communication links with RSU to acquire exogenous sensing data of anomaly segment. Finally, the evaluation results illustrate the effectiveness of the proposed method in improving travel safety and comfortableness.},
  keywords = {Vehicle-to-everything;Sensors;Safety;Topology;Accuracy;Vehicle dynamics;Trajectory;Uncertainty;Target tracking;Predictive control;Edge-assisted cooperative adaptive cruise control;mixed traffic flow;traffic anomaly;zone model predictive control},
  note = {ID cribado R0448; bases: IEEE Xplore},
}

@inproceedings{R0460,
  title = {Enhanced Real-Time Traffic Monitoring and Anomaly Detection Using YOLOv8 Segmentation in Heterogeneous Urban Environments},
  author = {Tottempudi, Srinivasa Rao and Sujatha, Gude and Ahamed, BSH. Shayeez and Mittoor, Gowthamkumar Reddy and Rao, Karanam Manohara and RamaKrishna, Boddu L V Siva},
  year = {2026},
  booktitle = {2026 7th International Conference on Mobile Computing and Sustainable Informatics (ICMCSI)},
  doi = {10.1109/ICMCSI67283.2026.11412506},
  abstract = {Efficient anomaly detection and traffic monitoring are the advance features of Intelligent Transportation Systems (ITS) while existing techniques struggle in handling hazardous scenarios in traffic. Traditional detection methods based on bounding-box approach as discussed in earlier studies, show reduced effectiveness with variable vehicle types and complex traffic patterns deployed in heterogeneous traffic environment. This paper presents an advanced framework of computer vision for real-time traffic monitoring and anomaly detection in different traffic environments. The system utilizes YOLOv8 instance segmentation models that achieves pixel-level accuracy in vehicle detection while maintaining real-time processing capabilities. Using user-defined regions of interest (ROIs) in the paradigm of road-region focused detection eliminates background interference. The proposed framework implements pixel-level vehicle segmentation and supports simultaneous vehicle counting, traffic density analysis and substantially improves accuracy in anomaly detection by eliminating background noise. The proposed system was authenticated on urban traffic datasets across all analyzed frames $(n=7)$ proving exceptional performance with consistent anomaly detection. The results displayed noteworthy enhancement in processing efficiency and detection accuracy in comparison to existing methodologies, including average occupancy percentages ranging from 63.31 % to $text7 1 %$ and maximum occupancy reaching $text9 3. 7 4 %$.},
  keywords = {Computer vision;Accuracy;Smart cities;Vehicle detection;Traffic control;Real-time systems;Anomaly detection;Monitoring;Intelligent transportation systems;Mobile computing;Intelligent Transportation Systems;Computer Vision;YOLOv8;Traffic Anomaly Detection;Smart Cities;Real-time Processing},
  note = {ID cribado R0460; bases: IEEE Xplore},
}

@inproceedings{R0472,
  title = {Enhancing Traffic Incident Detection Through ADASYN-Attention Fusion: A Comparative Study with RITIS Data},
  author = {Liu, Ruifeng and Xie, Yuanchang and Stamatiadis, Polichronis and Gartner, Nathan and Ge, Tingjian},
  year = {2024},
  booktitle = {2024 IEEE 27th International Conference on Intelligent Transportation Systems (ITSC)},
  doi = {10.1109/ITSC58415.2024.10919901},
  abstract = {Traffic incidents are a leading contributor to non-recurring congestion and secondary crashes. Each year congestion and crashes together cost the United States over 1 trillion dollars. Once traffic queues are formed, it is difficult to dissipate them and return traffic to normal operations. Therefore, real-time and accurate incident detection plays a critical role in Traffic Incident Management (TIM). This research focuses on highway traffic incident detection. It divides a highway network into short segments and correlates temporal and spatial data from adjacent segments for detecting incidents. Due to incidents being relatively rare compared to normal traffic patterns, we propose a method that combines oversampling with the attention mechanism and use an ablation study to prove its effectiveness in improving supervised incident detection.},
  keywords = {Road transportation;Attention mechanisms;Costs;Accuracy;Traffic control;Computer crashes;Spatial databases;Real-time systems;Detection algorithms;Intelligent transportation systems},
