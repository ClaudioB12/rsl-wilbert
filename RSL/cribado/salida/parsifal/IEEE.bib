@inproceedings{R0005,
  title = {A Blockchain-Assisted AI-Based Network Security Framework for Secure Communication in Intelligent Transportation and Vehicular Networks},
  author = {Kumar, Aryan and Thakur, Aditya Kumar and Singh, Abhinav and Patel, Aryan},
  year = {2026},
  booktitle = {2026 Fourth International Conference on Secure Cyber Computing and Communications (ICSCCC)},
  doi = {10.1109/ICSCCC69031.2026.11600095},
  abstract = {The intelligent transportation systems and vehicular ad hoc networks have brought major security and trust issues with high mobility, decentralized communication, and bulk exchange of data. In a bid to solve these problems, this paper introduces a blockchain-enabled AI-based framework of network security in smart transportation and vehicle networks to ensure a secure communication. The framework proposed combines intrusion detection with artificial intelligence and trust management based on blockchain in order to guarantee data integrity, authentication, and resistance to attacks in vehicle-to-vehicle communications. There is the use of machine learning and deep learning methods to detect malicious activities, abnormal traffic behavior, and network intrusion in real time, and the use of blockchain technology is a system of decentralized and indisputable safety that performs the validation of messages and control of the trust score. The system model and threat analysis are also provided in detail to show the strength of the proposed approach. One of the results of simulation shows that the accuracy of detection is significantly improved, the communication latency is decreased, and the network reliability is also increased in comparison with the current security mechanisms. The suggested framework provides a scalable and security solution to the intelligent transportation systems of the next generation, which will help provide safer, trustable, and resilient car communications.},
  keywords = {Modeling;Vehicles;Timing;Clouds;Internet of Vehicles;Equations;Artificial intelligence;Delays;Manuals;Optimization;Blockchain;Artificial Intelligence;Vehicular Networks;Network Security;Intelligent Transportation Systems},
  note = {ID cribado R0005; bases: IEEE Xplore},
}

@inproceedings{R0019,
  title = {Abnormal flow detection using Optimized ABFlow Network in SDN based Smart Grid Application},
  author = {B, Prasath and P, Deepa and K, Kalaivani and A, Wasim Raja and S, Gokila and V, Narasimharaj},
  year = {2022},
  booktitle = {2022 Third International Conference on Smart Technologies in Computing, Electrical and Electronics (ICSTCEE)},
  doi = {10.1109/ICSTCEE56972.2022.10100108},
  abstract = {SDN can help the power communication network function more efficiently and conform to the Smart Grid's need for centralised control. There are a variety of network attacks that might be launched against the SDN controller. A significant danger to the data integrity of smart grids is posed by malicious software, which often use encryption or tunnelling techniques to get beyond firewalls, intrusion detection systems, and other protective measures. For the safety and reliability of the Smart Grid, it is crucial that irregular flow be detected accurately. Conventional machine learning techniques, such as and the Naive Bayes classifier, were the basis of earlier efforts. Low accuracy for huge, high-dimensional network flows are a result of their simplistic, surface-level feature learning. In this study, we create a system for detecting anomalous flows, called ABFlow, using Optimized Siamese neural networks. These networks operate well when only little data is provided for training. By examining the trajectory data with several parameter measurements, the model may identify irregular traffic flows. The suggested strategy is then tested on the DDoS-SDN and InSDN datasets to determine how well it performs. The experimental findings prove that the ABFlow can effectively identify anomalous flow in the SDN-based Smart Grid, greatly outperforming existing tactics in terms of accuracy and FPR.},
  keywords = {Training;Solid modeling;Computer architecture;Tunneling;Data models;Smart grids;Trajectory;Software-Defined Network;Optimized Siamese neural networks;Abnormal Traffic Flow Detection;Smart Grid application},
  note = {ID cribado R0019; bases: IEEE Xplore},
}

@inproceedings{R0022,
  title = {Abnormal Traffic Detection in Data Mining Techniques using Scaled Exponential Linear Unit based Deep Autoencoders},
  author = {Guo, Yunying and Li, Xiaofei},
  year = {2024},
  booktitle = {2024 Second International Conference on Data Science and Information System (ICDSIS)},
  doi = {10.1109/ICDSIS61070.2024.10594262},
  abstract = {With the advanced development of data mining techniques, the abnormal traffic detection is becoming simple and easy to acquire. The existing approaches are complex to estimate the time series data in parallel as well as vanishing or gradient explosion problems are most often occurring. Hence, this research proposes the Scaled Exponential Linear Unit based Deep Autoencoders (SELU-DAE) approach for the abnormal traffic detection according to the data mining techniques. Initially, this research collects the two public data sets such as NSL-KDD and UNSW-NB15 for the estimation of model performance. Then, the Min-Max normalization technique is utilized to equally scale the input features and then, the Principal Component Analysis (PCA) technique is utilized to select the significant features in the features selection process. Finally, the SELU-DAE approach is utilized for the detection process. The experimental results show the proposed SELUDAE attains better accuracy of 98.43% and 99.31% on NSLKDD and UNSW-NB15 dataset when compared to the existing methods like Deep Convolution Neural Network (DCNN) and Bidirectional Independent Recurrent Neural Network (BiIndRNN).},
  keywords = {Accuracy;Sensitivity;Recurrent neural networks;Time series analysis;NSL-KDD;Data mining;Security;abnormal traffic detection;data mining;principal component analysis;scaled exponential linear unit based deep autoencoders and vanishing problem},
  note = {ID cribado R0022; bases: IEEE Xplore},
}

@inproceedings{R0036,
  title = {A Computational Data Science Based Detection of Road Traffic Anomalies},
  author = {Murali Krishna, Chinta Venkata and Gopala Krishna, G and Vellela, Sai Srinivas and Venkateswara Rao, M and Sivannarayana, Garikipati and Javvadi, Sravanthi},
  year = {2023},
  booktitle = {2023 Global Conference on Information Technologies and Communications (GCITC)},
  doi = {10.1109/GCITC60406.2023.10425875},
  abstract = {An essential component of an Intelligent Transportation System (ITS) is anomaly detection. There is an increasing need for the identification of unusual occurrences in the traffic network due to the yearly growth in vehicle usage and the continual improvement of the traffic networking. Traffic anomaly detection provides sufficient decision-supporting information for road network operators, users, and other stakeholders. It is difficult to find anomalies in large-scale multivariate road traffic data. By bridging the gap between automated and manual traffic analysis methods, visual analytics helps increase process transparency. New rapid and effective processing tools and methodologies are required to swiftly extract and analyze data from the enormous volume of data. Data science approaches can be used to research and pinpoint various kinds of severe attacks and anomalies. Hence, Computational Data Science based detection of road traffic Anomalies is presented in this analysis. Thecomputational data science techniques (CDS) are needed to manage vast volumes of traffic data in a wide range of forms. Finding abnormalities in traffic data that impact traffic efficiency produced the development of computational data science.The primary advantage of the CDS approach is the early identification of data anomaly sources to avoid traffic congestion over a long-term.},
  keywords = {Roads;Visual analytics;Urban areas;Transportation;Data science;Road traffic;Anomaly detection;Anomaly Detection;Intelligent Transportation Systems (ITS);Computational Data Science},
  note = {ID cribado R0036; bases: IEEE Xplore},
}

@inproceedings{R0076,
  title = {Aggressive Behavior Detection Based on Driver Heart Rate and Hand Movement Data},
  author = {Lashkov, I. and Kashevnik, A.},
  year = {2021},
  booktitle = {2021 IEEE International Intelligent Transportation Systems Conference (ITSC)},
  doi = {10.1109/ITSC48978.2021.9564478},
  abstract = {In this paper, a novel algorithm is proposed for monitoring driver behavior in the vehicle cabin and evaluating the situations whether the driver operates a vehicle in a normal or aggressive manner. In case we detected dangerous driving behavior, the feedback in a form of audible signals and recommendations is provided for the driver intended to reduce the road accident occurrence, or eliminate it at all. We essentially utilize data extracted from the heart rate monitor, and accelerometer integrated inside the wearable electronic device, as well as motion sensors inside the smartphone, to process and obtain information about the driver's heart rate, steering wheel movements, and vehicle movement. This work is mainly concentrated on driving style classification, assigning each driver a severeness level of aggressive style, describing how unsafe the driving is committed. This classification may potentially aid to determine aggressive vehicle drivers on public roads, and, therefore, undertake actions to reduce the risk of traffic accident occurrence. Validation results show that the proposed approach is effective for identifying driving aggressiveness with aid of the dataset collected in natural driving conditions.},
  keywords = {Heart rate;Roads;Wearable computers;Wheels;Feature extraction;Data models;Classification algorithms},
  note = {ID cribado R0076; bases: IEEE Xplore},
}

@inproceedings{R0083,
  title = {AI City Challenge 2020 – Computer Vision for Smart Transportation Applications},
  author = {Chang, Ming-Ching and Chiang, Chen-Kuo and Tsai, Chun-Ming and Chang, Yun-Kai and Chiang, Hsuan-Lun and Wang, Yu-An and Chang, Shih-Ya and Li, Yun-Lun and Tsai, Ming-Shuin and Tseng, Hung-Yu},
  year = {2020},
  booktitle = {2020 IEEE/CVF Conference on Computer Vision and Pattern Recognition Workshops (CVPRW)},
  doi = {10.1109/CVPRW50498.2020.00318},
  abstract = {We present methods developed in our participation of the AI City 2020 Challenge (AIC20) and report evaluation results in this contest. With the blooming of AI computer vision techniques, vehicle detection, tracking, identification, and counting all have advanced significantly. However, whether these technologies are ready for real-world smart transportation usage is still a open question. The goal of this work is to apply and integrate state-of-the-art techniques for solving the challenge problems under a standardized setup and evaluation. We participated all 4 AIC20 challenge tracks (T1 to T4). In T1 challenge, we perform vehicle counting by associating deep features extracted from Mask-RCNN detections and tracklets, followed by vehicle movement zone matching. In T2 challenge, we perform vehicle type and color classification and then rank matching vehicles using a PGAM re-id network. In T3 challenge, we proposed a new Multi-Camera Tracking Network (MTCN) that takes single-camera vehicle tracking as input, and performs multi-camera tracklet fusion and linking, by jointly optimizing the matching of vehicle appearance and physical features. In T4 challenge, we adopt a leading method based on perspective detection and spatial-temporal matrix discriminating, and improve it with background modeling for traffic anomaly detection. We achieved top-6 and top-4 performance for T3 and T4 challenges respectively in the AIC20 general leaderboard.},
  keywords = {Tracking;Cameras;Feature extraction;Artificial intelligence;Vehicle detection;Trajectory;Urban areas},
  note = {ID cribado R0083; bases: IEEE Xplore},
}

@inproceedings{R0086,
  title = {AI-Powered Traffic Solutions for Preventing and Detecting Incidents for Safer Roads},
  author = {S, Muhammad Bilal and A, Sathiya and K, Kaviya Sanjay and Ganesan J, Jeya and K, Hari S},
  year = {2024},
  booktitle = {2024 International Conference on Power, Energy, Control and Transmission Systems (ICPECTS)},
  doi = {10.1109/ICPECTS62210.2024.10780273},
  abstract = {The demand for creative solutions to handle traffic incidents and speed up emergency response times is higher than ever at a time when road safety is of the utmost importance. Conventional traffic control systems frequently rely on manual reporting, which causes inefficiencies and delays that can worsen traffic risks and jeopardize safety. To close this gap, we suggest a real-time system that combines cameras, sensors, and artificial intelligence (AI) algorithms to transform traffic incident detection and response. This state-of-the-art system instantly notifies emergency services of traffic events in real-time, automating the process of improving road safety and streamlining emergency response procedures. Through the elimination of human reporting delays, this technology fixes existing inefficiencies and enhances traffic management as a whole. The technology foundation consists of smartphone applications for real-time updates, AI-driven incident detection, continuous monitoring, and linked car technologies. To reduce dangers related to driver weariness and stress and to provide early warnings, this system also includes driver stress level detection using computer vision. In the end, this system hopes to establish a new benchmark for proactive incident avoidance and traffic management, encouraging safer driving behaviors and more effective emergency response.},
  keywords = {Traffic control;Emergency services;Road safety;Real-time systems;Delays;Automobiles;Time factors;Artificial intelligence;Stress;Vehicles;Traffic Incidents;Emergency Response;Real-Time System;Artificial Intelligence (AI);Incident Detection;Automated Notifications;Cameras;Sensors;Driver Stress Detection;Computer Vision;Traffic Management},
  note = {ID cribado R0086; bases: IEEE Xplore},
}

@inproceedings{R0105,
  title = {A Multi-Views Network for Anomalous UAV Agent Trajectory Detection},
  author = {Liu, Dong and Liu, Zhikai and Wang, Xuefei and Zhang, Keli and Guo, Bin and Yang, Yingduo and Fan, Chunlong and Zhou, Qiaoli},
  year = {2024},
  booktitle = {2024 15th International Conference on Reliability, Maintenance and Safety (ICRMS)},
  doi = {10.1109/ICRMS63553.2024.00173},
  abstract = {Identifying anomalous flight trajectories of unmanned aerial vehicle (UAV) is crucial in airspace operations, as it can protect UAV from potential safety risks. Meanwhile, it is an important means of monitoring the health of UAV agent. Despite significant progress in this area, many existing methods fail to account for the dynamic interaction of trajectory features. This paper introduces a novel network for anomaly detection of UAV trajectories using a multi-views analysis approach. Firstly, Three-view data is sent to the network, including plane cruises data, take-off context, and geographical context. Secondly, by combining the U-net with multi-head attention mechanisms, the network can effectively integrate and analyze data from multi-views data. This not only enhances the dynamic interactivity of features but also enables precise detection of UAV trajectory anomalies. Finally, we conducted experiments on the Automatic Dependent Surveillance-Broadcast (ADS-B) dataset to validate the effectiveness of this method. Experimental results show ADS-B spoofing attack can be detected through monitoring UAV trajectory anomalies. Our approach of anomalous trajectory detection can detect spoofing attacks with a success rate of 96.7%.},
  keywords = {Attention mechanisms;High dimensional data;Autonomous aerial vehicles;Feature extraction;Trajectory;Safety;Maintenance;Vehicle dynamics;Monitoring;Anomaly detection;UAV agent;anomaly trajectories detection;multi-views network;monitoring health},
  note = {ID cribado R0105; bases: IEEE Xplore},
}

@article{R0165,
  title = {An Urban Traffic Prediction Method With Environmental Anomaly Awareness and Multi-Level Context Learning},
  author = {Zhu, Guodong and Du, Bo and Niu, Yunyun},
  year = {2026},
  journal = {IEEE Transactions on Mobile Computing},
  doi = {10.1109/TMC.2026.3731506},
  abstract = {Urban traffic prediction is an important topic in mobile computing, and traffic data collected by mobile sensors are often affected by environmental factors. However, existing forecasting paradigms usually ignore environmental factors or treat them only as coarse-grained auxiliary information, lacking dedicated modeling of their heterogeneous impacts. Based on stability, environmental factors are categorized into time-sensitive and space-specific factors. Anomalies in time-sensitive factors are prone to causing traffic anomalies, but their impacts are difficult to capture due to sparse samples and the spatiotemporal heterogeneity of their effects on traffic. Space-specific factors are relatively stable, yet their impacts are multi-level, a characteristic often overlooked by existing methods. To address these issues, this paper proposes an Environment-Guided Spatio-Temporal Network (EGSTN). It introduces a Variational Anomaly-Enhanced Module to enhance the learning of evolution patterns of sparse environment-associated traffic anomalies. Meanwhile, a Multi-Level Context Learning Layer is designed to capture the multi-level impacts of space-specific factors while preserving graph topology. Finally, environmental representations are integrated with traffic features to model environment-associated spatiotemporal dependencies. Extensive experiments on six real-world traffic datasets demonstrate that EGSTN outperforms state-of-the-art baselines and exhibits strong robustness under extreme environmental conditions and noise interference.},
  keywords = {Modeling;Forecasting;Learning (artificial intelligence);Timing;Roads;Convolution;Matrices;Environmental factors;Modules (abstract algebra);Context;Environmental factors;mobility computing;mobility traffic forecasting},
  note = {ID cribado R0165; bases: IEEE Xplore},
}

@inproceedings{R0207,
  title = {A Survey of Recent Advances in Driving Behavior Analysis},
  author = {Liu, Jing and Liu, Yang and Tian, Chengwen and Wei, Donglai and Zhao, Mengyang and Ni, Wei and Zeng, Xinhua and Song, Liang},
  year = {2021},
  booktitle = {2021 3rd International Symposium on Smart and Healthy Cities (ISHC)},
  doi = {10.1109/ISHC54333.2021.00035},
  abstract = {Understanding driving behavior has never been more important to intelligent transportation. It has a significant impact on the advancement of safe and sociable autonomous vehicles. With the advent of smartphones and intelligent connected vehicles, portable data acquisition and efficient driving data processing are enabled, providing unprecedented potential for comprehensive driving behavior analysis (DBA). This research benefits many industries, such as vehicle energy management, autonomous driving systems, advanced driver assistance systems, intelligent traffic systems, and environmental protection. In this study, we conduct a comprehensive literature investigation of the dataset and DBA model. The dataset is reviewed based on available datasets, and we also outline the evaluation metrics of the DBA model. We provide an overview of the DBA model separately, briefly discuss five DBA tasks, and focus on reviewing the smartphone-based DBA model. In addition, we analyze the key research challenges and prospects for future work, hoping to provide guidelines for related researchers.},
  keywords = {Measurement;Soft sensors;Urban areas;Transportation;Behavioral sciences;Vehicle dynamics;Energy management;Driving behavior analysis;survey;abnormal driving detection;driving style detection;drowsiness detection;distraction detection},
  note = {ID cribado R0207; bases: IEEE Xplore},
}

@article{R0237,
  title = {Automated Traffic Incident Detection: Coping With Imbalanced and Small Datasets},
  author = {Xie, Tian and Shang, Qiang and Yu, Yang},
  year = {2022},
  journal = {IEEE Access},
  doi = {10.1109/ACCESS.2022.3161835},
  abstract = {Automatic incident detection (AID) has always been one of the focus issues in the field of transportation. However, due to the contingency and randomness of traffic incident, traffic incident samples are scarce and far less than non-incident samples. Therefore, unlike other scenarios using large-scale deep networks, traffic incident detection tackle at small and imbalanced sample size. Imbalanced, small sample data sets, inappropriate and incomplete initial variable sets make the AID model insensitive to incident samples, resulting in unsatisfactory model performance (low detection rate or high false alarm rate). Therefore, a hybrid AID method (SASYNO-RF-RSKNN) is proposed using self-adaptive synthetic over-sampling, random forest and random subspace k nearest neighbor. First, the spatial-temporal and real-time characteristics of traffic stream are used for the selection of appropriate initial variables to construct a relatively complete set of initial variables. Second, the SASYNO oversampling method is used to expand the original imbalanced sample database, so that the number of minority class samples is consistent with the number of most class samples. Then, feature variables are selected from the initial variables using the RF algorithm. Finally, the RSKNN ensemble algorithm with feature variables as input is employed to detect traffic incident. In addition, six indexes are used to evaluate model performance, including accuracy (ACC), false alarm rate (FAR), detection rate (DR), precision, Matthews correlation coefficient (MCC) and F1-score. Simultaneously, we also designed horizontal and vertical contrast experiments, and the experimental results show that SASYNO-RF-RSKNN model has superior performance. It is worth mentioning that experiments are implemented on two real-world datasets. Most indexes of the proposed model are the best compared with other five excellent machine learning algorithms. On the whole, the proposed model has a dependable and high-performance for traffic incident detection.},
  keywords = {Machine learning algorithms;Data models;Support vector machines;Adaptation models;Real-time systems;Neural networks;Classification algorithms;Traffic incident detection;ensemble-learning;spatial and temporal characteristic;SASYNO;random subspace k nearest neighbor},
  note = {ID cribado R0237; bases: IEEE Xplore},
}

