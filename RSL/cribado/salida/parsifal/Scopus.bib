  title = {Suspicious detection in road traffic based on Kd-SLIC-K-means and SBAF-CNN using aerial view surveillance video},
  author = {Patra, Raj Kumar and Bhattacharya, Saurabh and Mahmood, Md Rashid and Kar, Naresh Kumar and Dubey, Parul and Raja, Rohit and Agrawal, Sonu},
