  booktitle = {16th International Conference on Advances in Computing, Control, and Telecommunication Technologies, ACT 2025},
  abstract = {With the rapid growth of urbanization and the increasing number of vehicles on roads, real-time traffic accident detection has become a crucial component of intelligent transportation systems. This paper proposes a novel deep learning-based approach using Inflated 3D ConvNet (I3D) combined with ConvLSTM2D for efficient and accurate traffic accident detection from video streams. The I3D model extracts rich spatiotemporal features from sequential video frames, while the ConvLSTM2Dlayercapturestemporaldependenciesand motion patterns to detect anomalous events that indicate accidents. Our modelist rained and tested on bench mark traffic surveillance datasets and demonstrates superior performance in terms of accuracy, precision, and real- time responsiveness when compared to traditional CNN-LSTM architectures. The proposed system can be integrated with smart surveillance infrastructure to provide timely alerts, potentially reducing emergency response time and improving road safety. © Grenze Scientific Society, 2025.},
  keywords = {Accident prevention; Anomaly detection; Emergency services; Feature extraction; Highway accidents; Intelligent systems; Intelligent vehicle highway systems; Learning systems; Motor transportation; Roads and streets; Security systems; Smart city; Time and motion study; Traffic control; Accident detections; Accident prediction; Anomaly detection; ConvLSTM2D; Convnet; Deep learning; Features extraction; Inflated 3d convnet; Intelligent transportation systems; Real- time; Real-time accident detection; Road safety; Spatiotemporal feature; Spatiotemporal feature extraction; Surveillance video; Surveillance video analyze; Temporal analysis; Traffic monitoring; Video analysis; Video surveillance; Computer vision; Deep learning},
