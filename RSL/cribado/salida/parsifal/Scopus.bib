@inproceedings{R0318,
  title = {Dangerous Driving Behavior Detection Based on Computer Vision},
  author = {Lin, Huikai},
  year = {2025},
  booktitle = {2025 IEEE 3rd International Conference on Electrical, Automation and Computer Engineering, ICEACE 2025},
  doi = {10.1109/ICEACE67491.2025.11439288},
  abstract = {With the growing number of cars, the frequency of traffic accidents is becoming higher and higher, which greatly threaten the people's life safety. According to relevant research, the driver's non-standard driving behaviors paly the dominant role in the reasons for traffic accident. Meanwhile, with the popularization of autonomous driving technology, more and more drivers begin to use it for reducing driving fatigue. But as a result of over reliance on the autonomous driving technology, more and more traffic accidents caused by untimely takeover have appeared. Therefore, research on technologies for detecting driving behavior is of significant important. Technologies based on computer vision multi-classification models are able to detect nine main distracted behavior of drivers, which will significantly supervise dangerous driving behavior for decreasing the traffic accident rate. This study trained three different models including classical CNN model and Vision Transformer, and compare the performance of them to find the best one to detect dangerous driving behavior. Finally, the best performance is achieved by ResNet-152 model, whose accuracy reached 99.80%. © 2025 IEEE.},
  keywords = {Accident prevention; Automobile drivers; Autonomous vehicles; Behavioral research; Computer vision; Highway accidents; Vision; Autonomous driving; Behavior; Behavior detection; Dangerous drivings; Detection; Driving; Driving behaviour; Driving fatigue; Life safety; Performance; Error detection},
  note = {ID cribado R0318; bases: Scopus},
}

@article{R0319,
  title = {DANGEROUS DRIVING BEHAVIOR DETECTION IN-CAR BASED ON IMPROVED YOLOV11},
  author = {Wang, Shuo and Mai, Nghia Thi and Kamal, Md Abdus Samad and Murakami, Iwanori and Yamada, Kou},
  year = {2026},
  journal = {International Journal of Innovative Computing, Information and Control},
  doi = {10.24507/ijicic.22.04.947},
  abstract = {In recent years, intelligent driving technologies have developed rapidly, leading to an increasing demand for driving safety. However, existing algorithms generally suffer from high computational complexity and slow inference speed. To enhance the realtime detection capability of dangerous driving behaviors inside vehicles, we propose a novel algorithm based on YOLOv11, termed YOLOv11-SGCB. The proposed model integrates Ghost Convolution for lightweight feature extraction, SCConv for spatial-channel reconstruction, and CBAM for attention-guided feature refinement. Experimental results demonstrate that YOLOv11-SGCB achieves a mean Average Precision (mAP) of 93.8%, representing a 1.9% improvement over the original YOLOv11, while inference speed is increased by 23%, significantly enhancing real-time performance. Moreover, the GFLOPs are reduced to 69.1% of the original model, enabling more efficient deployment on resource-constrained mobile devices. © 2026, ICIC International. All rights reserved.},
  keywords = {Automobile drivers; Behavioral research; Computational complexity; Deep learning; Feature extraction; Inference engines; Vehicle detection; Behavior detection; Dangerous drivings; Deep learning; Detection capability; Driving behaviour; Driving safety; Novel algorithm; Real-time detection; Safe driving; YOLOv11; Image recognition},
  note = {ID cribado R0319; bases: Scopus, Web of Science},
}

@inproceedings{R0321,
  title = {Dangerous Driving Behavior Prediction Study Based on CNN-LSTM-AM and Multi-Source Feature Screening},
  author = {Wei, Mian and Wang, Yingbo and Wang, Mingze and Musa, Ahmad Tijjani and Ku, Chin Soon},
  year = {2026},
  booktitle = {Advances in Transdisciplinary Engineering},
  doi = {10.3233/ATDE260868},
  abstract = {Road traffic accidents are a global concern, and dangerous driving behavior is a major cause. Current research faces challenges in indicator selection, temporal modeling, and multimodal data fusion. To address these issues, this study proposes a comprehensive data-feature-modeling solution. Using a multi-source dataset from 40 drivers (naturalistic driving and surveys), we establish a three-dimensional indicator system (driver, vehicle, and environment). CNNs extract deep spatiotemporal features, combined with PCA and silhouette coefficient-based hierarchical clustering to classify driving behaviors into cautious and aggressive types. A gradient integration method quantifies feature contributions and identifies 14 key predictive indicators. We then develop a CNN-long short-term memory (LSTM)-attention mechanism (CNN-LSTM-AM) hierarchical model that captures local spatiotemporal features and long-term dependencies. Experimental results show that the proposed model achieves an AUC of 0.924, significantly outperforming baseline models (LSTM, RNN, MLP). This study provides an interpretable framework and an effective technical solution for the precise prediction and intervention of dangerous driving behaviors. © 2026 The Authors.},
  keywords = {Automobile drivers; Behavioral research; Convolutional neural networks; Data mining; Forecasting; Hierarchical systems; Highway accidents; Screening; Behavior prediction; Convolutional neural network; Dangerous driving behavior; Dangerous drivings; Driving behaviour; Indicators systems; Long short-term memory network; Memory network; Multi-modal; Multimodal indicator system; Short term memory; Long short-term memory},
  note = {ID cribado R0321; bases: Scopus},
}

@inproceedings{R0322,
  title = {Dangerous Driving Behavior Recognition using CA-CenterNet},
  author = {Ma, Zhe and Yang, Xiaohui and Zhang, Haoran},
  year = {2021},
  booktitle = {2021 IEEE 2nd International Conference on Big Data, Artificial Intelligence and Internet of Things Engineering, ICBAIE 2021},
  doi = {10.1109/ICBAIE52039.2021.9390070},
  abstract = {In this paper, we propose a dangerous driving behavior recognition method using CenterNet combined with channel attention module, which we named CA-CenterNet. In our proposed CA-CenterNet, we add a channel attention module to the blocks in the backbone of CenterNet. Adding channel attention module can improve the network performance of CenterNet and the effect of dangerous driving behavior identification. In this paper, the dangerous driving behaviors are recognized based on the driver's hand. Furthermore, we capture numerous videos of the driver to establish a hand-detection-based dangerous driving behavior dataset. The proposed hand behavior recognition method is evaluated and compared with other network models. The experimental results show that this method improves the accuracy of behavior recognition. © 2021 IEEE.},
  keywords = {Artificial intelligence; Big data; Internet of things; Palmprint recognition; Behavior recognition; Dangerous drivings; Hand detection; Network models; Behavioral research},
