  author = {Ayou, Meryem and Trardi, Youssef and Chakir, Loqman and Boumhidi, Jaouad},
  year = {2023},
  booktitle = {E3S Web of Conferences},
  doi = {10.1051/e3sconf/202346900102},
  abstract = {Known issues such as traffic congestion, pollution, and travel delays are mainly caused by incidents in urban roads, so incidents need to be detected for better management. This paper describes various machine learning algorithms for incident detection, like Support Vector Machine (SVM), Random Forest (RF) and long short-term memory network (LSTM). To assess the effectiveness of these models, simulated data were generated through the utilization of the open-source software SUMO. And the obtained results show that the LSTM achieve a good performance when it’s compared to SVM and Random Forest. © The Authors, published by EDP Sciences.},
  note = {ID cribado R0329; bases: Scopus},
}

@inproceedings{R0330,
  title = {DdbiNet: A dangerous driving behavior identification network based on Resnet18},
  author = {Feng, Xinyun and Peng, Tao and Duan, Tingting and Hou, Haijing and Chen, Qiang and Zhang, Zhiguo},
  year = {2024},
  booktitle = {2024 5th International Conference on Information Science, Parallel and Distributed Systems, ISPDS 2024},
  doi = {10.1109/ISPDS62779.2024.10667560},
  abstract = {The direct correlation between drivers' dangerous behaviors and vehicle safety underscores the critical need for timely identification of such behaviors to enhance traffic safety. To enhance the detection of dangerous driving behaviors, we incorporated the advanced SCConv module into the ResNet18-based model, aiming to improve its accuracy. Our research revealed that the placement of the SCConv module significantly influences model accuracy. Consequently, we performed a series of ablation studies to pinpoint the optimal module placement, culminating in the formulation of the DdbiNet architecture. Concurrently, DdbiNet was benchmarked against several contemporary classification models, demonstrating superior accuracy in identifying hazardous driving behaviors. The ablation study results indicated that DdbiNet enhanced the Top1 and Top5 accuracy metrics by 29% and 31%, respectively, compared to the baseline model. The comparative analyses further affirmed that DdbiNet outperforms in the Top1 and Top5 accuracy metrics, while maintaining a lower count of parameters and FLOPs. © 2024 IEEE.},
  keywords = {Convolutional neural networks; Vehicle safety; Behavior identifications; Convolutional attention; Convolutional neural network; Dangerous driving behavior; Dangerous drivings; Driving behaviour; Images classification; Network-based; Vehicle safety; Ablation},
  note = {ID cribado R0330; bases: Scopus},
}

@article{R0334,
  title = {Deep Deconvolution for Traffic Analysis With Distributed Acoustic Sensing Data},
  author = {Van Den Ende, Martijn and Ferrari, Andre and Sladen, Anthony and Richard, Cedric},
  year = {2023},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  doi = {10.1109/TITS.2022.3223084},
  abstract = {Distributed Acoustic Sensing (DAS) is a novel vibration sensing technology that can be employed to detect vehicles and to analyse traffic flows using existing telecommunication cables. DAS therefore has great potential in future 'smart city' developments, such as real-time traffic incident detection. Though previous studies have considered vehicle detection under relatively light traffic conditions, in order for DAS to be a feasible technology in real-world scenarios, detection algorithms need to also perform robustly under a wide range of traffic conditions. In this study we investigate the potential of roadside DAS for the simultaneous detection and characterisation of the velocity of individual vehicles. To improve the temporal resolution and detection accuracy, we propose a self-supervised Deep Learning approach that deconvolves the characteristic car impulse response from the DAS data, which we refer to as a Deconvolution Auto-Encoder (DAE). We show that deconvolution of the DAS data with our DAE leads to better temporal resolution and detection performance than the original (non-deconvolved) data. We subsequently apply our DAE to a 24-hour traffic cycle, demonstrating the feasibility of our proposed method to process large volumes of DAS data, potentially in near-real time. © 2000-2011 IEEE.},
  keywords = {Deconvolution; Deep learning; Impulse response; Vehicles; Vibration analysis; Acoustic sensing; Auto encoders; Blind deconvolution; Deconvolutions; Distributed acoustic sensing; Non-blind deconvolution; Self-supervised deep learning; Sensing data; Traffic analysis; Traffic conditions; Convolution},
  note = {ID cribado R0334; bases: Scopus, Web of Science, IEEE Xplore},
}

@inproceedings{R0336,
  title = {Deep Ensemble-Based Spatiotemporal Traffic Forecasting Using Real-Time Urban Sensor Data},
  author = {Shrivastava, Namrata and Agrawal, Jitendra and Raghuwanshi, Sandeep Kumar},
  year = {2026},
  booktitle = {Proceedings of the 2026 International Conference on Emerging Trends in Information, Communication and Systems, ICETICS 2026},
  doi = {10.1109/ICETICS69505.2026.11651281},
  abstract = {Accurate short-term traffic prediction is a critical component of intelligent transportation systems (ITS), yet it remains challenging due to nonlinear temporal dynamics, evolving spatial dependencies, and uncertainty in real-time urban traffic data. This paper proposes a novel uncertainty-aware deep ensemble spatiotemporal forecasting framework integrating Dynamic Graph Convolutional Networks (DGCN), Temporal Transformers, and CNN-LSTM hybrid models. A confidence-guided ensemble fusion strategy dynamically weights individual predictions using Bayesian uncertainty estimation. Experiments conducted on real-time Bhopal city traffic data demonstrate significant improvements over state-of-the-art baselines, achieving up to 90% performance gains during peak and abnormal traffic conditions. © 2026 IEEE.},
  keywords = {Deep learning; Forecasting; Intelligent systems; Intelligent vehicle highway systems; Motor transportation; Real time systems; Traffic control; Uncertainty analysis; Convolutional networks; Deep ensemble learning; Dynamic graph; Dynamic graph convolutional network; Ensemble learning; Intelligent transportation systems; MAE; RMSE; Spatio-temporal forecasting; Transformer; Convolution; Urban transportation},
  note = {ID cribado R0336; bases: Scopus, IEEE Xplore},
}

@inproceedings{R0342,
  title = {Deep Learning-Based Detection of Traffic Accidents Using CNN and VGG16 on Accident and Foggy Image Datasets},
  author = {Pokkuluri, Kiran Sree and Sivanjani, Manthena and Prasad, M. and Pbv, Raja Rao and Raju, P. J R Shalem and Rapaka, Anuj},
  year = {2025},
  booktitle = {Proceedings of 2025 3rd International Conference on Intelligent Systems, Advanced Computing, and Communication, ISACC 2025},
  doi = {10.1109/ISACC65211.2025.10969159},
  abstract = {Detection of traffic accidents is a key part of intelligent transportation systems, providing real-time analysis in order to improve safety on the road and assist in the logistics and management of the traffic system. It's based on a study which introduces a new CNN - based deep learning framework at the VGG16 architecture. The model is trained on a varied dataset consisting of images from accident zones, non-accident images, and foggy images, with some classified as potential accident zones due to reduced visibility. Utilizing the feature extraction capabilities of CNN and the pre-trained VGG16 model, we intend to precisely classify accident occurrences across diverse environmental conditions, including low-visibility situations. This method underscores the significance of deep learning in the analysis of intricate road scenarios and the capability of automated traffic monitoring systems to enhance decision-making and response times in accident-prone regions. Our model demonstrates strong efficacy in differentiating between accident and non-accident scenarios, even under foggy conditions, rendering it a valuable asset for real-time traffic monitoring applications. © 2025 IEEE.},
  keywords = {Deep neural networks; Emergency traffic control; Highway accidents; Highway administration; Highway traffic control; Motor transportation; Accident detections; Convolutional neural network; Deep learning; Foggy conditions; Image datasets; Images classification; Intelligent transportation systems; Traffic accident detection; VGG16; Convolutional neural networks},
