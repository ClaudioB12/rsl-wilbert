@inproceedings{R0155,
  title = {A Novel Approach for Accident Detection and Localization Using Deep Learning},
  author = {Mudgal, Manisha and Punj, Deepika and Pillai, Anuradha},
  year = {2023},
  booktitle = {2023 International Conference on Advances in Computation, Communication and Information Technology, ICAICCIT 2023},
  doi = {10.1109/ICAICCIT60255.2023.10465822},
  abstract = {Traffic surveillance footage requires constant monitoring in order to detect deadly accidents and to react appropriately. However, it is tiresome and mistake prone to regularly supervise them with humans. A sophisticated and quick system for detecting road accidents is urgently needed due to the rise in fatalities from accidents on the roads. After accidents, a few crucial seconds frequently makes a lot of difference. There is a need for a system that can immediately recognize emergency situations and notify the police and hospital about them. This study proposes a real-time traffic incident detection and alarm system that is based on a computer vision technique, with the goal of achieving a penetrating impact in boosting the associated demand for road traffic security and safety. The vehicle detection and tracking model first assigned a distinct serial number (ID) to each vehicle in order to detect and track the movements of the vehicles. This was done using the YOLOv3 object detector and DeepSORT tracker with region of interest interception. The mean average precision (mAP) of this model was 98.2%. © 2023 IEEE.},
  keywords = {Alarm systems; Highway accidents; Image segmentation; Object detection; Roads and streets; Vehicles; Accident detections; Deep learning; Deepsort; Detection and localization; Emergency situation; Realtime traffic; SDD; Traffic incident detections; Traffic surveillance; YOLO; Deep learning},
