@inproceedings{R0343,
  title = {Deep Learning-Based Efficient Framework for Predicting Lane Change},
  author = {Padmapriya, K. and Kavitha, K. and Allwyn, T Philip and Ramaraj, Kottaimalai and Priya, S Shanmuga and Bhuvaneswary, N.},
  year = {2024},
  booktitle = {5th International Conference on Sustainable Communication Networks and Application, ICSCNA 2024 - Proceedings},
  doi = {10.1109/ICSCNA63714.2024.10864287},
  abstract = {Intelligent transportation systems greatly benefit from lane-changing (LC) driving behaviour when it comes to safety. Because drivers' actions are so random, it's hard to made the LC process. It is a high risk of serious accidents caused by irrational lane changes and the resulting traffic congestion. Right now, lane shifting models aren't very accurate. Therefore, very accurate lane change prediction is necessary to enhance road safety. A good lane change forecast model based on the Deep Belief Network (DBN) model has been created to learn about people's risky lane changing habits. Bayesian networks using Gaussian mixture models and back propagation neural networks are two examples of state-of-the-art methods that are contrasted with the suggested model. The Bayesian network with a Gaussian mixture model and back propagation neural network predict dangerous driving behaviour less accurately than the suggested approach. An accuracy percentage of 97.2% was achieved with the Deep Belief Network model. The outcomes implies, the suggested method is highly efficient in predicting when a driver will switch lanes. An intelligent transportation system may alert drivers of unsafe lane alterations by the suggested method. © 2024 IEEE.},
  keywords = {Deep learning; Gaussian distribution; Traffic congestion; Bayesia n networks; Deep belief network; Deep belief networks; Deep learning; Driving behaviour; Intelligent transportation systems; Lane change; Lane changing; Lane keep; Network models; Intelligent systems},
  note = {ID cribado R0343; bases: Scopus},
}

@inproceedings{R0346,
  title = {Deep Learning Based Traffic Accident Detection in Smart Transportation: A Machine Vision-Based Approach},
  author = {Melegrito, Mark and Reyes, Ryan and Tejada, Ryan and Sualog Anthony, John Edgar and Sarraga Alon, Alvin and Delmo, Ritchelie P. and Enaldo, Meriam A. and Anqui, Abrahem P.},
  year = {2024},
  booktitle = {2024 4th International Conference on Applied Artificial Intelligence, ICAPAI 2024},
  doi = {10.1109/ICAPAI61893.2024.10541163},
  abstract = {This paper provides a deep learning-based method for traffic accident identification in smart transportation that is based on machine vision and uses the YOLOv8 architecture. The goal of the research is to precisely identify and localize accident-related factors to improve safety protocols and system efficiency in transportation. The YOLOv8 model performed exceptionally well using deep learning approaches, producing a mean Average Precision (mAP) of 94.4%, Precision of 91.6%, and Recall of 92.3%. The study focused on the testing and inference phases and thoroughly assessed the model's capabilities. High identification rates throughout testing across multiple scenarios showed how well the program could recognize accidents, including car crashes and non-accident scenes. The model's accuracy and dependability were highlighted by its capacity to identify non-accident scenarios without producing false positives. These encouraging results underline the YOLOv8 architecture's preparedness for implementation and show its potential to raise efficiency and safety standards in smart transportation networks greatly. This work represents a significant step forward in the field of machine vision-based accident detection and suggests future directions for improving real-time, accurate accident identification for more secure and effective transportation systems. © 2024 IEEE.},
  keywords = {Accidents; Deep learning; Efficiency; Intelligent systems; Learning systems; Network architecture; Real time systems; Software testing; Well testing; Accident detections; Deep learning; Learning-based methods; Machine-vision; On-machines; Related factors; Safety protocols; Smart transportation; Vision-based approaches; YOLOv8; Computer vision},
  note = {ID cribado R0346; bases: Scopus},
}

@article{R0348,
  title = {Deep learning detection of anomalous patterns from bus trajectories for traffic insight analysis},
  author = {Zhang, Xiaocai and Zheng, Yi and Zhao, Zhixun and Liu, Yuansheng and Blumenstein, Michael and Li, Jinyan},
  year = {2021},
  journal = {Knowledge-Based Systems},
  doi = {10.1016/j.knosys.2021.106833},
  abstract = {Existing data-driven methods for traffic anomaly detection are modeled on taxi trajectory datasets. The concern is that the data may contain much inaccuracy about the actual traffic situations, because taxi drivers often choose optimal routes to evade from the congestions caused by traffic anomalies. We use bus trajectory data in this work. Bus trajectories can capture real traffic conditions in the road networks without drivers’ preference, which are more objective and appropriate for accurately detecting anomalous patterns for a broad range of insight analyses on traffics. We proposed a deep learning-based feature visualization method to map 3-dimensional features into a red–green–blue (RGB) color space. A color trajectory (CT) is then derived by encoding a trajectory with the RGB colors. With the spatial and temporal properties extracted from the CT, spatio-temporal outliers are detected by a novel offline detection method. We then conduct GIS map fusion to obtain insights for better understanding the traffic anomaly locations, and more importantly the influences on the road affected by the corresponding anomalies. Extended from the offline detection, an online detection method is developed for real-time detection of anomalous patterns. Our proposed methods were tested on 3 real-world bus trajectory datasets to demonstrate the performance of high accuracies, high detection rates and relatively low false alarm rates. © 2021},
  keywords = {Anomaly detection; Behavioral research; Buses; Color; Motor transportation; Pattern recognition; Roads and streets; Taxicabs; Traffic congestion; Trajectories; Data-driven methods; High detection rate; On-line detection method; Real traffic conditions; Real-time detection; Traffic anomaly detections; Traffic situations; Visualization method; Deep learning},
  note = {ID cribado R0348; bases: Scopus, ScienceDirect},
}

@article{R0350,
  title = {Deep learning enhanced driving behavior evaluation based on vehicle-edge-cloud architecture},
  author = {Xun, Yijie and Qin, Junman and Liu, Jiajia},
  year = {2021},
  journal = {IEEE Transactions on Vehicular Technology},
  doi = {10.1109/TVT.2021.3078482},
  abstract = {With the rapid development of 5 G, artificial intelligence and other technologies, the intelligent transportation system (ITS) bursts flourish fireworks. It is acknowledged that driving security problem still runs through the ITS development history.It is the driver who plays the decisive role in a vehicle accident, and the performance of autopilot system is also the kernel in guaranteeing the security of autonomous vehicle. Therefore, many researchers devote to self-driving system optimization and human abnormal driving behavior detection. Note that they either relied on simulators, or confined to several specific driving patterns, which undoubtedly limited their application value. In addition, some works require the vehicles have high computing power and abundant storage memory, which aggravated their burden. Different from previous works, we propose a driving behavior evaluation scheme based on vehicle-edge-cloud architecture. When vehicles running on the road, they transmit the data reflecting the autopilots/driver behaviors to the edge networks via the telematics box. The edge networks use the driving behavior evaluation model trained by cloud server, and send the behavior rankings back to vehicles. The cloud server continuously trains and optimizes the driving behavior evaluation model using vehicle data, and regularly transmits the model to the edge networks for upgrading. The experimental results show robustness and feasibility of the scheme. © 1967-2012 IEEE.},
  keywords = {5G mobile communication systems; Accidents; Air navigation; Cloud computing; Computer architecture; Deep learning; Digital storage; Intelligent systems; Intelligent vehicle highway systems; Network architecture; Vehicles; Autopilot systems; Computing power; Development history; Driving behavior; Driving pattern; Intelligent transportation systems; Security problems; Vehicle accidents; Behavioral research},
  note = {ID cribado R0350; bases: Scopus, Web of Science},
}

@inproceedings{R0351,
  title = {Deep Learning Ensemble Framework for Real-Time Traffic Accident Detection in Smart Cities with AMSE - ADM Data Augmentation},
  author = {Himabindhu, Porika and Reddy, Kumbala Pradeep and Rajkumar, Mateti and Sanuvala, Ganga and Narendra, Amgoth},
  year = {2026},
  booktitle = {Proceedings of the 2026 6th International Conference on Image Processing and Capsule Networks, ICIPCN 2026},
  doi = {10.1109/ICIPCN67432.2026.11438697},
  abstract = {The fast growing and very variable nature of road traffic presents professional challenges to public safety and effective traffic management in smart city surroundings. Frequent traffic accidents not only result in loss of life but also break urban motility systems, featuring the need for intelligent and automated accident detection explanations. This work presents a complete experimental study of existing traffic accident detection techniques, highlighting the current limitations of the state of the art paths while offering an in-depth analysis of common accident types such as crashes of rear-end, crashes at T-bone, & front accident simpact. To address these objections, the proposed work introduces a novel and lightweight deep learning architecture named AMSE-ADM, specifically designed for traffic accident detection of vision-based in smart city surveillance systems. The model effectively involves RGB video frames with flow of optical information to capture both spatial and temporal motion features of traffic scenes. The architecture influences advanced spatio temporal feature extraction mechanisms along with enhanced temporal dependency modeling across video sequences, enabling accurate detection of accident events. Extensive experimental evaluation demonstrates the effectiveness of the proposed approach, showing that the AMSE-ADM model outperforms other configurations. Furthermore, this study discusses critical challenges such as data imbalance, limited datasets, and constrained road and traffic scenarios, which significantly impact model generalization. Overall, the proposed framework paves the way for an efficient accident detection model in real-time and which is suitable for deployment on edge devices within smart city traffic infrastructures. © 2026 IEEE.},
  keywords = {AMSE-ADM; Deep learning; detection of Traffic accident; Edge IoT systems; Real-time monitoring; RGB and optical flow; Smart cities; Spatio temporal feature extraction; Vision-based surveillance},
  note = {ID cribado R0351; bases: Scopus, IEEE Xplore},
}

@inproceedings{R0353,
  title = {Deep Reinforcement Learning-Based Traffic Signal Control for Urban Congestion},
  author = {Hajmohamed, Hadeel and Mahmud, Doaa and Aldhaheri, Lameya and Almentheri, Shamma and Alqaydi, Shamma and Sadia, Haleema and Saeed, Nasir},
  year = {2025},
  booktitle = {International Conference on Communication, Computing, Networking, and Control in Cyber-Physical Systems, CCNCPS 2025},
  doi = {10.1109/CCNCPS66785.2025.11135668},
  abstract = {Due to limited infrastructure capacity and the increasing number of vehicles, traffic congestion remains a major problem in urban management. The scalability and adaptability issues with traditional traffic signal control (TSC) techniques call for innovative solutions. In order to optimize intelligent transportation systems (ITS), this paper investigates the use of deep reinforcement learning (DRL) models, specifically deep Q-networks (DQN) and their variations. In this study, we employed a Markov Decision Process (MDP) framework to assess how various RL models improve traffic flow efficiency and alleviate congestion. This allows adaptive real-time decision-making to improve traffic flow. We assess how well two RL agents - "Choose Next Phase"and "Next or Not"- manage traffic at a four-way intersection. The simulation results show that RL-based methods perform better than conventional methods, reducing emergency vehicle delays, average waiting time, and queue length. By obtaining higher and more consistent rewards over training iterations, the "Choose Next Phase"agent showed exceptional adaptability. Additionally, under abnormal traffic conditions, we compare RL-based TSC with traditional heuristic-based techniques, emphasizing DRL's superior handling of complex scenarios. To further increase scalability and decision-making reliability in practical applications, future research is highlighted with an emphasis on improving RL models using multi-agent learning, transformer-based architectures, and decentralized computing. © 2025 IEEE.},
  keywords = {Advanced traffic management systems; Behavioral research; Decision making; Deep learning; Deep reinforcement learning; Emergency traffic control; Heuristic methods; Highway traffic control; Intelligent agents; Intelligent systems; Markov processes; Motor transportation; Multi agent systems; Traffic congestion; Traffic signals; Urban transportation; Control techniques; Deep Q-network; Intelligent transportation systems; Number of vehicles; Reinforcement learnings; Traffic flow; Traffic signal control; Urban congestion; Urban management; Vehicle traffic; Reinforcement learning},
  note = {ID cribado R0353; bases: Scopus, IEEE Xplore},
}

@article{R0356,
  title = {Deep representation of imbalanced spatio-temporal traffic flow data for traffic accident detection},
  author = {Mehrannia, Pouya and Bagi, Shayan Shirahmad Gale and Moshiri, Behzad and Al-Basir, Otman Adam},
  year = {2023},
  journal = {IET Intelligent Transport Systems},
  doi = {10.1049/itr2.12287},
  abstract = {Automatic detection of traffic accidents has a crucial effect on improving transportation, public safety, and path planning. Many lives can be saved by the consequent decrease in the time between when the accidents occur and when rescue teams are dispatched, and much travelling time can be saved by notifying drivers to select alternative routes. This problem is challenging mainly because of the rareness of accidents and spatial heterogeneity of the environment. This paper studies deep representation of loop detector data using long-short term memory (LSTM) network for automatic detection of freeway accidents. The LSTM-based framework increases class separability in the encoded feature space while reducing the dimension of data. The experiments on real accident and loop detector data collected from the Twin Cities Metro freeways of Minnesota demonstrate that deep representation of traffic flow data using LSTM network has the potential to detect freeway accidents in less than 18 min with a true positive rate of 0.71 and a false positive rate of 0.25 which outperforms other competing methods in the same arrangement. © 2022 The Authors. IET Intelligent Transport Systems published by John Wiley & Sons Ltd on behalf of The Institution of Engineering and Technology.},
  keywords = {Accidents; Intelligent systems; Motion planning; Traffic control; Accident detections; Alternative routes; Automatic Detection; Flow data; Loop detector data; Memory network; Public safety; Spatio-temporal; Traffic flow; Traveling time; Long short-term memory},
  note = {ID cribado R0356; bases: Scopus, Web of Science},
}

@article{R0357,
  title = {Deep Transfer Learning Based Intersection Trajectory Movement Classification for Big Connected Vehicle Data},
  author = {Komol, Md Mostafizur Rahman and Elhenawy, Mohammed and Masoud, Mahmoud and Glaser, Sebastien and Rakotonirainy, Andry and Wood, Merle and Alderson, David},
  year = {2021},
  journal = {IEEE Access},
  doi = {10.1109/ACCESS.2021.3119600},
  abstract = {Trajectory movement labelling is an important pre-stage for predicting connected vehicle (CV) movement at intersections. Drivers' movement prediction and warning at intersections ensure advanced transportation safety and researchers use machine learning-based data-driven approaches to implement these technologies. However, prediction of drivers' movements at intersections requires labelling the train and test dataset accurately with different vehicle movements at intersections to evaluate the performance of the prediction model by comparing the actual and predicted intersection movements. Moreover, due to GPS detection error or missing co-operative awareness messages (CAM), the data resides with many abnormal trajectories which are unable to be matched with regular straight or any turning movements. Especially for big data with million trajectories, it is tedious to label the movements manually. To solve this problem, we have created an automated trajectory movement classification technique using a dual approach of map matching technique and deep transfer learning modelling. Data of connected vehicle trajectory information is taken from the Ipswich Connected Vehicle Pilot (ICVP) Project, which is one of the largest connected vehicle pilots within a naturalistic driving environment in Australia. Map matching approach is performed as initial labelling by analysing the origin and destination of the vehicle CAM messages at intersections and then was converted as image datasets of 19202 samples. The map matching error and abnormal trajectories are identified by visual inspection. With properly labelled 9496 training images, 10 transfer learning models are built and tested through the remaining 9706 testing images. The maximum testing accuracy (99.73%) is achieved from the Densenet169 model, and the result shows satisfactory accuracy for individual classes: straight (99.85%), turn left (99.59), turn right (99.25), u-turn (100%), abnormal (98.63%). This model becomes a routine tool that is used daily to automatically classify thousands of trajectory movements of the C-ITS data in the ICVP project. © 2013 IEEE.},
  keywords = {Automobile drivers; Cams; Classification (of information); Deep learning; Forecasting; Motion estimation; Statistical tests; Vehicles; Australia; Connected vehicle; Labelings; Map-matching algorithm; Movement classification; Trajectory movements; Transfer learning; Vehicle movements; Trajectories},
  note = {ID cribado R0357; bases: Scopus},
}

@article{R0359,
  title = {Deep Unsupervised Transfer Adversarial Network for Abnormal Driving Behavior Recognition Based on Smartphone Sensors},
  author = {Chen, Xiaobo and Qu, Rui and Zhao, Feng},
  year = {2024},
  journal = {IEEE Sensors Journal},
  doi = {10.1109/JSEN.2024.3478254},
  abstract = {Abnormal driving has been widely recognized as one of the key factors highly related to traffic accidents. Smartphones mounted on vehicles can be leveraged to record a variety of vehicle motion-related data, and therefore, can serve as a platform for monitoring driver abnormal behavior. However, due to the data distribution shift and domain discrepancy, the abnormal driving behavior recognition (ADBR) model trained in one driving scenario probably fails in predicting the behavior data acquired from the other driving scenarios. We propose a groundbreaking unsupervised domain adaptation (UDA) approach that Provides a solution to transfer knowledge acquired from the tagged source domain (SD) to target domains (TDs) that do not have tagged data. Specifically, a dual-stream feature extraction module consisting of 1-D convolution and multihead attention is first established to extract transferable features from raw sensor data. Then, a confidence-based pseudolabeling self-training approach is developed to fully utilize the unlabeled target domain data. Furthermore, a joint adversarial domain adaptation (JADA) method is presented to reduce both marginal and conditional distribution discrepancy simultaneously. By doing this, source and TD data can be aligned well. The proposed method is tested on real-world driving behavior datasets and the results demonstrate the effectiveness and superiority of our model in cross-scenario ADBR. © 2024 IEEE.},
  keywords = {Abnormal driving behavior recognition; Adversarial domain adaptation; Behaviour recognition; Deep learning; Domain adaptation; Driving behaviour; Labelings; Pseudo-labeling self-training; Self-training; Smart phones; Adversarial machine learning},
  note = {ID cribado R0359; bases: Scopus, Web of Science},
}

@inproceedings{R0363,
  title = {Design and analysis of driver sign safety monitoring system based on multi-algorithm combination},
  author = {Ye, Shengnian and Wei, Xiao and Liu, Weijia and Chen, Haotian and Yao, Junsheng and Jiao, Kehong},
  year = {2023},
  booktitle = {ACM International Conference Proceeding Series},
  doi = {10.1145/3650400.3650636},
  abstract = {The purpose of this study is to explore the key points of dangerous driving behavior and driver health monitoring. For this purpose, a smart steering wheel capable of monitoring dangerous driving behavior and a steering wheel cover capable of monitoring physical health have been designed. The real-time face image acquisition mainly adopts MTCNN model. This paper studies driver safety monitoring from three perspectives: cockpit environment parameters, driver body information and driver behavior state, and puts forward a design scheme of driver safety monitoring system combining artificial intelligence and Internet of Things technology. Image recognition is used to detect the driver's behavior state. The fusion algorithm based on LSTM integrates PPG and electrocardiogram signals to collect the relevant data information obtained by various sensors. Through testing and analysis, the data is accurate and effective, and the system realizes effective monitoring and alarm of the dangerous factors existing in the driver's driving process. To a certain extent, it can reduce the road traffic accidents caused by the driver's own problems, and has certain application value. The system has the ability of real-time monitoring of driving behavior and health management at the same time. © 2023 ACM.},
  keywords = {Automobile steering equipment; Behavioral research; Internet of things; Long short-term memory; Wheels; Algorithm combinations; Dangerous drivings; Deep learning; Design and analysis; Driver's behavior; Driver's safety; Driving behaviour; Fatigue monitoring; Safety monitoring system; Steering wheel; Face recognition},
  note = {ID cribado R0363; bases: Scopus, ACM Digital Library},
}

@inproceedings{R0364,
  title = {Design and Implementation of a Highway Surveillance Video AI Analysis System},
  author = {Hu, Lin and Mao, Mingzhi and Cao, Birong},
  year = {2024},
  booktitle = {2024 5th International Conference on Computer Vision, Image and Deep Learning, CVIDL 2024},
  doi = {10.1109/CVIDL62147.2024.10603833},
  abstract = {This article aims to design a highway monitoring system based on artificial intelligence (AI) from highway surveillance videos, which is used for monitoring highway littering, detecting pedestrian or non-motorized vehicle intrusions, and monitoring traffic accidents. By employing advanced deep learning algorithms in conjunction with computer vision technology, an efficient intelligent monitoring system capable of stable operation under various weather and lighting conditions has been developed. Through real-time analysis of live video streams, the system can detect traffic incidents and issue timely alerts when abnormal behaviors occur. Experimental results demonstrate that the system can accurately identify different types of vehicles and traffic incidents, exhibiting high accuracy in traffic incident detection. The findings suggest that the highway intelligent monitoring system based on video AI can improve traffic management efficiency and effectively assist in traffic safety control. © 2024 IEEE.},
  keywords = {Deep learning; Highway accidents; Highway planning; Learning systems; Security systems; Analysis system; Deep learning; Design and implementations; Highway event; Highway monitoring; Intelligence analysis; Intelligent monitoring systems; Surveillance video; Traffic incidents; Video analysis; Learning algorithms},
  note = {ID cribado R0364; bases: Scopus, IEEE Xplore},
}

@inproceedings{R0365,
  title = {Design and Implementation of On-Device AI for Dangerous Driving Behavior Recognition},
  author = {Kim, Taegu and Kim, Chanwoo and Jeon, Dongkeun and Shin, Kihun and Baek, Yunju},
  year = {2023},
  booktitle = {2023 AEIT International Conference on Electrical and Electronic Technologies for Automotive, AEIT AUTOMOTIVE 2023},
  abstract = {Recognizing dangerous driving behaviors is crucial considering the significant number of casualties in road accidents. This paper proposes an on-device AI for recognizing drivers' dangerous driving behaviors during vehicle operation. The driving behaviors are recognized using deep learning and implemented as a compact device inside the vehicle. The deep learning model utilizes the vehicle internal sensors to classify dangerous driving behaviors in real-Time, distinguishing a total of 17 driving behaviors, including 9 normal driving behaviors and 8 dangerous driving behaviors. Due to the use of low-spec processors in the on-device AI system, lightweight techniques are applied to reduce the size of the deep learning model by over 50%. Nonetheless, the system achieves an accuracy of 83.24% and an F1-Score of 0.81. The lightweight deep learning model implemented in the on-device AI demonstrates an inference time of 13.6ms, enabling real-Time operation. This allows for various applications, such as recognizing dangerous driving behaviors in real-Time and providing drivers with warnings and encouraging safe driving. © 2023 AEIT.},
  keywords = {Deep learning; Highway accidents; Learning systems; Vehicles; Behaviour recognition; Dangerous driving behavior recognition; Dangerous drivings; Design and implementations; Driving behaviour; Learning models; Lightweight deep learning model; OBD-II; On-device AI; Real- time; Behavioral research},
  note = {ID cribado R0365; bases: Scopus},
}

@inproceedings{R0366,
  title = {Designing an Uncertainty-Aware Federated Learning (UA-FL) Framework for Multi-Modal Traffic Prediction Under Non-Recurrent Congestion Events},
  author = {Jegadeesan, S. and Aswin Kumar, S. and Karthick, G.},
  year = {2025},
  booktitle = {Proceedings of the 9th International Conference on I-SMAC (IoT in Social, Mobile, Analytics and Cloud), I-SMAC 2025},
  doi = {10.1109/I-SMAC65734.2025.11597657},
  abstract = {Accurately predicting traffic flow when there are non-recurrent congestion incidents - such as an accident, road work or extreme weather - is difficult due to the uncertainty of input data, and the localized variations across geographical regions. Conventional Federated Learning (FL) approaches tend to ignore this uncertainty which restricts their dependability in chaotic situations. This study presents an Uncertainty-Aware Federated Learning (UA-FL) framework that applies probabilistic modeling while simultaneously estimating uncertainty in a federated manner. Specifically, UA-FL leverages Bayesian neural networks and ensemble modeling to quantify the confidence in predictions across clients without needing to share private data. Experiments on real-world traffic datasets demonstrate that UA-FL is able to outperform conventional FL approaches in the accuracy as well as uncertainty estimation, particularly in the presence of non-recurrent congestion. By allowing more honest and justified decisions, we hope to contribute to safer and more reliable intelligent transportation systems. © 2025 IEEE.},
  keywords = {Bayesian networks; Intelligent systems; Intelligent vehicle highway systems; Motor transportation; Recurrent neural networks; Traffic congestion; Uncertainty analysis; Bayesian neural networks; Federated learning ,uncertainty quantification; Intelligent transportation system; Intelligent transportation systems; Learning approach; Learning frameworks; Non-recurrent congestion; Traffic prediction; Uncertainty; Uncertainty quantifications; Forecasting},
  note = {ID cribado R0366; bases: Scopus},
}

@article{R0367,
  title = {Design of an AI-based security anomaly detection system for IoT terminals based on the ViT-transformer fusion model},
  author = {Zhang, Xuwen},
  year = {2026},
  journal = {Scientific Reports},
  doi = {10.1038/s41598-026-55476-y},
  abstract = {The deep penetration of IoT terminals in water systems, healthcare, transportation, and other fields has exacerbated security threats such as cyber-physical attacks and traffic anomalies. However, traditional anomaly detection methods have limitations such as dependence on labeled data, weak generalization ability, high resource consumption, and prominent privacy risks. Although Vision Transformer (ViT) has the advantage of capturing global features, it is difficult to directly adapt to resource-constrained IoT terminals. In existing research, hybrid deep learning models have improved detection accuracy, but lightweight ViT fusion models lack terminal adaptability and multi-modal data fusion applications are scarce. The balance between dynamic scheduling and privacy protection in end-edge-cloud collaboration still needs to be broken through. To address the above issues, this paper proposes an IoT terminal AI security anomaly detection system based on the ViT-Transformer fusion model: adopting a three-level end-edge-cloud collaborative architecture, integrating multi-modal data such as network traffic, sensor timing, and side channel signals, and achieving cross-modal feature fusion through tokenization; combining pruning, distillation, and quantization optimization strategies to increase the model compression ratio to 70%; introducing Elliptic Curve Certificateless Encryption (CL-PKE) and Batch Listing Signature (BLS) batch authentication to ensure data security, and using federated learning to aggregate edge model updates and optimize global performance. Experiments were conducted on public datasets such as IoT-23 and UCI, as well as a self-made testbed. The results show that the model achieves an accuracy of 89.2% and an F1-score of 0.87 in multi-modal anomaly detection, with a terminal inference delay of 90ms and a memory footprint of 30MB, adapting to low-computing devices such as RPi4B and Arduino; CL-PKE resists brute force attacks for 5.2e6 seconds, and batch authentication for 100 terminals takes only 75ms; it exhibits excellent generalization across smart home, industrial IoT, and other scenarios, with a defense success rate of 85.3% against FGSM attacks. This study effectively addresses the resource bottleneck and security pain points of existing methods, providing an efficient and reliable technical solution for IoT terminal security. © The Author(s) 2026.},
  keywords = {article; compression; controlled study; deep learning; diagnosis; distillation; encryption; federated learning; human; outlier detection; quantization; smart home; water supply},
  note = {ID cribado R0367; bases: Scopus, Web of Science},
}

@inproceedings{R0369,
  title = {Design of intelligent recognition and early warning algorithm for abnormal road traffic behaviors based on machine vision},
  author = {Xi, Chaohu and Liu, Xiaorui and Liu, Hongjun and Wang, Chunpeng},
  year = {2026},
  booktitle = {Proceedings of SPIE - The International Society for Optical Engineering},
  doi = {10.1117/12.3102130},
  abstract = {With the development of intelligent transportation systems, intelligent recognition and early warning algorithms for abnormal road traffic behaviors based on machine vision have become a research hotspot. This paper proposes a multilevel intelligent monitoring system architecture, integrating data acquisition, preprocessing, feature extraction and behavior analysis modules. The efficiency and accuracy of target detection are improved through the improved YOLOv7 detection network, and the lightweight backbone network and multi-scale feature enhancement strategy are introduced to optimize the computing load and detection performance. Meanwhile, combined with the spatio-temporal context modeling module, the trajectory prediction LSTM and behavioral semantic graph are utilized to analyze the multi-objective interaction relationship, enhancing the robustness of abnormal behavior recognition. Furthermore, a dynamic risk assessment model and a hierarchical response strategy are designed to achieve real-time risk quantification and multi-level early warning triggering. The experimental results show that the proposed algorithm achieves significant performance improvement on self-built datasets and public benchmarks, with detection accuracy reaching mAP@0.83, processing speed reaching 36.4 FPS, false alarm rate reduced by 83.5%, and good adaptability in complex weather and high-density scenarios. Actual scenario tests have verified the effectiveness of the system under extreme conditions. The early warning delay is lower than the industry standard, providing reliable technical support for intelligent traffic management. © COPYRIGHT SPIE.},
  keywords = {Behavioral research; Computer architecture; Computer vision; Data acquisition; Highway planning; Highway traffic control; Intelligent systems; Intelligent vehicle highway systems; Machine vision; Motor transportation; Roads and streets; Semantics; Street traffic control; Behavior-based; Early warning; Intelligent recognition; Machine vision identification of abnormal traffic behavior intelligent early warning algorithm spatiotemporal feature fusio; Machine-vision; On-machines; Road traffic; Spatiotemporal feature; Traffic behavior; Warning algorithms; Benchmarking},
  note = {ID cribado R0369; bases: Scopus},
}

@inproceedings{R0370,
  title = {Design of Multifunctional Integrated Real-Time Traffic Supervision System},
  author = {Liu, Boyang},
  year = {2025},
  booktitle = {2025 IEEE 5th International Conference on Power, Electronics and Computer Applications, ICPECA 2025},
  doi = {10.1109/ICPECA63937.2025.10928836},
  abstract = {This study focuses on the intelligence of urban traffic management, aiming to solve the increasingly severe urban traffic congestion and safety problems by integrating computer vision, deep learning technology, and Internet of Things technology. Based on the Faster R-CNN algorithm, a multifunctional integrated real-time traffic monitoring system was developed to achieve core functions such as traffic flow monitoring, pedestrian and non motorized vehicle detection, illegal behavior recognition, traffic sign recognition, and traffic accident detection. The system uses Raspberry Pi 4B as the main control chip, transmits data through Bluetooth module, and utilizes FREETROS operating system to achieve coordinated operation of tasks. The experimental results show that the system can recognize traffic targets with high accuracy (mAP50 is 56.3 %) and issue timely alarm information when a traffic accident is detected, demonstrating the effectiveness and reliability of the system in improving traffic management efficiency and ensuring traffic safety. This study provides new solutions and technical support for building a traffic management system for smart cities. © 2025 IEEE.},
  keywords = {Advanced traffic management systems; Air traffic control; Crime; Emergency traffic control; Highway accidents; Highway administration; Highway traffic control; Information management; Motor transportation; Nonmotorized transportation; Pedestrian safety; Traffic signs; Urban transportation; Fast R-CNN; Intelligent transportation systems; Multifunctional integration; Multifunctionals; Real-time traffic monitoring; Realtime traffic; Supervision systems; Traffic monitoring; Traffic safety; Urban traffic management; Traffic congestion},
  note = {ID cribado R0370; bases: Scopus, IEEE Xplore},
