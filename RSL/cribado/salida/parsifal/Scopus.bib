}

@inproceedings{R1154,
  title = {Traffic Anomaly Detection via Trajectory-Augmented Dynamics and Joint Spatiotemporal Transformer},
  author = {Shan, Huang and Xinzheng, Niu and Chao, Yan and Xuyao, Li and Yan, Qin},
  year = {2025},
  booktitle = {International Computer Conference on Wavelet Active Media Technology and Information Processing, ICCWAMTIP},
  doi = {10.1109/ICCWAMTIP68645.2025.11352625},
  abstract = {Timely and accurate alerts about traffic anomalies are essential for enhancing public safety and improving travel experiences. Despite significant outcomes in spatiotemporal traffic flow modeling for anomaly detection, existing methods still present two limitations: the limited representational capacity caused by feature homogeneity and insufficient ability in modeling time-varying spatiotemporal dependencies. To address these obstacles, this study proposes TA-JST, a traffic anomaly detection framework that integrates a joint spatiotemporal transformer with a traffic dynamics augmentation strategy. Specifically, a trajectory-based data augmentation mechanism is introduced to construct regional volume matrix of traffic dynamics, thereby enriching the representational diversity beyond single in-out flow statistics. And a joint spatiotemporal transformer is designed to effectively capture the dynamic spatial and temporal dependencies, enabling better representation of traffic dynamics patterns. Evaluations on two real-world traffic datasets show that our method outperforms other traffic anomaly detection baselines. © 2025 IEEE.},
  keywords = {Intelligent systems; Motor transportation; Traffic control; Data augmentation; Joint spatio-temporal; Public safety; Spatiotemporal transformer; Traffic anomalies; Traffic anomaly detections; Traffic data; Traffic data augmentation; Traffic dynamics; Travel experiences; Anomaly detection},
  note = {ID cribado R1154; bases: Scopus, IEEE Xplore},
}

@article{R1155,
  title = {Traffic anomaly detection with wild geese dwarf mongoose optimisation_DQNN},
  author = {Shariff, M. Ahsan and Babu, C. Nelson Kennedy},
  year = {2026},
  journal = {International Journal of Heavy Vehicle Systems},
  doi = {10.1504/IJHVS.2026.153659},
  abstract = {Traffic anomaly detection plays a critical role in ensuring the security and reliability of modern networks, particularly in the context of software-defined networking (SDN). This paper proposes the wild geese dwarf mongoose optimisation based deep quantum neural network (WGDMO_DQNN) for traffic flow detection in SDN. The SDN is initially simulated and packet transmission is conducted. The traffic flow detection at data plane is accomplished, wherein feature extraction and traffic flow detection utilising deep quantum neural network (DQNN) are carried out. The control attack mechanism is executed in three phases: identifying, executing, and composition. If the controller is overloaded, switches are swapped to underloaded controller employing WGDMO. Moreover, WGDMO is an amalgamation of wild geese algorithm (WGA) and dwarf mongoose optimisation algorithm (DMOA). Additionally, WGDMO_DQNN achieved maximal TPR of 91.6%, TNR of 87.5%, accuracy of 93.7%, minimal switch migration cost of 0.668 and load of controller 0.437. Copyright © 2026 Inderscience Enterprises Ltd.},
  keywords = {Anomaly detection; Controllers; Deep neural networks; Network security; Optimization; Software defined networking; Software reliability; Deep quantum neural network; Dwarf mongoose optimization algorithm; Optimization algorithms; Packet transmissions; Quantum neural networks; Software-defined networkings; Wild goose; Wild goose algorithm; Copyrights},
  note = {ID cribado R1155; bases: Scopus},
}

@article{R1158,
