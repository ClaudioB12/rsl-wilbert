@article{R0961,
  title = {Reducing CACC Platoon Disturbances Caused by State Jitters by Combining Two Stages Driving State Recognition with Multiple Platoons' Strategies and Risk Prediction},
  author = {Hao, Wei and Liu, Li and Yang, Xianfeng and Li, Yongfu and Byon, Young-Ji},
  year = {2022},
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  doi = {10.1109/TITS.2020.3033436},
  abstract = {The string stability of cooperative adaptive cruise control (CACC) platoons is largely affected by complex driving environment and abnormal driving behaviors. Fast and repetitive driving-state changes always occur during the period of changing driving states (such as leaving a platoon or lane-change), due to errors made in driver decisions or automatic driving system. This research proposes a framework which combines recognition of driving states with platoon operations and risk-prediction in order to reduce disturbance and unnecessary platoon operations resulting from driving-state jitters. First of all, long short-term memory (LSTM) neural networks were used in this research combined with a time-window in order to recognize driving states. Based on this research, the LSTM mode with an added time-window was found to be able to effectively reduce comparatively the jitters of recognition results. After that, an integrated mode which incorporates a recognition mode with danger probabilities was demonstrated to present better platoon operations. Monte Carlo simulation and importance sampling method will be given to predict platoons' and vehicles' trajectories and compute danger probabilities. In addition, an innovative strategy is implemented to identify an additional leader and execute a platoon splitting in order to improve driving smoothness, if a vehicle is recognized in an abnormal car-following state with a high danger-probability. In summary, this research has conducted extensive numerical tests to evaluate performances of the proposed system and the analysis results show that the proposed strategies will effectively increase smoothness and safety for a multi-platooning system. © 2000-2011 IEEE.},
  keywords = {Adaptive cruise control; Automobile drivers; Forecasting; Importance sampling; Intelligent systems; Long short-term memory; State estimation; Vehicles; Cooperative adaptive cruise control; Disturbance reduction; Driving environment; Driving state; Driving-state recognition; Risk predictions; States change; String stability; Time windows; Vehicle platooning; Jitter},
  note = {ID cribado R0961; bases: Scopus},
}

@inproceedings{R0964,
  title = {Research and Development of Dangerous Driving Warning and Rescue Devices},
  author = {Ding, Jiajun},
  year = {2023},
  booktitle = {Proceedings - 2023 7th International Symposium on Computer Science and Intelligent Control, ISCSIC 2023},
  doi = {10.1109/ISCSIC60498.2023.00068},
  abstract = {With the increasing number of automobiles on the road, accidents caused by dangerous driving behaviors and tragic incidents resulting from sudden illnesses continue to be all too common. To address this issue, we have designed an intelligent Dangerous Driving Behavior Detection and Rescue System based on Raspberry Pi 4.0. This system consists of Raspberry Pi control modules, GPS modules, collision prevention modules, posture recognition modules, image processing modules, and SMS sending modules. The system continuously captures the driver's facial expressions and body movements through a camera. When dangerous driving behavior is detected, the system analyzes and issues voice warnings. In the event of a driver's sudden illness, the system activates the alarm and rescue module, sending GPS location and distress signals to emergency contacts to ensure timely assistance. This system has effectively reduced the occurrence of traffic accidents, safeguarding lives and property. In comparison to existing contact and non-contact devices for monitoring driver behavior in the market, our system, utilizing Raspberry Pi and deep learning technology, not only automatically detects dangerous driving behaviors but also responds to sudden medical conditions with higher accuracy, real-time performance, and versatility, demonstrating significant potential for various applications. © 2023 IEEE.},
  keywords = {Accidents; Behavioral research; Deep learning; Image processing; Internet of things; Signaling; Behavior detection; Dangerous drivings; Detection system; Driving behaviour; Emergency assistance; In-vehicle IOT; Raspberry pi; Research and development; Sudden illness; Voice alert; Diseases},
  note = {ID cribado R0964; bases: Scopus},
}

@inproceedings{R0965,
  title = {Research on Abnormal Driving Behavior Detection Algorithm Based on YOLOv8},
  author = {Luo, Dongsong and Lan, Yiting and Cai, Gengchen},
  year = {2025},
  booktitle = {Proceedings of 2024 8th International Conference on Electronic Information Technology and Computer Engineering, EITCE 2024},
  doi = {10.1145/3711129.3711356},
  abstract = {To address the issues of low detection accuracy and slow speed in detecting abnormal driving behavior during daily driving, a YOLOv8-ADBD abnormal driving behavior detection algorithm is proposed, which is based on YOLOv8m as the baseline model. By introducing a lightweight visual model based on the ViT architecture, the backbone module of YOLOv8m is reconstructed. To build Slim-Neck, the one-time aggregation method is employed in constructing the cross-level partial network module. This approach minimizes computational complexity and enhances the efficiency of the algorithm. In order to tackle the problem of missed detection of small objects in abnormal driving behavior detection, a new CNN module STD-nsConv is inserted. Additionally, a new P2 layer for small target detection is introduced through upsampling, feature concatenation, etc., to enhance the recognition performance of small objects. The experiments demonstrate that the YOLOv8-ADBD algorithm achieves a 4.5% improvement in mAP50, there has been a reduction of 91.9% in the number of parameters and 85.4% in GFLOPs compared to the original YOLOv8m algorithm. Enhancing both the real-time performance and accuracy of abnormal driving behavior detection is achievable through YOLOv8-ADBD. © 2024 Copyright held by the owner/author(s).},
  keywords = {Abnormal driving behavior; Behavior detection; Detection accuracy; Detection algorithm; Driving behaviour; Light weight; Slow speed; Small objects; Small targets; YOLOv8m; Object detection},
  note = {ID cribado R0965; bases: Scopus},
}

