  author = {Wang, Yuan and Lv, Xiaona and Gu, Xiaohu and Li, Dan},
  year = {2025},
  journal = {IEEE Transactions on Vehicular Technology},
  doi = {10.1109/TVT.2024.3408163},
  abstract = {Vehicle tracking and accident risks brought by transportation are becoming more and more serious. This paper takes traffic flow detection in intelligent transportation system as the research base point, combines deep learning with edge computing technology, and proposes a new method of intelligent transportation edge computing based on deep learning. Firstly, the intelligent traffic detection algorithm based on deep sorting is implemented, and the vehicle reidentification data set is used to train the deep sorting tracking model, extract deep learning vehicle features, and establish the vehicle intelligent tracking algorithm model. After testing, the model has good tracking accuracy and real-time performance. Secondly, the low delay and high reliability of edge computing technology are used to monitor the road vehicle data, analyze abnormal vehicle information and abnormal traffic flow information, establish an intelligent traffic accident risk assessment model, evaluate the road traffic risk, and then use the minimum risk Bayesian decision method to verify the judgment results. Finally, the effectiveness and superiority of the proposed method are verified by comparison experiments of various prediction models, the minimum reduction in waiting time obtained was at least 11.3%. © 2024 IEEE.},
  keywords = {Intelligent systems; Risk assessment; Vehicle detection; Vehicle locating systems; Accuracy rate; Computational modelling; Deep learning; Edge computing; Intelligent transportation; Prediction algorithms; Predictive models; Risks assessments; Targets tracking; Task analysis; Vehicles detection},
  note = {ID cribado R0124; bases: Scopus, Web of Science, IEEE Xplore},
}

@inproceedings{R0125,
  title = {A New Method to Road Traffic Monitoring Using Artificial Systems},
  author = {Mohammaed, Ardm Haseeb and Mahmood, Zuhair Shakor and Nasret, Ali Najdet and Salih, Arshad B.},
  year = {2023},
  booktitle = {AIP Conference Proceedings},
  doi = {10.1063/5.0167689},
  abstract = {Unmanned aerial vehicles (UAVs) are used in this research to demonstrate a method to traffic monitoring based on automated UAV situation management. Analysis of current techniques of on-board automated detection of abnormal traffic conditions and emergency using artificial vision systems (AVS) is part of the investigation, which also involves preliminary categorization of these events, including the allocation of crises and disasters. A variety of UAV controls are discussed in light of the current scenario. Based on Neyman-Pearson criteria and Bayes, the traffic scenario recognition approach presented in the study is used to identify traffic conditions. In addition, the study examines the current methods for detecting moving and stationary vehicles . as well, Image segmentation and machine learning technologies, such as Deep Learning, are used to recognize cars in this paper. Traffic scenarios may be described using solutions to vehicle tracking and velocity detection difficulties. © 2023 American Institute of Physics Inc.. All rights reserved.},
