@article{R0693,
  title = {Neural Differential Equation Based Resilience Prediction of Road Networks Under Heavy Rainfall Disturbances},
  author = {Zang, Di and Liu, Yiyue and Cui, Zhe and Long, Baichao and Zhang, Junqi and Tang, Keshuang},
  year = {2026},
  journal = {IEEE Internet of Things Journal},
  doi = {10.1109/JIOT.2026.3730132},
  abstract = {Urban road networks evolve continuously and are highly sensitive to external disturbances, often leading to traffic disruptions and safety risks. Resilience prediction is therefore critical for system reliability and risk warning. However, most existing methods rely on discrete modeling and static, post-event analysis, offering limited insight into dynamic network behavior and forward-looking resilience evolution, which results in compromised accuracy of resilience assessment under disturbances. To overcome these limitations, this paper proposes a data-driven resilience prediction framework based on a Dual-Component Neural Rough Differential Equation (DC-NRDE). Firstly, DC-NRDE enables continuous modeling of traffic dynamics, providing an accurate foundation for functional resilience indicator prediction under disturbances. Subsequently, a comprehensive resilience indicator integrating structural and functional features is designed to quantify topological and traffic state changes. Furthermore, a predictive resilience assessment algorithm is developed to dynamically track and predict resilience evolution, explicitly modeling vulnerability and recovery phases to characterize system degradation and restoration processes. Experiments on three real-world datasets demonstrate superior prediction accuracy and robustness under high missing data rates. A heavy rainfall case study in San Jose further verifies the effectiveness of the proposed framework, demonstrating its potential to support data-driven decision-making in smart transportation systems. © 2014 IEEE.},
  keywords = {Decision making; Differential equations; Forecasting; Motor transportation; Roads and streets; Traffic control; Deep learning; Equation based; External disturbances; Heavy rainfall; Heavy rainfall disturbance; Resilience prediction; Road network; Rough differential equations; Spatio-temporal models; Urban road networks; Deep learning},
  note = {ID cribado R0693; bases: Scopus},
}

@inproceedings{R0698,
  title = {Novel Deep Learning Model for the Detection of Traffic Incidents using CNN-LSTM},
  author = {Alqasimi, Rawan and Rashid, Mamoon},
  year = {2026},
  booktitle = {2026 International Conference on Frontiers of Engineering and Emerging Technologies, FET 2026},
  doi = {10.1109/FET68771.2026.11601335},
  abstract = {With the evolution of smart cities infrastructure smart traffic systems highly demanded to achieve road safety and increase response time. This paper proposed a deep learning-based traffic accident detection system for real time surveillance video analysis. EfficientNetB0 used for feature extraction, while LSTM for temporal modeling. Stratified Group K-Fold cross-validation employed to avoid data leakage ensuring clips from the same video are not split across training and validation. Extensive preprocessing was applied on raw data to improve data quality. The model achieved a stable performance on different folds in accuracy, recall, and F1-score. Our proposed model achieved an accuracy of 95.2% while using the evaluation of Stratified Group K-Fold. This system opens the doors to near real time deployment and intelligent traffic management system, which has been planned as an additional integration of object classification and dynamic response systems to improve road safety and cut down on incident response times in smart cities. © 2026 IEEE.},
  keywords = {Accident prevention; Highway accidents; Highway administration; Highway planning; Highway traffic control; Intelligent systems; Intelligent vehicle highway systems; Learning systems; Motor transportation; Real time systems; Response time (computer systems); Roads and streets; Security systems; Smart city; Accident detections; Deep learning; Efficientnetb0; LSTM; Real-time inference; Road safety; Spatio-temporal models; Stratified group K-fold; Traffic accident detection; Video surveillance; Computer vision; Deep learning},
