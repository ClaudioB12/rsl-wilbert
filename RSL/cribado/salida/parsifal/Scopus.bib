@inproceedings{R0993,
  title = {Research on vehicle collision traffic accident detection system based on YOLOv5 algorithm},
  author = {Zhang, Jingjing and Tang, Sumin and Shen, Xinyu and Chen, Wanru and Liu, Zhihao},
