}

@inproceedings{R1153,
  title = {Traffic Anomaly Detection Using Optimized Faster R-CNN},
  author = {Karim, Shahid and Qadir, Akeel and Han, Gao and Li, Jing and Ibrar, Muhammad and Bibi, Irfana},
  year = {2024},
  booktitle = {Proceedings of SPIE - The International Society for Optical Engineering},
  doi = {10.1117/12.3054173},
  abstract = {This paper introduces a new method for traffic anomaly identification within the Faster R-CNN framework by combining the DenseNet module with the region proposals (RPs) processing block. The suggested approach seeks to improve feature extraction and RP creation in aerial imagery or CCTV frames to get beyond the drawbacks of the current methods. Discriminative features are extracted through DenseNet, and the RPs block makes it easier to provide a wide range of accurate and varied area proposals. Contrast correction techniques are applied to overcome the difficulties presented by low-resolution and low-contrast images frequently seen in surveillance scenarios. Comparing experimental results to state-of-the-art techniques, one can observe notable resilience and detection accuracy increases. The suggested method works exceptionally well in various traffic scenarios and environmental circumstances, indicating its potential for practical implementation in traffic surveillance systems. Overall, the study contributes to advancing the efficacy and reliability of anomaly detection in urban traffic environments. © 2024 SPIE.},
  keywords = {Anomaly detection; Image enhancement; Image segmentation; Urban transportation; 'current; Aerial imagery; Anomaly detection; Anomaly identification; Dense net; Fast R-CNN; Features extraction; Region proposal; Traffic anomalies; Traffic anomaly detections; Aerial photography},
