@inproceedings{R0029,
  title = {Accident Prediction and Emergency Management for Expressways Using Big Data and Advanced Intelligent Algorithms},
  author = {Sun, Xiting and Wei, Dongyong and Liu, Chaopeng and Wang, Ting},
  year = {2025},
  booktitle = {2025 IEEE 3rd International Conference on Image Processing and Computer Applications, ICIPCA 2025},
  doi = {10.1109/ICIPCA65645.2025.11138566},
  abstract = {Accurate accident risk assessment and timely emergency response are essential for enhancing expressway safety and reducing traffic congestion. This study develops a framework that integrates Deep Neural Networks (DNN), Graph Neural Networks (GNN) and Bayesian Optimization (BO) for accident risk assessment with a Reinforcement Learning (RL)-based strategy for optimizing emergency operations. Based on multi-source traffic data from Putuo District, Shanghai, the model improves accident forecasting by incorporating spatial and temporal traffic characteristics, while reinforcement learning enhances response decision-making under varying traffic conditions. The results show that adaptive optimization improves both prediction accuracy and emergency handling efficiency, underscoring the importance of early intervention and data-informed strategies in mitigating traffic disruptions. The findings contribute to the advancement of intelligent traffic management and offer a practical approach to integrating predictive modeling into real-world expressway operations. Future work should explore multi-agent coordination, real-time traffic behavior analysis and refined traffic flow modeling to further enhance system performance in complex urban road networks. © 2025 IEEE.},
  keywords = {Accident prevention; Big data; Civil defense; Coordination reactions; Decision making; Emergency services; Emergency traffic control; Forecasting; Highway accidents; Highway administration; Highway planning; Highway traffic control; Information management; Intelligent vehicle highway systems; Motor transportation; Neural networks; Risk assessment; Risk management; Traffic congestion; Accident prediction; Accident risk assessment; Accident risks; Bayesian optimization; Emergency response; Graph neural networks; Intelligent traffic management; Reinforcement learnings; Risks assessments; Traffic safety; Multi agent systems},
  note = {ID cribado R0029; bases: Scopus},
}

@inproceedings{R0031,
  title = {A CNN-Based Road Accident Detection and Comparison of Classification Techniques},
  author = {Gosal, Jasmeet Singh and Hota, Lopamudra and Kumar, Arun},
  year = {2024},
  booktitle = {Lecture Notes in Networks and Systems},
  doi = {10.1007/978-3-031-60935-0_19},
  abstract = {The likelihood of accidents rises due to an increase in the number of vehicles on the road. Traffic collision detection can help to lessen fatalities and catastrophic injuries. This paper considers the different frames in road accident videos, creates a deep learning feature extraction algorithm, and classifies images as accident or non-accident. The last pooling layer output from the Convolutional Neural Network (CNN) is used to extract features that should be used for detecting an accident. Different layers of CNN with filters are used to extract features and also padding is applied to avoid any information loss in the convolution process. The fully connected layer classifies after receiving the extracted features. CNN overcomes the different shortcomings of conventional approaches for accident analysis. Also, different machine learning classification algorithms are used with the feature extraction by CNN to improve the accuracy of the classification of images as accident or non-accident. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2024.},
