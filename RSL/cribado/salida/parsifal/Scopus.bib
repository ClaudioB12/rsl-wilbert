@inproceedings{R1238,
  title = {YOLO-DCLite: Lightweight Network for Dangerous Driving Behavior Detection},
  author = {Chen, Shaobin and Lin, Guoan and Luo, Chenhan and Li, Mingshuai and Pan, Pengfeng and Peng, Chen},
  year = {2025},
  booktitle = {2025 4th International Conference on Artificial Intelligence, Human-Computer Interaction and Robotics, AIHCIR 2025},
  doi = {10.1109/AIHCIR67580.2025.11404796},
  abstract = {In recent years, traffic accidents have occurred frequently, and dangerous driving behaviors have become a major hidden danger affecting road safety, which has also promoted the accelerated iteration of dangerous driving detection technologies to a certain extent. However, current mainstream detection models generally suffer from large parameter counts and high computational complexity, making it difficult to adapt to resource-constrained application scenarios such as on-board terminals. To address this issue, this paper proposes YOLO-DCLite, a lightweight detection network for dangerous driving behaviors, based on YOLO v11. Taking YOLO v11 as the basic architecture, the network replaces and integrates the designed DI_DualConv module, which adopts mechanisms such as gating branch fusion, cross-branch feature interaction, and adaptive receptive field adjustment to accurately capture dangerous driving behavior features at different scales. Secondly, the SAFM module is introduced to focus on key discriminative regions while suppressing background interference. These two modules cooperate with each other to enhance the network's ability in multi-scale feature extraction and key feature region reinforcement. Experimental results show that YOLO-DCLite achieves Precision, Recall, F1-Score, and mAP of 90.3%, 94.5%, 92.3%, and 97.1% respectively, with a parameter count of only 7.5M and a computational complexity of 15.3GFLOPs. Compared with similar comparative models, the proposed model significantly reduces computational complexity while improving detection accuracy, featuring both high precision and lightweight advantages. It provides an efficient and feasible solution for real-time dangerous driving detection on on-board edge devices. © 2025 IEEE.},
  keywords = {Accident prevention; Automobile drivers; Behavioral research; Complex networks; Computational complexity; Deep learning; Error detection; Highway accidents; Motor transportation; Network architecture; Object recognition; Traffic control; 'current; Application scenario; Behavior detection; Dangerous drivings; Deep learning; Detection models; Detection technology; Driving behaviour; Objects detection; Road safety; Object detection},
  note = {ID cribado R1238; bases: Scopus},
}

