}

@article{R0089,
  title = {A Joint Trajectory Completion Method Combined Spatiotemporal Motion for Long-Span Bridge Surveillance System With Dead Zone},
  author = {Guo, Xiaoli and Zhang, Haodu and Liu, Wanquan and Zhang, Rui and Wang, Ping},
  year = {2025},
  journal = {IEEE Transactions on Instrumentation and Measurement},
  doi = {10.1109/TIM.2025.3538091},
  abstract = {Current surveillance systems used on long-span bridges have monitoring dead zones, resulting in incomplete vehicle trajectories, whereas abnormal vehicle trajectories occurring within these dead zones are highly prone to traffic accidents. Obtaining complete vehicle trajectories within dead zones is challenging, yet crucial for identifying abnormal trajectories. To tackle this challenge, this article presents a joint trajectory completion (JTC) framework, which enables the completion of vehicle trajectories in dead zones with similar vehicle appearances and diverse camera views. An appearance-spatiotemporal fusion (ASTF) module is utilized to integrate motion spatiotemporal and appearance information to enhance vehicle representations. A Transformer-based bi-directional trajectory completion (TBTC) module with two encoder-decoder structures is further constructed to complete trajectories. Finally, a mathematical assessment strategy is established according to traffic rules to identify abnormal trajectories. Sufficient experimental results on the Hangzhou Bay dataset demonstrate the effectiveness of the proposed JTC method, which achieves an improvement in mAP of 7.4% for vehicle re-identification (ReID) and reduces the average RMSE by at least 0.2123 m for completion of vehicle trajectories. The completion of trajectories within dead zones facilitates the subsequent effective identification of abnormal trajectories and rapid accident warnings. © 1963-2012 IEEE.},
  keywords = {Highway accidents; Magnetic levitation vehicles; Tachometers; Traffic control; Dead zones; Decoder structures; Encoder-decoder; Encoder-decoder structure; Motion spatio-temporal modeling; Re identifications; Spatio-temporal models; Surveillance systems; Vehicle re-identification; Vehicle trajectories},
  note = {ID cribado R0089; bases: Scopus, Web of Science},
}

@inproceedings{R0091,
  title = {A Lightweight Model for Detecting Dangerous Driving Behaviors in Road Transportation},
  author = {Zhang, Haiyang and Huo, Zhiwei and Liu, Caixia and Wu, Yingyan and Zhang, Xiran},
  year = {2024},
  booktitle = {Proceedings of the 2024 27th International Conference on Computer Supported Cooperative Work in Design, CSCWD 2024},
  doi = {10.1109/CSCWD61410.2024.10580015},
  abstract = {In recent years, there has been a concerning surge in road traffic accidents, with hazardous driving behaviors among truck drivers identified as significant contributors. Consequently, accurately detecting and preventing these dangerous behaviors have become paramount. While convolutional neural networks (CNNs) are commonly used for driver behavior detection, challenges persist, particularly in detecting small-scale objects due to data quality and model architecture limitations. This research introduces an innovative approach utilizing the YOLOv8-SG model to detect dangerous driving behaviors. We have incorporated the SPD-G module to enhance the precision of detecting small-scale target behaviors. Additionally, we have developed the G2f module to optimize the model's lightweight characteristics, meeting the performance demands of transport companies and their vehicular computing equipment. We also fine-tuned the loss function penalty terms and introduced the EXIoU loss function to improve boundary box regression performance. Empirical results show that our model outperforms the baseline, achieving a 1.1% mAP increase while reducing the model's parameters by 14.3% and overall size by 12.9%. Notably, small-scale target detection, such as closed-eye behavior, improved by 3.8% in mAP, effectively reducing omissions and false positives. © 2024 IEEE.},
  keywords = {Automobile drivers; Behavioral research; Motor transportation; Object detection; Truck drivers; Behavior detection; Dangerous drivings; Driver behavior detection; Driver's behavior; Driving behaviour; Lightweight; Road transportation; Small object detection; Small scale; YOLOv8; Roads and streets},
  note = {ID cribado R0091; bases: Scopus, IEEE Xplore},
}

@inproceedings{R0092,
  title = {A Lightweight Spatio-Temporal Traffic Anomaly Detection Using a ResNet-GRU Based Hybrid Framework},
  author = {Govind, Purushottam and Mustafi, Debjani and Pranav, Prashant},
  year = {2026},
  booktitle = {ESIC 2026 Proceedings - 6th International Conference on Emerging Systems and Intelligent Computing},
  doi = {10.1109/ESIC68176.2026.11496063},
  abstract = {The number of road or traffic anomalies are increasing at an exponential rate. These include accidents, hit-and-runs, rash driving, snatching, etc. Detecting anomalies in the road traffic is essential to enrich transportation safety, minimizing response time to critical incidents and facilitating smart traffic management systems. Conventional anomaly detection methods often encounter difficulties due to complex road structures, occlusions, and the temporal variations of vehicular motions. This study presents a blended model utilizing deep learning techniques that integrates a Residual Network (ResNet18) to extract spatial features in conjunction with a Gated Recurrent Unit (GRU) network to model temporal sequences for the anomaly detection task. Traffic video frames contain high level visual features which are usually captured by ResNet18, whereas some divergent or digressive patterns such as collisions, unexpected pauses, unstable vehicular behaviour, etc. are identified by GRU, which evaluate features captured by ResNet over time. A benchmark traffic surveillance video dataset is used to evaluate the proposed ResNet-GRU based model, and the result shows that the model outperforms the standalone CNN model. This study opens up the possibility to implement cutting edge surveillance technologies in smart cities using a light weight deep learning model to identify real-world traffic anomaly patterns. © 2026 IEEE.},
  keywords = {Advanced traffic management systems; Anomaly detection; Big data; Convolutional neural networks; Deep neural networks; Highway administration; Highway planning; Highway traffic control; Intelligent systems; Motor transportation; Security systems; Smart city; Street traffic control; Video analysis; Convolutional neural network; Deep learning; Gated recurrent unit; Hybrid framework; Spatio-temporal; Spatio-temporal models; Traffic anomalies; Traffic anomaly detections; Unit-based; Video analysis; Roads and streets},
  note = {ID cribado R0092; bases: Scopus, IEEE Xplore},
}

@inproceedings{R0093,
  title = {A Lightweight System for Attention-based Night-Time Traffic Accident Detection},
  author = {Ruchitha, Bhamidipati and Misra, Sagarika and Singh, Preety and Porwal, Srushti},
  year = {2026},
  booktitle = {Communications in Computer and Information Science},
  doi = {10.1007/978-3-032-08511-5_1},
  abstract = {Night-time traffic accidents pose significant challenges to road safety, making rapid detection and response crucial. In this research, we propose an efficient system for near real-time traffic accident detection using deep learning techniques on edge devices. Specifically, we leverage the attention-based Swin-Tiny Transformer model for accident classification on traffic surveillance data. We handle the dataset imbalance by utilizing appropriate loss function while training the classifier. For deployment, we utilize the Raspberry Pi 4 as an edge device, providing an affordable and efficient solution for near real-time accident detection at the point of occurrence. The system’s ability to process images locally allows for quicker response times, crucial for dispatching emergency services. Our system achieves an accuracy of 74.41% in challenging night surveillance scenarios. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  keywords = {Accident prevention; Classification (of information); Deep learning; Edge detection; Highway accidents; Intelligent systems; Learning systems; Motor transportation; Security systems; Accident detections; Edge device; Lightweight systems; Near-real time; Night time; Rapid detection; Rapid response; Realtime traffic; Road safety; Swin transformer; Emergency services},
  note = {ID cribado R0093; bases: Scopus},
}

@inproceedings{R0098,
  title = {A Meta-Graph Learning and Transformer-Based Temporal Modeling for Dynamic City Traffic Flow Prediction},
  author = {Rashid, Harun Or and Long, Chen and Hasan, Md Riaz and Sultana, Fariha},
  year = {2025},
  booktitle = {ISMSIT 2025 - 9th International Symposium on Multidisciplinary Studies and Innovative Technologies, Proceedings},
  doi = {10.1109/ISMSIT67332.2025.11268199},
  abstract = {Urban traffic networks show significant spatial variation and complex time-based patterns, making precise traffic flow prediction essential for developing intelligent transportation systems. Traditional statistical and recurrent models often fail to effectively capture nonlinear relationships, long-term correlations, and sudden disruptions, leading to unreliable and suboptimal predictions. To address these challenges, we introduce a Meta-Graph-Transformer (MGT) framework that combines heterogeneous meta-graph learning with Transformer-based temporal modeling. The meta-graph represents various node types, including intersections, sensors, and signal controllers, and builds multidimensional edge weights based on geographic distance, flow correlation, and event impact. Multi-scale meta-path aggregation captures higher-order structural meanings, while a multi-head self-attention encoder efficiently models long-term dependencies and abrupt fluctuations. Experiments on a comprehensive urban traffic dataset reveal that MGT consistently outperforms ARIMA, LSTM, GCN, and spatio-temporal GCN models in terms of mean absolute error, mean squared error, and other metrics, particularly during multi-step forecasts and abnormal traffic conditions. These findings validate MGT's robustness, fast convergence, and strong potential for real-world traffic management solutions. © 2025 IEEE.},
  keywords = {Advanced traffic management systems; Flow graphs; Forecasting; Graphic methods; Highway traffic control; Intelligent systems; Motor transportation; Street traffic control; Traffic signals; Urban transportation; Intelligent transportation system; Intelligent transportation systems; Meta-graph; Meta-graph transformer formatting; Meta-path aggregation; Path aggregation; Temporal models; Traffic flow forecasting; Urban traffic flow; Urban traffic flow forecasting; Mean square error},
  note = {ID cribado R0098; bases: Scopus, IEEE Xplore},
}

@article{R0102,
  title = {A multimodal deep fusion framework for highway traffic anomaly detection},
  author = {Duan, Mengmeng and Sun, Shaowei and Liu, Mingzhou},
  year = {2025},
  journal = {Scientific Reports},
  doi = {10.1038/s41598-025-18671-x},
  abstract = {This paper presents a novel framework for detecting and predicting abnormal traffic events on highways. Traditional traffic monitoring systems often rely on a single data source, which limits detection accuracy and robustness in complex environments. To address these challenges, we propose a multimodal deep fusion framework based on heterogeneous graph neural networks (HGNNs), enhanced by an ensemble contrastive pessimistic likelihood estimation (CPLE) algorithm. The framework integrates both static and dynamic traffic data, including video images, traffic flow, vehicle speed, and tunnel weather conditions. Through effective feature fusion, it significantly improves the accuracy and real-time performance of anomaly detection. Experimental results show that the model performs robustly across various scenarios, accurately identifying abnormal traffic events with high precision and stability. Compared with existing models such as AGC-LSTM and AttentionDeepST, the proposed MHGNN-CPLE model demonstrates superior performance, particularly in static detection tasks, achieving an accuracy of 0.980 and an F1 score of 0.967. In contrast, AGC-LSTM and AttentionDeepST achieve 0.965/0.945 and 0.960/0.935 in accuracy and F1 score, respectively. In dynamic scenarios, the model also maintains high accuracy under varying noise levels, indicating strong robustness. The research is motivated by the growing challenges of urbanization, where real-time detection and prediction of traffic anomalies are increasingly critical. Our framework effectively integrates multimodal data and leverages HGNNs to capture complex spatiotemporal dependencies, while the CPLE algorithm enhances robustness under uncertainty. The results confirm that the proposed method offers a reliable and accurate solution for real-time traffic anomaly detection, representing a significant advancement in intelligent transportation systems. © The Author(s) 2025.},
  keywords = {algorithm; article; controlled study; diagnosis; graph neural network; highway; limit of detection; noise; outlier detection; prediction; traffic; urbanization; velocity; videorecording},
  note = {ID cribado R0102; bases: Scopus, Web of Science},
}

@article{R0106,
  title = {An abnormal driving behavior recognition algorithm based on the temporal convolutional network and soft thresholding},
  author = {Zhao, Yunyun and Jia, Hongwei and Luo, Haiyong and Zhao, Fang and Qin, Yanjun and Wang, Yueyue},
  year = {2022},
  journal = {International Journal of Intelligent Systems},
  doi = {10.1002/int.22842},
  abstract = {Most traffic accidents are caused by bad driving habits. Online monitoring of the abnormal driving behaviors of drivers can help reduce traffic accidents. Recently, abnormal driving behavior recognition based on the sensors' data embedded in commodity smartphones has attracted much attention. Though much progress has been made about driving behavior recognition, the existing works cannot achieve high recognition accuracy and show poor robustness. To improve the driving behaviors recognition accuracy and robustness, we propose an algorithm based on Soft Thresholding and Temporal Convolutional Network (S-TCN) for driving behavior recognition. In this algorithm, we first introduce a soft attention mechanism to learn the importance of different sensors. The TCN has the advantages of small memory requirement and high computational efficiency. And the soft thresholding can further filter the redundant features and extract the main features. So, we fuse the TCN and soft thresholding to improve the model's stability and accuracy. Our proposed model is extensively evaluated on four real public data sets. The experimental results show that our proposed model outperforms best state-of-the-art baselines by 2.24%. © 2022 Wiley Periodicals LLC.},
  keywords = {Accidents; Behavioral research; Convolution; Deep learning; Abnormal driving behavior; Behaviour recognition; Convolutional networks; Deep learning; Driving behaviour; Recognition accuracy; Recognition algorithm; Soft attention; Soft thresholding; TCN; Computational efficiency},
  note = {ID cribado R0106; bases: Scopus, Web of Science},
}

@inproceedings{R0107,
  title = {Analysis and Evaluation of Baseline Models for Highway Traffic Incident Detection},
  author = {Lin, Chengchuang and Zhang, Yusheng and Luo, Xuebing and Lin, Kunlin and Guan, Longhui and Xing, Wanyong},
  year = {2026},
  booktitle = {BDAIA 2025 - 2025 2nd International Conference on Big Data Analytics and Artificial Intelligence Application},
  doi = {10.1145/3788108.3788507},
  abstract = {Highway incident detection technology serves as a core component in responding to abnormal events on highways, which is critical for safeguarding traffic safety, mitigating secondary accidents, and enhancing overall traffic efficiency. In recent years, deep learning-based incident detection methods have yielded remarkable advances in detection accuracy. However, a prevalent limitation of existing studies lies in the lack of open access to their experimental datasets and model weights, which hinders the objective comparison of detection performance across different approaches. To fill this gap, this paper presents a systematic review of mainstream baseline models for highway incident detection, and further constructs a large-scale benchmark dataset, namely the Highway Traffic Incident Benchmark (HTIB). Distinguished from existing datasets, HTIB covers the most comprehensive categories of highway incidents collected from real-world highway surveillance systems. Based on HTIB, this paper proposes a standardized performance evaluation framework to enable fair and comparable assessments of different detection baseline models. Experimental results indicate that YOLOv9c achieves the optimal detection performance on the HTIB test set, with an mAP50 of 84.8%. In contrast, YOLOv6s delivers the fastest inference speed with an average of 1.5 ms per image, which is suitable for real-time monitoring scenarios. Notably, YOLOv8s achieves a balanced trade-off between detection accuracy and inference efficiency, demonstrating the best overall performance. This study not only establishes a unified benchmark for evaluating highway incident detection models but also clarifies the applicability of different models in practical scenarios, laying a solid foundation for the deployment of AI-based incident detection systems on highways. © 2025 Copyright held by the owner/author(s).},
  keywords = {Accident prevention; Benchmarking; Deep learning; Efficiency; Highway accidents; Highway engineering; Human engineering; Information management; Large datasets; Motor transportation; Real time systems; Security systems; Baseline detection; Baseline detection model; Baseline models; Benchmark datasets; Detection accuracy; Detection models; Highway; Highway traffic; Incident detection; Traffic incidents; Economic and social effects},
  note = {ID cribado R0107; bases: Scopus, ACM Digital Library},
}

@inproceedings{R0108,
  title = {Analysis of Abnormal Driver Behavior from Gaze Direction and Blinking},
  author = {Thesniyom, Teerath and Yenklom, Kanyarat and Chaisiriprasert, Parkpoom},
  year = {2026},
  booktitle = {Lecture Notes in Networks and Systems},
  doi = {10.1007/978-981-96-8750-3_27},
  abstract = {Most global road accidents are mainly caused by abnormal driving behaviors such as reckless driving, distraction, mobile phone usage, adjusting radios, or other vehicle systems. Driving while tired or drowsy can directly lead to accidents due to these abnormal driving behaviors. Additionally, this can result in property damage and pose risks to oneself and others, causing injuries or fatalities. Abnormal driving behaviors can be identified through facial expressions, yawning, blinking excessively, or looking elsewhere. Signs of fatigue include excessive blinking. To analyze factors contributing to road accidents, researchers have proposed the Unified Driver Attention and Fatigue Detection (UDAF) algorithm. This algorithm aims to enhance the efficiency of detecting abnormal driving behaviors by identifying gaze direction and blinking using Virtual Geometry Group (VGG16) and Long Short-Term Memory (LSTM). In this study, experiments were conducted using images and videos from front-facing cameras. The research achieved an average accuracy rate of 93.12% in detecting gaze direction and blinking through the UDAF algorithm. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2026.},
  keywords = {Behavioral research; Disasters; Fatigue of materials; Highway accidents; Intelligent vehicle highway systems; Soft computing; Virtual reality; Attention detection; Driver attention; Driver fatigue; Driving behaviour; Eye blink; Eye direction; Fatigue detection; Gaze direction; Short term memory; VGG16; Roads and streets},
  note = {ID cribado R0108; bases: Scopus},
}

@article{R0115,
  title = {Analyzing Important Elements for Improving the Safety of Motorways},
  author = {Kim, Yejin and Lee, Yoseph and Lee, Youngtaek and Ko, Woori and Yun, Ilsoo},
  year = {2024},
  journal = {Applied Sciences (Switzerland)},
  doi = {10.3390/app142311115},
  abstract = {This study aims to identify the factors that influence the occurrence of traffic accidents to improve motorway traffic safety. Various data, including the frequency of traffic accidents, traffic volume, geometric structure, and congestion level, were collected from individual sections of motorways in South Korea. Using the collected data, a traffic accident frequency prediction model was developed by applying an explainable artificial intelligence (AI)-based approach. The developed deep neural network model was combined with Shapley Additive Explanations to identify the variables that significantly affect the frequency of traffic accidents. The analysis identified five significant factors: segment length, total traffic volume, the proportion of truck traffic, the number of dangerous driving behaviors, and the duration of congestion. The results demonstrate the potential of using explainable AI in predicting traffic accident frequency. By identifying the factors that influence traffic accidents using this model, we can pinpoint areas for improvement, which may ultimately help reduce highway traffic accidents. © 2024 by the authors.},
  keywords = {Deep neural networks; Highway accidents; Highway traffic control; Motor transportation; Accident frequency; Congestion level; Explainable artificial intelligence (XAI); Geometric structure; Motorway; Neural-networks; Shapley; Shapley additive explanation; Traffic safety; Traffic volumes; Traffic congestion},
  note = {ID cribado R0115; bases: Scopus, Web of Science},
}

@article{R0119,
  title = {An efficient computer vision framework for RSU-based accident recognition and V2X communication},
  author = {Ather, Danish and Talipov, Miraziz},
  year = {2026},
  journal = {Mathematical Models in Engineering},
  doi = {10.21595/mme.2026.26075},
  abstract = {Road traffic accidents require rapid detection and timely warning dissemination to reduce secondary collisions and improve emergency response. This paper presents an efficient roadside-unit-based computer vision framework for real-time accident recognition integrated with Vehicle-to-Everything communication. The proposed architecture combines lightweight convolutional spatial feature extraction, optical-flow-based motion analysis, temporal score aggregation, and low-latency V2X alert generation within an edge-deployable RSU pipeline. A formal system model is introduced to describe accident likelihood estimation, detection decision making, latency constraints, and communication reliability requirements. The experimental evaluation was conducted on a traffic video dataset containing 3,300 clips with normal traffic, single-vehicle accidents, multi-vehicle collisions, and non-accident anomalies. The proposed hybrid framework achieved 95.8% accuracy, 95.0% precision, 94.6% recall, and 94.8% F1-score, outperforming CNN-only and motion-only baselines. The average processing latency was approximately 40 ms per frame, indicating the feasibility of real-time operation on RSU-grade embedded hardware. These results show that the proposed framework can provide accurate and timely accident detection while supporting rapid V2X warning dissemination for next-generation intelligent transportation systems. © 2026 Danish Ather, et al.},
  keywords = {computer vision; edge intelligence; intelligent transportation systems; roadside unit; traffic accident detection; V2X communication},
  note = {ID cribado R0119; bases: Scopus},
}

@article{R0120,
  title = {An empirical study for the traffic flow rate prediction-based anomaly detection in software-defined networking: a challenging overview},
  author = {Raja, Nirav M and Vegad, Sudhir},
  year = {2023},
  journal = {Social Network Analysis and Mining},
  doi = {10.1007/s13278-023-01057-0},
  abstract = {Currently, there is an enormous disturbance regarding privacy in information and communication technology around the scientific community. Since any assault or abnormality in the network can seriously disturb numerous realms like national security, private data storage, social welfare, economic issues, and so on. Consequently, one of the domains for detecting intrusion in the network is anomaly detection domain and it is a wide probe area. Various numerous methods and approaches have developed for anomaly detection. In the network security field, traffic anomaly detection has been a main aspect. The network security domain recognizes assaults in terms of significant deviations from the entrenched regular usage profiles. Nowadays, software-defined networking (SDN) is a new networking model has developed to ease effectual network control and management. This view investigates 50 probe papers focused on traffic flow rate prediction-based anomaly detection in SDN. Furthermore, it presents technique wise classifications like flow counting-based techniques, information theory-based approaches, entropy-based techniques, deep learning (DL)-based approaches, hybrid methods and network methods. An examination includes in an overview based on classification research techniques, toolset used, years of publication, datasets, and evaluation metrics for predicting anomaly in the SDN environment. Lastly, the limitations of surveyed techniques are explained, that encourage investigators for inventing more new techniques for predicting anomaly in SDN. © 2023, The Author(s), under exclusive licence to Springer-Verlag GmbH Austria, part of Springer Nature.},
  keywords = {Classification (of information); Cybersecurity; Deep learning; Digital storage; Forecasting; Intrusion detection; National security; Network security; Probes; Anomaly detection; Cyber-attacks; Deep learning; Networks security; Prediction-based; Rate predictions; Software defined network; Software-defined networkings; Software-defined networks; Traffic flow rates; Anomaly detection},
  note = {ID cribado R0120; bases: Scopus, Web of Science},
}

@inproceedings{R0122,
  title = {An Enterprise Network Encrypted Traffic Anomaly Detection Method Based on Contrastive Learning Transformer},
  author = {Qi, Hongwei and Bai, Haiyan and Chen, Yeh-Cheng},
  year = {2026},
  booktitle = {Advances in Transdisciplinary Engineering},
  doi = {10.3233/ATDE260962},
  abstract = {With the widespread adoption of encryption protocols in enterprise networks, traditional traffic inspection methods face significant challenges due to the limited visibility of payload information. Consequently, accurately detecting anomalies in encrypted traffic has become increasingly difficult. To address this issue, this paper proposes an enterprise network encrypted traffic anomaly detection method based on a Contrastive Learning Transformer. Specifically, encrypted traffic is first represented through statistical and temporal features without relying on payload inspection. A Transformer-based architecture is then employed to capture long-range dependencies and sequential patterns within traffic flows. Furthermore, a contrastive learning framework is introduced to enhance feature representation by maximizing the similarity between positive pairs and distinguishing negative samples, thereby improving the model's discriminative capability. During detection, the learned representations are utilized to identify anomalous traffic patterns effectively. Experimental results on benchmark datasets demonstrate that the proposed method outperforms several state-of-the-art approaches in terms of F1-score, Matthews Correlation Coefficient (MCC), balanced accuracy, and False Alarm Rate (FAR), while maintaining strong robustness and generalization performance. The findings indicate that the proposed approach provides an effective and scalable solution for encrypted traffic anomaly detection in enterprise networks. © 2026 The Authors.},
  keywords = {Anomaly detection; Contrastive Learning; Correlation detectors; Cryptography; Information systems; Information use; Learning systems; Network security; Telecommunication traffic; Anomaly detection methods; Encrypted traffic; Encrypted traffic anomaly detection; Encryption protocols; Enterprise network security; Enterprise networks; Networks security; Representation learning; Traffic anomaly detections; Transformer; Benchmarking},
  note = {ID cribado R0122; bases: Scopus},
}

@article{R0123,
  title = {A Network Traffic Classification Method Based on Graph Convolution and LSTM},
  author = {Pan, Yang and Zhang, Xiao and Jiang, Hui and Li, Cong},
  year = {2021},
  journal = {IEEE Access},
  doi = {10.1109/ACCESS.2021.3128181},
  abstract = {In the identification of normal and abnormal traffic flows, Convolutional Neural Network (CNN) is commonly used to extract spatial features of network traffic at present. However, its limitation is that the one-dimensional form of traffic flow data needs to be converted into two-dimensional form, without considering the potential spatial correlation between traffic flows. In view of the potential correlation between network traffic flows, this paper proposes a classification method based on graph convolution and Long-Short Term Memory (LSTM). First, perform data preprocessing on the traffic flow data, then use the graph convolutional network to extract the spatial features of spatial topology and use LSTM to extract its temporal features. Finally, the performance of the algorithm is evaluated on the sampled UNSW-NB15 data set. Experimental results show that the proposed method can effectively extract the potential features of network traffic data. Compared with other methods such as feature selection, bidirectional LSTM (BiDLSTM) and CNN-LSTM, it proves the effectiveness of the proposed algorithm and performs better in classification performance. © 2013 IEEE.},
  keywords = {Data mining; Feature extraction; Flow graphs; Long short-term memory; Classification methods; Convolutional neural network; Deep learning; Features extraction; Flow data; Graph convolution; Network traffic; Network traffic classification; Spatial features; Traffic flow; Convolution},
  note = {ID cribado R0123; bases: Scopus, Web of Science, IEEE Xplore},
}

