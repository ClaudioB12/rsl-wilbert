@ARTICLE{ScopusV6Missing04,
	author = {bin Jamal Mohd Lokman, Eilham Hakimie and Goh, Vik Tor and Yap, Timothy Tzen Vun and Ng, Hu},
	title = {Driving event recognition using machine learning and smartphones},
	year = {2022},
	journal = {F1000Research},
	volume = {11},
	pages = {},
	doi = {10.12688/f1000research.73134.2},
	url = {https://www.scopus.com/pages/publications/85152944615?origin=resultslist},
	abstract = {Background: The lack of real-time monitoring is one of the reasons for the lack of awareness among drivers of their dangerous driving behavior. This work aims to develop a driver profiling system where a smartphone’s built-in sensors are used alongside machine learning algorithms to classify different driving behaviors. Methods: We attempt to determine the optimal combination of smartphone sensors such as accelerometer, gyroscope, and GPS in order to develop an accurate machine learning algorithm capable of identifying different driving events (e.g. turning, accelerating, or braking). Results: In our preliminary studies, we encountered some difficulties in obtaining consistent driving events, which had the potential to add “noise” to the observations, thus reducing the accuracy of the classification. However, after some pre-processing, which included manual elimination of extraneous and erroneous events, and with the use of the Convolutional Neural Networks (CNN), we have been able to distinguish different driving events with an accuracy of about 95%. Conclusions: Based on the results of preliminary studies, we have determined that the proposed approach is effective in classifying different driving events, which in turn will allow us to determine driver’s driving behavior. Copyright: © 2022 bin Jamal Mohd Lokman EH et al.},
	author_keywords = {convolutional neural networks; driver profiling; Machine learning; smartphone},
	keywords = {acceleration; Article; braking; convolutional neural network; diagnostic error; driving ability; global positioning system; human; internal consistency; learning algorithm; machine learning; monitoring; multilayer perceptron; peer review; recognition; rectified linear unit; traffic; turning},
	publisher = {F1000 Research Ltd},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5; All Open Access; Gold Open Access}
}

@CONFERENCE{ScopusV6Missing05,
	author = {Huy Minh, Quang Nguyen and Dinh, Nen Nguyen and Ho, Long Viet and Huu, Cuong Phan},
	title = {Real-time traffic accident detection using yolov8},
	year = {2025},
	journal = {Transportation Research Procedia},
	volume = {85},
	pages = {68 - 75},
	doi = {10.1016/j.trpro.2025.03.135},
	url = {https://www.scopus.com/pages/publications/105001918995?origin=resultslist},
	abstract = {Urban traffic plays an essential role in daily activities, but it carries many safety risks. A challenge that must be addressed is the need for an immediate response when an accident happens. It is a fact that traffic manager often takes a significant amount of time to recognize emergencies and make a decision regarding assistance activities. With the widespread application of artificial intelligence, particularly deep learning, it is possible to detect accidents in real time and promptly initiate rescue operations to minimize casualties and property damage. Among these deep learning algorithms, the YOLO algorithm has emerged as a potential solution. Recently, the latest version of YOLO, known as YOLOv8, has shown superior performance regarding accuracy and precision across various fields such as security, e-commerce, education, and entertainment. However, its application in the traffic safety field, such as addressing traffic accidents, has yet to be fully explored. Consequently, this paper focuses on implementing a series of YOLOv8 e.g. n, s and m, for accident detection. Some hyperparameters e.g. batch size and number of epochs are investigated to gain insights into their impact on the performance of YOLOv8. Accident images under consideration of normal and extreme weather are collected to train YOLOv8. Then the trained model is utilized to identify accidents using information extracted from cameras. When using a batch size of 16 and running for 100 epochs, YOLOv8s proved to be superior performance in terms of computational time (0.27 hours) and precision when employed to identify traffic conditions using videos from CCTV cameras. © 2025 Elsevier B.V.. All rights reserved.},
	author_keywords = {deep learning; Object detection; real-time; traffic accident; YOLOv8},
	publisher = {Elsevier B.V.},
	language = {English},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 12; All Open Access; Gold Open Access}
}

@ARTICLE{ScopusV6Missing06,
	author = {Taheri Sarteshnizi, Iman and Sarvi, Majid and Asadi Bagloee, Saeed and Nassir, Neema},
	title = {On the applicability of time series anomaly detection methods to real-world traffic volume data},
	year = {2026},
	journal = {Transportation Research Part C: Emerging Technologies},
	volume = {184},
	pages = {},
	doi = {10.1016/j.trc.2026.105536},
	url = {https://www.scopus.com/pages/publications/105034597378?origin=resultslist},
	abstract = {AbstractTime Series Anomaly Detection (TSAD or TAD) refers to the automatic and data-driven identification of abnormal segments in time series data, a task that has been studied extensively for decades. Despite recent transformative and novel findings revealed by efforts in this field, the literature on traffic anomaly detection has not yet fully reflected on these emerging trends to draw practical conclusions. In this paper, we focus on the applicability of state-of-the-art and well-established TAD methods to road traffic volume data, making contributions in two main ways. First, given the proven and major contribution of evaluation data to TAD outcomes, we argue that existing anomaly-labeled datasets from transportation and traffic systems require substantial enhancements in terms of both data size and label quality. To address this, we propose a new platform to inspect and label large-scale volume data of urban areas based on its unique characteristics and the latest taxonomy of time series anomalies. Second, based on the established framework, we also formulate the TAD problem in traffic volume data and introduce a discord-based, context-embedded, and light-weight traffic anomaly detection method, named Step-isolated Traffic Discords Discovery (Si-TDD), to address this problem. Benefiting from our labeling platform, AnoLT (Anomaly Labeled Traffic) is presented in this paper for the first time as a comprehensive, open-source, and anomaly-labeled spatiotemporal dataset collected from 147 locations across Melbourne, Australia. Comparative results with more than 20 baselines also indicate that Si-TDD considerably outperforms recent TAD solutions when it comes to traffic volume data, achieving a 67% F1 score with the AnoLT dataset. This paper highlights the key role of incorporating context-related information into existing TAD solutions to boost their effectiveness in traffic anomaly detection, a factor that is often overlooked in the current literature. © 2026 The Author(s). Published by Elsevier Ltd. This is an open access article under the CC BY license. http://creativecommons.org/licenses/by/4.0/},
	author_keywords = {Anomaly detection; Deep learning; Ground truth labels; Machine learning; Outlier detection; Time series data; Traffic volume data},
	keywords = {Australia; Melbourne; Victoria [Australia]; Abstracting; Automatic identification; Labeled data; Learning systems; Motor transportation; Open access; Time series; Volume measurement; Anomaly detection; Deep learning; Ground truth; Ground truth label; Machine-learning; Outlier Detection; Time-series data; Times series; Traffic anomaly detections; Traffic volume data; automation; detection method; machine learning; road traffic; spatial data; time series analysis; Anomaly detection; Deep learning},
	publisher = {Elsevier Ltd},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Hybrid Gold Open Access}
}

